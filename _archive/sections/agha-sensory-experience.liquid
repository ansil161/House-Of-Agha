{% comment %}
  AGHA SENSORY EXPERIENCE & CROSS-SELL SECTION
{% endcomment %}

<section class="section-padding border-bottom-thin" id="sensory-experience">
  <div class="container">
    <!-- Sensory Matrix -->
    <div style="margin-bottom: var(--space-2xl);" class="gsap-reveal">
      <span class="editorial-label">03 — SENSORY CHARACTERISTICS</span>
      <h2 class="headline-section font-serif" style="margin-top: 12px;">WEARING CHARACTER & PROFILE</h2>
    </div>

    <div class="grid-4 gsap-reveal" style="margin-bottom: var(--space-3xl);">
      <div style="border: 1px solid var(--color-border); padding: var(--space-lg);">
        <span class="editorial-label">AURA & MOOD</span>
        <h3 class="font-serif" style="font-size: 1.6rem; margin-top: 8px;">NOCTURNAL</h3>
        <p class="text-muted" style="font-size: 0.85rem; margin-top: 8px;">Commanding, mysterious, suited for evening temperature shifts.</p>
      </div>

      <div style="border: 1px solid var(--color-border); padding: var(--space-lg);">
        <span class="editorial-label">INTENSITY</span>
        <h3 class="font-serif" style="font-size: 1.6rem; margin-top: 8px;">35% EXTRAIT</h3>
        <p class="text-muted" style="font-size: 0.85rem; margin-top: 8px;">Unusually high concentration requiring only 1–2 atomized sprays.</p>
      </div>

      <div style="border: 1px solid var(--color-border); padding: var(--space-lg);">
        <span class="editorial-label">SILHOUETTE</span>
        <h3 class="font-serif" style="font-size: 1.6rem; margin-top: 8px;">WIDE SIALLAGE</h3>
        <p class="text-muted" style="font-size: 0.85rem; margin-top: 8px;">Leaves an atmospheric scent trail in closed spaces and open air.</p>
      </div>

      <div style="border: 1px solid var(--color-border); padding: var(--space-lg);">
        <span class="editorial-label">LONGEVITY</span>
        <h3 class="font-serif" style="font-size: 1.6rem; margin-top: 8px;">14+ HOURS</h3>
        <p class="text-muted" style="font-size: 0.85rem; margin-top: 8px;">Binds to skin lipid oils and holds on wool, cashmere, and coats for days.</p>
      </div>
    </div>

    <!-- Editorial Customer Accolade -->
    <div style="border: 1px solid var(--color-border); padding: var(--space-2xl); background: var(--color-near-black); margin-bottom: var(--space-3xl);" class="gsap-reveal">
      <div style="max-width: 800px; margin: 0 auto; text-align: center;">
        <div style="font-size: 1.2rem; color: var(--color-white); letter-spacing: 0.3em; margin-bottom: 16px;">★★★★★</div>
        <p class="quote-serif" style="font-size: clamp(1.4rem, 2.5vw, 2rem);">
          “Oud Royal is unlike anything from commercial perfume counters. When I put this on, strangers stop me in dark hotel lobbies to ask what scent is floating behind me.”
        </p>
        <p class="editorial-label" style="margin-top: 24px; color: var(--color-soft-white);">— HENRIQUE V., VERIFIED PATRON · PARIS</p>
      </div>
    </div>

    <!-- Cross-Sell: Discover Another Expression -->
    <div class="gsap-reveal">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--space-xl);">
        <div>
          <span class="editorial-label">CONTRAST EXPRESSIONS</span>
          <h2 class="headline-section font-serif" style="margin-top: 8px;">DISCOVER ANOTHER EXPRESSION</h2>
        </div>
        <a href="/collections/all" class="btn-secondary">VIEW ALL FORMULATIONS →</a>
      </div>

      <div class="grid-3">
        <!-- Alternative 1 -->
        <div class="product-card" data-product-id="shop-2" data-title="VELVET IRIS" data-price="₹13,200" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/hero_perfume_bottle.jpg">
          <div class="product-card-media" style="aspect-ratio: 4/5;">
            <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="Velvet Iris" style="filter: grayscale(80%);">
          </div>
          <div class="product-card-body">
            <span class="product-meta">LIGHT CONTRAST · FLORAL SUEDE</span>
            <h3 class="product-title font-serif">VELVET IRIS</h3>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
              <span class="product-price">₹13,200</span>
              <button class="btn-secondary js-add-to-cart" data-title="VELVET IRIS" data-price="₹13,200" data-image="assets/hero_perfume_bottle.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
            </div>
          </div>
        </div>

        <!-- Alternative 2 -->
        <div class="product-card" data-product-id="shop-3" data-title="SANTAL NOCTURNE" data-price="₹15,000" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/bestseller_oud_royal.jpg">
          <div class="product-card-media" style="aspect-ratio: 4/5;">
            <img src="{{ 'bestseller_oud_royal.jpg' | asset_url }}" alt="Santal Nocturne" style="filter: contrast(1.2);">
          </div>
          <div class="product-card-body">
            <span class="product-meta">WOODY CONTRAST · SMOKED PAPYRUS</span>
            <h3 class="product-title font-serif">SANTAL NOCTURNE</h3>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
              <span class="product-price">₹15,000</span>
              <button class="btn-secondary js-add-to-cart" data-title="SANTAL NOCTURNE" data-price="₹15,000" data-image="assets/bestseller_oud_royal.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
            </div>
          </div>
        </div>

        <!-- Alternative 3 -->
        <div class="product-card" data-product-id="shop-7" data-title="THE DISCOVERY COLLECTION" data-price="₹4,500" data-meta="5 X 5ML · EXTRAIT SAMPLER" data-image="assets/discovery_box.jpg">
          <div class="product-card-media" style="aspect-ratio: 4/5;">
            <img src="{{ 'discovery_box.jpg' | asset_url }}" alt="Discovery Collection">
          </div>
          <div class="product-card-body">
            <span class="product-meta">SAMPLER BOX · 5 FORMULATIONS</span>
            <h3 class="product-title font-serif">DISCOVERY SET</h3>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
              <span class="product-price">₹4,500</span>
              <button class="btn-secondary js-add-to-cart" data-title="THE DISCOVERY COLLECTION" data-price="₹4,500" data-image="assets/discovery_box.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mobile/Desktop Scroll Sticky Add to Bag Bar -->
<div class="pdp-sticky-bar">
  <div class="container pdp-sticky-inner">
    <div>
      <span class="editorial-label" style="display: block;">OUD ROYAL · 35% EXTRAIT</span>
      <span class="pdp-price-target font-serif" style="font-size: 1.2rem;">₹14,500 (50 ML)</span>
    </div>
    <button class="btn-primary js-add-to-cart" data-title="OUD ROYAL EXTRAIT" data-price="₹14,500" data-image="assets/bestseller_oud_royal.jpg" data-size="50 ML" style="padding: 12px 24px;">
      <span>ADD TO BAG</span>
      <span class="btn-arrow">→</span>
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Agha Sensory Experience",
  "settings": []
}
{% endschema %}
