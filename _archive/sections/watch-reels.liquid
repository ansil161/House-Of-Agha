{% comment %}
  07 — WATCH OUR REELS
{% endcomment %}

<section class="section-padding border-top-thin" id="reels">
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--space-xl);" class="gsap-reveal">
      <div>
        <span class="editorial-label">07 — CINEMATIC REELS</span>
        <h2 class="headline-section font-serif" style="margin-top: 12px;">WATCH OUR REELS</h2>
      </div>
      <div class="tag-pill">MOTION CINEMA</div>
    </div>

    <div class="reels-scroll-container gsap-reveal">
      <!-- Reel 1 -->
      <div class="reel-card js-quick-view">
        <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="Reel 1 Campaign">
        <div class="reel-play-icon">▶</div>
        <div class="reel-caption">
          <span class="editorial-label">FILM 01</span>
          <h4 class="font-serif" style="font-size: 1.1rem; color: var(--color-white);">THE COMPOUNDING RITUAL</h4>
        </div>
      </div>

      <!-- Reel 2 -->
      <div class="reel-card js-quick-view">
        <img src="{{ 'bestseller_oud_royal.jpg' | asset_url }}" alt="Reel 2 Campaign">
        <div class="reel-play-icon">▶</div>
        <div class="reel-caption">
          <span class="editorial-label">FILM 02</span>
          <h4 class="font-serif" style="font-size: 1.1rem; color: var(--color-white);">BOTANICAL MACERATION</h4>
        </div>
      </div>

      <!-- Reel 3 -->
      <div class="reel-card js-quick-view">
        <img src="{{ 'discovery_box.jpg' | asset_url }}" alt="Reel 3 Campaign">
        <div class="reel-play-icon">▶</div>
        <div class="reel-caption">
          <span class="editorial-label">FILM 03</span>
          <h4 class="font-serif" style="font-size: 1.1rem; color: var(--color-white);">UNBOXING THE DISCOVERY SET</h4>
        </div>
      </div>

      <!-- Reel 4 -->
      <div class="reel-card js-quick-view">
        <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="Reel 4 Campaign" style="filter: grayscale(100%);">
        <div class="reel-play-icon">▶</div>
        <div class="reel-caption">
          <span class="editorial-label">FILM 04</span>
          <h4 class="font-serif" style="font-size: 1.1rem; color: var(--color-white);">THE NOCTURNAL SILHOUETTE</h4>
        </div>
      </div>
    </div>
  </div>
</section>
