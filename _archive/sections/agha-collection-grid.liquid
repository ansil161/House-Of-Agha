{% comment %}
  AGHA COLLECTION EDITORIAL GRID
{% endcomment %}

<section class="section-padding" id="shop-products">
  <div class="container">
    <!-- Filter Navigation Tabs -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2xl);" class="gsap-reveal">
      <nav class="collection-tabs-nav">
        <a href="#" class="collection-tab-link active">ALL FORMULATIONS</a>
        <a href="#" class="collection-tab-link">EXTRAITS DE PARFUM</a>
        <a href="#" class="collection-tab-link">SIGNATURE NOCTURNE</a>
        <a href="#" class="collection-tab-link">DISCOVERY SETS</a>
        <a href="#" class="collection-tab-link">UNISEX</a>
      </nav>

      <button class="btn-secondary js-filter-toggle" style="padding: 10px 20px; font-size: 0.68rem;">
        <span>FILTER (FAMILY / NOTES)</span>
      </button>
    </div>

    <!-- Editorial Product Grid (Asymmetric Layouts) -->
    <div class="grid-4 gsap-reveal" style="row-gap: var(--space-2xl);">
      <!-- Product 1: Oud Royal -->
      <div class="product-card" data-product-id="shop-1" data-title="OUD ROYAL" data-price="₹14,500" data-family="Smoky / Resinous" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/bestseller_oud_royal.jpg" data-description="An imposing composition constructed around wild Cambodian agarwood, cardamoms harvested at dusk, black rose, and dark leather.">
        <div class="product-card-media" style="aspect-ratio: 4/5;">
          <img src="{{ 'bestseller_oud_royal.jpg' | asset_url }}" alt="Oud Royal">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <span class="product-meta">EXTRAIT DE PARFUM · 35% CONCENTRATION</span>
          <h3 class="product-title font-serif">OUD ROYAL</h3>
          <p class="text-muted" style="font-size: 0.8rem; margin-top: 4px;">Cambodian Oud · Saffron · Black Rose</p>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; border-top: 1px solid var(--color-border); padding-top: 12px;">
            <span class="product-price">₹14,500</span>
            <button class="btn-secondary js-add-to-cart" data-title="OUD ROYAL" data-price="₹14,500" data-image="assets/bestseller_oud_royal.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>

      <!-- Product 2: Velvet Iris -->
      <div class="product-card" data-product-id="shop-2" data-title="VELVET IRIS" data-price="₹13,200" data-family="Floral / Suede" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/hero_perfume_bottle.jpg" data-description="An ethereal suede iris fused with white amber and Florentine violet leaves. Macerated for 90 days.">
        <div class="product-card-media" style="aspect-ratio: 4/5;">
          <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="Velvet Iris" style="filter: grayscale(80%);">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <span class="product-meta">EXTRAIT DE PARFUM · 35% CONCENTRATION</span>
          <h3 class="product-title font-serif">VELVET IRIS</h3>
          <p class="text-muted" style="font-size: 0.8rem; margin-top: 4px;">Florentine Iris · White Suede · Violet</p>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; border-top: 1px solid var(--color-border); padding-top: 12px;">
            <span class="product-price">₹13,200</span>
            <button class="btn-secondary js-add-to-cart" data-title="VELVET IRIS" data-price="₹13,200" data-image="assets/hero_perfume_bottle.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>

      <!-- Product 3: Santal Nocturne -->
      <div class="product-card" data-product-id="shop-3" data-title="SANTAL NOCTURNE" data-price="₹15,000" data-family="Woody / Smoked" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/bestseller_oud_royal.jpg" data-description="Australian sandalwood, smoked papyrus, and bourbon vanilla extract. Designed for evening aura.">
        <div class="product-card-media" style="aspect-ratio: 4/5;">
          <img src="{{ 'bestseller_oud_royal.jpg' | asset_url }}" alt="Santal Nocturne" style="filter: contrast(1.2);">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <span class="product-meta">EXTRAIT DE PARFUM · 35% CONCENTRATION</span>
          <h3 class="product-title font-serif">SANTAL NOCTURNE</h3>
          <p class="text-muted" style="font-size: 0.8rem; margin-top: 4px;">Sandalwood · Smoked Papyrus · Bourbon Vanilla</p>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; border-top: 1px solid var(--color-border); padding-top: 12px;">
            <span class="product-price">₹15,000</span>
            <button class="btn-secondary js-add-to-cart" data-title="SANTAL NOCTURNE" data-price="₹15,000" data-image="assets/bestseller_oud_royal.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>

      <!-- Product 4: Amber Absolute -->
      <div class="product-card" data-product-id="shop-4" data-title="AMBER ABSOLUTE" data-price="₹16,500" data-family="Warm / Amber" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/hero_perfume_bottle.jpg" data-description="Golden Baltic resin, benzoin tear drops, and crushed Madagascar clove. Warm and enveloping.">
        <div class="product-card-media" style="aspect-ratio: 4/5;">
          <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="Amber Absolute">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <span class="product-meta">EXTRAIT DE PARFUM · 35% CONCENTRATION</span>
          <h3 class="product-title font-serif">AMBER ABSOLUTE</h3>
          <p class="text-muted" style="font-size: 0.8rem; margin-top: 4px;">Baltic Resin · Benzoin · Clove</p>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; border-top: 1px solid var(--color-border); padding-top: 12px;">
            <span class="product-price">₹16,500</span>
            <button class="btn-secondary js-add-to-cart" data-title="AMBER ABSOLUTE" data-price="₹16,500" data-image="assets/hero_perfume_bottle.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>

      <!-- Product 5: Rose Noir -->
      <div class="product-card" data-product-id="shop-5" data-title="ROSE NOIR" data-price="₹14,000" data-family="Floral / Dark" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/bestseller_oud_royal.jpg" data-description="Wild damask rose steeped in patchouli, vetiver root, and pink peppercorns.">
        <div class="product-card-media" style="aspect-ratio: 4/5;">
          <img src="{{ 'bestseller_oud_royal.jpg' | asset_url }}" alt="Rose Noir" style="filter: sepia(40%) contrast(1.1);">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <span class="product-meta">EXTRAIT DE PARFUM · 35% CONCENTRATION</span>
          <h3 class="product-title font-serif">ROSE NOIR</h3>
          <p class="text-muted" style="font-size: 0.8rem; margin-top: 4px;">Damask Rose · Patchouli · Pink Pepper</p>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; border-top: 1px solid var(--color-border); padding-top: 12px;">
            <span class="product-price">₹14,000</span>
            <button class="btn-secondary js-add-to-cart" data-title="ROSE NOIR" data-price="₹14,000" data-image="assets/bestseller_oud_royal.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>

      <!-- Product 6: Cuir Imperial -->
      <div class="product-card" data-product-id="shop-6" data-title="CUIR IMPERIAL" data-price="₹17,200" data-family="Leather / Resinous" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/hero_perfume_bottle.jpg" data-description="Tanned Russian leather, birch tar, wild thyme, and dark labdanum. Unapologetic presence.">
        <div class="product-card-media" style="aspect-ratio: 4/5;">
          <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="Cuir Imperial" style="filter: contrast(1.3);">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <span class="product-meta">EXTRAIT DE PARFUM · 35% CONCENTRATION</span>
          <h3 class="product-title font-serif">CUIR IMPERIAL</h3>
          <p class="text-muted" style="font-size: 0.8rem; margin-top: 4px;">Tanned Leather · Birch Tar · Labdanum</p>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; border-top: 1px solid var(--color-border); padding-top: 12px;">
            <span class="product-price">₹17,200</span>
            <button class="btn-secondary js-add-to-cart" data-title="CUIR IMPERIAL" data-price="₹17,200" data-image="assets/hero_perfume_bottle.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>

      <!-- Product 7: Discovery Sampler Set -->
      <div class="product-card" data-product-id="shop-7" data-title="THE DISCOVERY COLLECTION" data-price="₹4,500" data-family="Sampler Box" data-meta="5 X 5ML · EXTRAIT SAMPLER" data-image="assets/discovery_box.jpg" data-description="Experience 5 iconic extraits de parfum before choosing your full 50ml flacon. Includes a ₹4,500 voucher.">
        <div class="product-card-media" style="aspect-ratio: 4/5;">
          <img src="{{ 'discovery_box.jpg' | asset_url }}" alt="Discovery Collection">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <span class="product-meta">SAMPLER EXPERIENCE · 5 X 5ML</span>
          <h3 class="product-title font-serif">DISCOVERY SET</h3>
          <p class="text-muted" style="font-size: 0.8rem; margin-top: 4px;">5 Fragrance Atomizers + Voucher</p>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; border-top: 1px solid var(--color-border); padding-top: 12px;">
            <span class="product-price">₹4,500</span>
            <button class="btn-secondary js-add-to-cart" data-title="THE DISCOVERY COLLECTION" data-price="₹4,500" data-image="assets/discovery_box.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>

      <!-- Product 8: Vetiver Celeste -->
      <div class="product-card" data-product-id="shop-8" data-title="VETIVER CELESTE" data-price="₹13,800" data-family="Earthy / Fresh" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/hero_perfume_bottle.jpg" data-description="Smoky Haitian vetiver root, bergamot zest, and grey amber resin. Ethereal and grounding.">
        <div class="product-card-media" style="aspect-ratio: 4/5;">
          <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="Vetiver Celeste" style="filter: grayscale(50%);">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <span class="product-meta">EXTRAIT DE PARFUM · 35% CONCENTRATION</span>
          <h3 class="product-title font-serif">VETIVER CELESTE</h3>
          <p class="text-muted" style="font-size: 0.8rem; margin-top: 4px;">Haitian Vetiver · Bergamot · Grey Amber</p>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; border-top: 1px solid var(--color-border); padding-top: 12px;">
            <span class="product-price">₹13,800</span>
            <button class="btn-secondary js-add-to-cart" data-title="VETIVER CELESTE" data-price="₹13,800" data-image="assets/hero_perfume_bottle.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Animated Filter Drawer Overlay -->
<div class="filter-drawer-overlay"></div>
<div class="filter-drawer">
  <div style="padding: var(--space-lg); border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
    <div>
      <span class="editorial-label">CURATION</span>
      <h3 class="font-serif" style="font-size: 1.4rem;">FILTER FORMULATIONS</h3>
    </div>
    <button class="js-filter-close" style="background: none; border: none; color: var(--color-white); font-size: 1.5rem; cursor: pointer;">&times;</button>
  </div>

  <div style="padding: var(--space-lg); flex-grow: 1; overflow-y: auto;">
    <!-- Olfactory Family -->
    <div class="filter-group">
      <div class="filter-group-title">OLFACTORY FAMILY</div>
      <div class="filter-options-list">
        <button class="filter-chip">SMOKY</button>
        <button class="filter-chip">RESINOUS</button>
        <button class="filter-chip">FLORAL</button>
        <button class="filter-chip">SUEDE</button>
        <button class="filter-chip">WOODY</button>
        <button class="filter-chip">AMBER</button>
        <button class="filter-chip">LEATHER</button>
      </div>
    </div>

    <!-- Notes -->
    <div class="filter-group">
      <div class="filter-group-title">KEY NOTES</div>
      <div class="filter-options-list">
        <button class="filter-chip">CAMBODIAN OUD</button>
        <button class="filter-chip">FLORENTINE IRIS</button>
        <button class="filter-chip">BLACK ROSE</button>
        <button class="filter-chip">BALTIC RESIN</button>
        <button class="filter-chip">BIRCH TAR</button>
      </div>
    </div>

    <!-- Concentration -->
    <div class="filter-group">
      <div class="filter-group-title">CONCENTRATION</div>
      <div class="filter-options-list">
        <button class="filter-chip">35% EXTRAIT DE PARFUM</button>
        <button class="filter-chip">DISCOVERY SAMPLER</button>
      </div>
    </div>
  </div>

  <div style="padding: var(--space-lg); border-top: 1px solid var(--color-border);">
    <button class="btn-primary js-filter-close" style="width: 100%; justify-content: center;">
      <span>APPLY FILTERS</span>
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Agha Collection Grid",
  "settings": []
}
{% endschema %}
