{% comment %}
  AGHA PDP — WHY WE ARE BETTER
  Editorial 2 × 2 grid of brand proofs: line icon, bold uppercase title, short description.
  Every benefit is a block, so copy and icons are edited in the theme editor; nothing is
  written in Liquid. Styling: assets/pdp-editorial.css (all classes prefixed pdx-).
  Motion: assets/pdp-editorial.js (IntersectionObserver + CSS transitions, off for reduced motion).
{% endcomment %}
{{ 'pdp-editorial.css' | asset_url | stylesheet_tag }}
<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('pdx-js');
</script>
<script src="{{ 'pdp-editorial.js' | asset_url }}" defer></script>

{%- if section.blocks.size > 0 -%}
<section class="pdx pdx-why" data-pdx-why>
  <div class="pdx-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="pdx-heading" data-pdx-in>{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="pdx-why__grid">
      {%- for block in section.blocks -%}
        <div class="pdx-why__item" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="pdx-why__icon">{% render 'pdx-icon', name: block.settings.icon %}</span>
          <h3 class="pdx-why__title">{{ block.settings.title | escape | newline_to_br }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="pdx-why__text">{{ block.settings.text | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Agha PDP · Why we are better",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why we are better" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 8,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "badge", "options": [
          { "value": "badge", "label": "Certified badge" },
          { "value": "bottle", "label": "Perfume bottle" },
          { "value": "hourglass", "label": "Hourglass" },
          { "value": "ifra", "label": "IFRA mark" },
          { "value": "leaf", "label": "Leaf" },
          { "value": "drop", "label": "Drop" },
          { "value": "shield", "label": "Shield" }
        ] },
        { "type": "textarea", "id": "title", "label": "Title", "info": "A new line starts a new row.", "default": "Certified\nperfumers" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Agha PDP · Why we are better",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "badge", "title": "Certified\nperfumers", "text": "Hong Kong\nSchool of Perfumery" } },
        { "type": "benefit", "settings": { "icon": "bottle", "title": "35% pure\nparfum", "text": "Extrait de parfum" } },
        { "type": "benefit", "settings": { "icon": "hourglass", "title": "Aged for\nweeks", "text": "Smooth and refined" } },
        { "type": "benefit", "settings": { "icon": "ifra", "title": "IFRA\ncertified", "text": "High-grade, skin safe" } }
      ]
    }
  ]
}
{% endschema %}
