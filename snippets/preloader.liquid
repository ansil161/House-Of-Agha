{%- comment -%}
  "The Drop" preloader: one drop of fragrance falls onto an invisible surface, its ripple reveals
  the wordmark, and a last ripple opens into the page. Rendered right after <body> in
  layout/theme.liquid. Once per session (sessionStorage 'agha-preloader-seen'), never in the theme
  editor. Settings: Theme settings > Preloader.

  Motion runs on the theme's GSAP (deferred from the <head>), so the sequence starts at
  DOMContentLoaded; until then the overlay is a blank page-coloured screen. Without GSAP, or
  under prefers-reduced-motion, the wordmark shows briefly and the overlay fades.

  Page contract (hoa-home.js, hoa-about.js):
  - html.pl-on while the overlay is up: scroll is locked and Lenis is stopped.
  - document event 'pl:reveal' fires when the page starts to show (entrances start then);
    window.hoaPreloaderRevealed is true from that point.
  - html.pl-on is removed once the overlay is gone.
{%- endcomment -%}
{%- if settings.preloader_enable and request.design_mode != true -%}
<style>
html.pl-on{overflow:hidden;scrollbar-gutter:stable}html.pl-skip .pl{display:none}
.pl{--pl-ink:{{ settings.preloader_accent }};--pl-bg:{{ settings.preloader_bg }};--pl-rip:min(68vw,340px);position:fixed;inset:0;z-index:2147483000;color:var(--pl-ink);overflow:hidden;contain:strict}
.pl-veil{position:absolute;inset:0;background:var(--pl-bg)}
.pl-stage,.pl-brand{position:absolute;left:50%;top:50%}
.pl-stage{width:0;height:0}
.pl-stage>*{position:absolute;left:0;top:0;opacity:0;will-change:transform,opacity}
.pl-drop{width:9px;height:12px;margin:-12px 0 0 -4.5px;transform-origin:50% 100%}
.pl-drop i{position:absolute;left:0;bottom:0;width:9px;height:9px;border-radius:0 50% 50% 50%;transform:rotate(45deg) skew(3deg,3deg);background:var(--pl-ink);
  background:radial-gradient(circle at 36% 40%,rgba(255,255,255,.42) 0 .9px,transparent 2.2px),radial-gradient(circle at 60% 62%,var(--pl-ink),color-mix(in srgb,var(--pl-ink) 78%,transparent));
  box-shadow:0 1px 2px color-mix(in srgb,var(--pl-ink) 18%,transparent)}
.pl-impact{width:60px;height:10px;margin:-5px 0 0 -30px;border-radius:50%;background:radial-gradient(closest-side,var(--pl-ink),transparent)}
.pl-rip{width:var(--pl-rip);height:var(--pl-rip);margin:calc(var(--pl-rip)/-2) 0 0 calc(var(--pl-rip)/-2);border:1px solid currentColor;border-radius:50%}
.pl-ring{width:0;height:0;border:1px solid currentColor;border-radius:50%;transform:translate(-50%,-50%);will-change:width,height,opacity}
.pl-brand{display:flex;flex-direction:column;align-items:center;gap:14px;transform:translate(-50%,-50%);text-align:center}
.pl-brand>*{opacity:0}
.pl-logo{display:block;width:clamp(124px,24vw,188px);height:auto}
.pl-tag{margin:0 -.34em 0 0;font:500 10px/1 var(--hoa-sans,sans-serif);letter-spacing:.34em;text-transform:uppercase;white-space:nowrap;color:var(--pl-ink)}
.pl-still .pl-brand>*{opacity:1}.pl-still .pl-tag{opacity:.6}
@media (max-width:599px){.pl{--pl-rip:min(74vw,280px)}.pl-rip--3{display:none}.pl-tag{font-size:9px}}
</style>
<script>try{document.documentElement.classList.add(sessionStorage.getItem('agha-preloader-seen')?'pl-skip':'pl-on')}catch(e){document.documentElement.classList.add('pl-on')}</script>
<div class="pl" id="pl" aria-hidden="true">
  <div class="pl-veil"></div>
  <div class="pl-stage">
    <div class="pl-impact"></div>
    <div class="pl-rip pl-rip--1"></div>
    <div class="pl-rip pl-rip--2"></div>
    <div class="pl-rip pl-rip--3"></div>
    <div class="pl-ring"></div>
    <div class="pl-drop"><i></i></div>
  </div>
  <div class="pl-brand">
    <img class="pl-logo" src="{{ 'agha-logo.avif' | asset_url }}" alt="" width="500" height="156" decoding="async" fetchpriority="high">
    {%- if settings.preloader_tagline != blank -%}<p class="pl-tag">{{ settings.preloader_tagline | escape }}</p>{%- endif -%}
  </div>
</div>
<script>
(function(){
var d=document,h=d.documentElement,o=d.getElementById('pl');if(!o)return;
if(h.classList.contains('pl-skip')){o.remove();return}
try{sessionStorage.setItem('agha-preloader-seen','1')}catch(e){}
var loaded=d.readyState=='complete',started=0,revealed=0,ended=0,tl,cap,onLoad;
function reveal(){if(revealed)return;revealed=1;window.hoaPreloaderRevealed=true;o.style.pointerEvents='none';
  try{d.dispatchEvent(new CustomEvent('pl:reveal'))}catch(e){}}
function end(){if(ended)return;ended=1;reveal();clearTimeout(cap);removeEventListener('load',onLoad);
  if(tl)tl.kill();o.remove();h.classList.remove('pl-on');
  if(window.ScrollTrigger)requestAnimationFrame(function(){ScrollTrigger.refresh()})}
/* No GSAP or reduced motion: wordmark, a short hold, a short fade. */
function still(){if(started)return;started=1;o.classList.add('pl-still');
  setTimeout(function(){reveal();o.style.transition='opacity .3s ease';o.style.opacity=0;setTimeout(end,320)},
    matchMedia('(prefers-reduced-motion: reduce)').matches?350:600)}
function run(){
  var g=window.gsap;
  if(started)return;
  if(!g||matchMedia('(prefers-reduced-motion: reduce)').matches)return still();
  started=1;
  var q=function(s){return o.querySelector(s)},
      drop=q('.pl-drop'),impact=q('.pl-impact'),ring=q('.pl-ring'),veil=q('.pl-veil'),
      rips=[q('.pl-rip--1'),q('.pl-rip--2'),q('.pl-rip--3')],logo=q('.pl-logo'),tag=q('.pl-tag'),
      small=innerWidth<600,travel=Math.round(Math.min(small?84:124,innerHeight*.16)),
      peaks=[.24,.14,.07],R={r:0};
  onLoad=function(){loaded=true;if(tl.paused())tl.play()};
  addEventListener('load',onLoad);
  /* Never hold anyone longer than this, whatever is still loading. */
  cap=setTimeout(onLoad,6000);
  g.set(drop,{y:-travel,scale:.6,opacity:0});
  g.set(impact,{scaleX:0,opacity:0});
  g.set(rips,{scale:.05,opacity:0});
  g.set(ring,{opacity:0});
  g.set(logo,{opacity:0,y:10,scale:1.035});
  if(tag)g.set(tag,{opacity:0,y:6,letterSpacing:'0.5em'});
  tl=g.timeline({onComplete:end});
  tl.to(drop,{opacity:1,scale:1,duration:.3,ease:'power2.out'},.2)
    .to(drop,{y:0,scaleY:1.16,scaleX:.9,duration:.7,ease:'power3.in'},.45)
    /* impact: the drop flattens into the surface and is gone, the ripple carries on */
    .to(drop,{scaleY:.5,scaleX:1.32,duration:.1,ease:'power2.in'},1.15)
    .to(drop,{scaleY:.14,scaleX:1.9,opacity:0,duration:.22,ease:'power2.out'},1.25)
    .to(impact,{scaleX:1,opacity:.15,duration:.12,ease:'power2.out'},1.15)
    .to(impact,{scaleX:.5,opacity:0,duration:.45,ease:'sine.out'},1.27);
  rips.forEach(function(el,i){var t=1.2+i*.08;
    tl.to(el,{scale:1,duration:.95,ease:'power2.out'},t)
      .to(el,{opacity:peaks[i],duration:.14,ease:'sine.out'},t)
      .to(el,{opacity:0,duration:.72,ease:'sine.in'},t+.16)});
  /* the wordmark arrives once the first ripple is about a quarter open */
  tl.to(logo,{opacity:1,y:0,scale:1,duration:.8,ease:'power3.out'},1.45);
  if(tag)tl.to(tag,{opacity:.6,y:0,letterSpacing:'0.34em',duration:.6,ease:'power2.out'},1.8);
  /* hold on the wordmark only while the page is genuinely still loading */
  tl.addPause(2.2,function(){if(loaded)tl.play()})
    .call(reveal,null,2.2)
    /* the last ripple: a ring whose inside is the page, opened to the farthest corner */
    .set(ring,{opacity:.22},2.2)
    .to(R,{r:function(){return Math.hypot(innerWidth,innerHeight)/2+4},duration:.78,ease:'power3.inOut',onUpdate:function(){
      var r=R.r,m='radial-gradient(circle at 50% 50%,transparent '+r+'px,#000 '+(r+1.5)+'px)';
      veil.style.webkitMaskImage=veil.style.maskImage=m;ring.style.width=ring.style.height=2*r+'px'}},2.2)
    .to(ring,{opacity:0,duration:.5,ease:'sine.in'},2.48)
    /* the wordmark steps back as the page opens behind it */
    .to(logo.parentNode,{opacity:0,duration:.32,ease:'power1.in'},2.22);
}
if(d.readyState=='loading')d.addEventListener('DOMContentLoaded',run);else run();
/* If the deferred scripts stall, never leave the page covered. */
setTimeout(still,4000);
})();
</script>
{%- endif -%}
