{% comment %}
  SITE FOOTER · light editorial split
  Left: a short serif statement and the newsletter as a nested pill field (button-in-button).
  Right: three link columns. Logo heads the left column. Bottom: legal line, social icons. Black ground, hairlines,
  no watermark. Styles: the "Footer" block in assets/hoa-home.css (loaded on every page).
  The local preview build swaps this same markup into every static page
  (tools/render-preview.js), so edit it here only.
  Links use real Shopify routes; the preview has redirect stubs for the /pages/ ones.
  Phones: the column titles are buttons that fold their lists (assets/hoa-mobile.js); elsewhere
  they read as plain headings.
{% endcomment %}
<footer class="footer hoa-footer" data-header-theme="dark">
  <div class="hoa-wrap">

    <div class="hoa-footer__split">
      <section class="hoa-footer__letter" aria-labelledby="hoa-footer-letter-title">
        <a href="{{ routes.root_url }}" class="footer-logo hoa-footer__logo" aria-label="House of Agha, home"><img src="{{ 'agha-logo.avif' | asset_url }}" alt="House of Agha" width="500" height="156" loading="lazy"></a>
        <p class="hoa-footer__eyebrow">The House Letter</p>
        <h2 class="hoa-footer__display" id="hoa-footer-letter-title">Made to linger.<br><span>Written to you once a month.</span></h2>
        {%- form 'customer', class: 'hoa-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="hoa-footer__field" for="hoa-footer-email">
            <span class="hoa-footer__sr">Email address</span>
            <input id="hoa-footer-email" type="email" name="contact[email]" autocomplete="email" placeholder="Email address" required>
          </label>
          <button type="submit" class="hoa-footer__submit">
            <span>Subscribe</span>
            <span class="hoa-footer__submit-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M4.5 11.5l7-7M5.5 4.5h6v6" stroke="currentColor" stroke-width="1.3"/></svg></span>
          </button>
          {%- if form.posted_successfully? -%}
            <p class="hoa-footer__note" role="status">Thank you. You are on the list.</p>
          {%- elsif form.errors -%}
            <p class="hoa-footer__note hoa-footer__note--error" role="alert">Please enter a valid email address.</p>
          {%- endif -%}
        {%- endform -%}
      </section>

      <div class="hoa-footer__main">
        <nav class="hoa-footer__col" aria-labelledby="hoa-footer-shop">
          <h3 class="hoa-footer__title" id="hoa-footer-shop"><button type="button" class="hoa-footer__toggle" aria-expanded="true" aria-controls="hoa-footer-shop-list" data-hoa-fold>Shop<span class="hoa-footer__fold-icon" aria-hidden="true"></span></button></h3>
          <ul class="footer-links" role="list" id="hoa-footer-shop-list">
            <li><a href="{{ routes.all_products_collection_url }}">All fragrances</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?for=men">For him</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?for=women">For her</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?gift=1">Gifts</a></li>
            <li><a href="{{ routes.root_url }}pages/wishlist" data-wishlist-open>Wishlist</a></li>
          </ul>
        </nav>

        <nav class="hoa-footer__col" aria-labelledby="hoa-footer-house">
          <h3 class="hoa-footer__title" id="hoa-footer-house"><button type="button" class="hoa-footer__toggle" aria-expanded="true" aria-controls="hoa-footer-house-list" data-hoa-fold>The House<span class="hoa-footer__fold-icon" aria-hidden="true"></span></button></h3>
          <ul class="footer-links" role="list" id="hoa-footer-house-list">
            <li><a href="{{ routes.root_url }}pages/the-house">Our story</a></li>
            <li><a href="{{ routes.root_url }}pages/private-access">Private access</a></li>
            <li><a href="{{ routes.account_url }}">Your account</a></li>
          </ul>
        </nav>

        <nav class="hoa-footer__col" aria-labelledby="hoa-footer-care">
          <h3 class="hoa-footer__title" id="hoa-footer-care"><button type="button" class="hoa-footer__toggle" aria-expanded="true" aria-controls="hoa-footer-care-list" data-hoa-fold>Client care<span class="hoa-footer__fold-icon" aria-hidden="true"></span></button></h3>
          <ul class="footer-links" role="list" id="hoa-footer-care-list">
            <li><a href="{{ routes.root_url }}pages/shipping-returns">Shipping &amp; returns</a></li>
            <li><a href="{{ routes.root_url }}pages/contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="footer-bottom hoa-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} House of Agha &middot; Composed in Hyderabad</p>
      {%- comment -%} Facebook, YouTube and WhatsApp hrefs are placeholders until the real links arrive {%- endcomment -%}
      <ul class="hoa-footer__socials" role="list">
        <li><a class="hoa-footer__social" href="https://www.instagram.com/aghaperfumes/" target="_blank" rel="noopener" aria-label="Instagram (opens in a new tab)"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="3.9" stroke="currentColor" stroke-width="1.5"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor"/></svg></a></li>
        <li><a class="hoa-footer__social" href="#" target="_blank" rel="noopener" aria-label="Facebook (opens in a new tab)"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13.5 20.5v-7.25h2.6l.4-3h-3v-1.9c0-.87.25-1.45 1.5-1.45h1.6V4.2a21 21 0 0 0-2.33-.12c-2.3 0-3.87 1.4-3.87 3.98v2.19H7.8v3h2.6v7.25" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></a></li>
        <li><a class="hoa-footer__social" href="#" target="_blank" rel="noopener" aria-label="YouTube (opens in a new tab)"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.75" y="5.5" width="18.5" height="13" rx="3.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.25 9.25v5.5L15 12z" fill="currentColor"/></svg></a></li>
        <li><a class="hoa-footer__social" href="#" target="_blank" rel="noopener" aria-label="WhatsApp (opens in a new tab)"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.2 19.8l1.1-3.9A8.25 8.25 0 1 1 8.4 19z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9.2 8.4c.2-.4.5-.4.8-.4h.5c.2 0 .4.1.5.4l.6 1.5c.1.2 0 .5-.1.6l-.5.6c.6 1.1 1.4 1.9 2.5 2.5l.6-.5c.2-.2.4-.2.6-.1l1.5.6c.3.1.4.3.4.5v.5c0 .3-.1.6-.4.8-.5.4-1.2.5-1.9.3-2.4-.7-4.4-2.7-5.1-5.1-.2-.7-.1-1.4.3-1.9z" fill="currentColor"/></svg></a></li>
      </ul>
    </div>
  </div>
</footer>
