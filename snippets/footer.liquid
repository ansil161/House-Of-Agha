{% comment %}
  SITE FOOTER
  Quiet and simple, black: brand + a small newsletter field, three link columns, then one
  legal line. Hairline dividers only; no pills, gradients or watermark. Styles: the "Footer"
  block in assets/hoa-home.css (loaded on every page). The local preview build swaps this
  same markup into every static page (tools/render-preview.js), so edit it here only.
  Links use real Shopify routes; the preview has redirect stubs for the /pages/ ones.
  Phones: the column titles are buttons that fold their lists (assets/hoa-mobile.js); elsewhere
  they read as plain headings.
{% endcomment %}
<footer class="footer hoa-footer" data-header-theme="dark">
  <div class="hoa-wrap">

    <div class="hoa-footer__top">
      <div class="hoa-footer__brand">
        <a href="{{ routes.root_url }}" class="footer-logo hoa-footer__logo" aria-label="House of Agha, home"><img src="{{ 'agha-logo.avif' | asset_url }}" alt="House of Agha" width="500" height="156" loading="lazy"></a>
        <p class="hoa-footer__about">Concentrated Eau de Parfum from oud, amber and rare florals, composed in Hyderabad.</p>
      </div>

      <section class="hoa-footer__letter" aria-labelledby="hoa-footer-letter-title">
        <h2 class="hoa-footer__label" id="hoa-footer-letter-title">The House Letter</h2>
        <p class="hoa-footer__lede">New releases and notes from the atelier. Once a month at most.</p>
        {%- form 'customer', class: 'hoa-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="hoa-footer__field" for="hoa-footer-email">
            <span class="hoa-footer__sr">Email address</span>
            <input id="hoa-footer-email" type="email" name="contact[email]" autocomplete="email" placeholder="Email address" required>
          </label>
          <button type="submit" class="hoa-footer__submit">
            <span>Subscribe</span>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"/></svg>
          </button>
          {%- if form.posted_successfully? -%}
            <p class="hoa-footer__note" role="status">Thank you. You are on the list.</p>
          {%- elsif form.errors -%}
            <p class="hoa-footer__note hoa-footer__note--error" role="alert">Please enter a valid email address.</p>
          {%- endif -%}
        {%- endform -%}
      </section>
    </div>

    <div class="hoa-footer__main">
      <nav class="hoa-footer__col" aria-labelledby="hoa-footer-shop">
        <h3 class="hoa-footer__title" id="hoa-footer-shop"><button type="button" class="hoa-footer__toggle" aria-expanded="true" aria-controls="hoa-footer-shop-list" data-hoa-fold>Shop<span class="hoa-footer__fold-icon" aria-hidden="true"></span></button></h3>
        <ul class="footer-links" role="list" id="hoa-footer-shop-list">
          <li><a href="{{ routes.all_products_collection_url }}">All fragrances</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?for=men">For him</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?for=women">For her</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?gift=1">Gifts</a></li>
          <li><a href="{{ routes.root_url }}pages/wishlist" data-wishlist-open>Wishlist</a></li>
        </ul>
      </nav>

      <nav class="hoa-footer__col" aria-labelledby="hoa-footer-house">
        <h3 class="hoa-footer__title" id="hoa-footer-house"><button type="button" class="hoa-footer__toggle" aria-expanded="true" aria-controls="hoa-footer-house-list" data-hoa-fold>The House<span class="hoa-footer__fold-icon" aria-hidden="true"></span></button></h3>
        <ul class="footer-links" role="list" id="hoa-footer-house-list">
          <li><a href="{{ routes.root_url }}pages/the-house">Our story</a></li>
          <li><a href="{{ routes.root_url }}pages/private-access">Private access</a></li>
          <li><a href="{{ routes.account_url }}">Your account</a></li>
        </ul>
      </nav>

      <nav class="hoa-footer__col" aria-labelledby="hoa-footer-care">
        <h3 class="hoa-footer__title" id="hoa-footer-care"><button type="button" class="hoa-footer__toggle" aria-expanded="true" aria-controls="hoa-footer-care-list" data-hoa-fold>Client care<span class="hoa-footer__fold-icon" aria-hidden="true"></span></button></h3>
        <ul class="footer-links" role="list" id="hoa-footer-care-list">
          <li><a href="{{ routes.root_url }}pages/shipping-returns">Shipping &amp; returns</a></li>
          <li><a href="{{ routes.root_url }}pages/faq">Questions</a></li>
          <li><a href="{{ routes.root_url }}pages/contact">Contact</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom hoa-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} House of Agha</p>
      <a href="https://www.instagram.com/aghaperfumes/" target="_blank" rel="noopener">Instagram<span class="hoa-footer__sr"> (opens in a new tab)</span></a>
    </div>
  </div>
</footer>
