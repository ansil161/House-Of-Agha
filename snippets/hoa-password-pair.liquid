{%- comment -%}
  House of Agha: new password + confirmation, shared by the reset and activate templates.
  Params: errors (form.errors), prefix (prefix for the input ids)
{%- endcomment -%}
{%- liquid
  assign pw_id = prefix | append: 'Password'
  assign confirm_id = prefix | append: 'PasswordConfirm'
  assign pw_invalid = false
  assign confirm_invalid = false
  if errors contains 'password'
    assign pw_invalid = true
  endif
  if errors contains 'password_confirmation'
    assign confirm_invalid = true
  endif
-%}
{%- render 'hoa-field',
  id: pw_id,
  name: 'customer[password]',
  type: 'password',
  label: 'New password',
  autocomplete: 'new-password',
  required: true,
  invalid: pw_invalid,
  autofocus: true
-%}
{%- render 'hoa-field',
  id: confirm_id,
  name: 'customer[password_confirmation]',
  type: 'password',
  label: 'Confirm new password',
  autocomplete: 'new-password',
  required: true,
  invalid: confirm_invalid
-%}
