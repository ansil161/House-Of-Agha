{%- comment -%}
  House of Agha header: split navigation, centred wordmark.
  Keeps the hooks theme.js relies on: .header, .js-cart-toggle, .cart-count, .js-mobile-menu.
  On the homepage assets/hoa-home.js makes it transparent over the hero and light over dark sections.
{%- endcomment -%}
<header class="header hoa-header" data-hoa-header>
  <div class="hoa-header__inner">
    <div class="hoa-header__start">
      <ul class="hoa-header__nav hoa-header__nav--left">
        <li><a href="{{ routes.root_url }}"{% if template.name == 'index' %} aria-current="page"{% endif %}>Home</a></li>
        <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
        <li><a href="/pages/the-house">The House</a></li>
      </ul>
      <button class="hoa-header__menu js-mobile-menu" type="button" aria-expanded="false" aria-controls="hoa-menu">
        <span class="hoa-header__menu-lines" aria-hidden="true"></span>
        <span class="hoa-header__menu-label">Menu</span>
      </button>
    </div>

    <a href="{{ routes.root_url }}" class="header-brand hoa-header__brand" aria-label="House of Agha, home">
      <img class="hoa-header__logo" src="{{ 'agha-logo.avif' | asset_url }}" alt="House of Agha" width="500" height="156">
    </a>

    <ul class="hoa-header__nav hoa-header__nav--right">
      <li class="hoa-header__hide-sm"><a class="hoa-header__wish" data-wishlist-open aria-haspopup="dialog" href="{{ routes.root_url }}pages/wishlist"{% if template.suffix == 'wishlist' %} aria-current="page"{% endif %}>Wishlist<sup class="hoa-header__wish-count" data-wishlist-count hidden></sup></a></li>
      {%- if shop.customer_accounts_enabled -%}
        <li class="hoa-header__hide-sm"><a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"{% if template.directory == 'customers' %} aria-current="page"{% endif %}>Account</a></li>
      {%- endif -%}
      <li class="hoa-header__show-sm">
        <button class="hoa-header__icon-btn" type="button" data-hoa-search-open aria-haspopup="dialog" aria-controls="hoa-search" aria-label="Search fragrances">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="1.5"/><path d="M15.2 15.2 20 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      </li>
      <li>
        <button class="header-action-btn js-cart-toggle" type="button" aria-label="Open bag">
          <svg class="hoa-header__bag-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.75 8.25h14.5l-1.1 11.5H5.85L4.75 8.25Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8.5 8.25V7a3.5 3.5 0 0 1 7 0v1.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span class="hoa-header__bag-label">Bag</span>
          <span class="cart-count">{{ cart.item_count | default: 0 }}</span>
        </button>
      </li>
    </ul>
  </div>
</header>

<nav class="hoa-menu" id="hoa-menu" aria-label="Main">
  <button class="hoa-menu__search" type="button" data-hoa-search-open aria-haspopup="dialog" aria-controls="hoa-search">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="1.5"/><path d="M15.2 15.2 20 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    <span>Search fragrances and families</span>
  </button>
  <ul class="hoa-menu__links">
    <li><a href="{{ routes.root_url }}"><span>01</span>Home</a></li>
    <li><a href="{{ routes.all_products_collection_url }}"><span>02</span>Shop <em>all</em></a></li>
    <li><a href="/pages/the-house"><span>03</span>The House</a></li>
    <li><a href="/pages/private-access"><span>04</span>Private Access</a></li>
    {%- if shop.customer_accounts_enabled -%}
      <li><a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"><span>05</span>{% if customer %}Account{% else %}Sign <em>in</em>{% endif %}</a></li>
    {%- endif -%}
    <li><a href="{{ routes.root_url }}pages/wishlist" data-wishlist-open><span>06</span>Wish<em>list</em></a></li>
  </ul>
  <div class="hoa-menu__shop">
    <p class="hoa-menu__label">Shop by</p>
    <ul class="hoa-menu__chips" role="list">
      <li><a href="{{ routes.all_products_collection_url }}?for=men">For him</a></li>
      <li><a href="{{ routes.all_products_collection_url }}?for=women">For her</a></li>
      <li><a href="{{ routes.all_products_collection_url }}?for=unisex">Unisex</a></li>
      <li><a href="{{ routes.all_products_collection_url }}?gift=1">Gifts</a></li>
    </ul>
  </div>
  <div class="hoa-menu__foot">
    <ul class="hoa-menu__care" role="list">
      <li><a href="{{ routes.root_url }}pages/shipping-returns">Shipping &amp; returns</a></li>
      <li><a href="{{ routes.root_url }}pages/faq">Questions</a></li>
      <li><a href="{{ routes.root_url }}pages/contact">Contact</a></li>
    </ul>
    <p>House of Agha · Eau de Parfum</p>
  </div>
</nav>

{%- comment -%}
  Search: a sheet over the page, opened by [data-hoa-search-open] (header icon on phones, the menu).
  assets/hoa-mobile.js fills the results from the catalog (window.HOA). Without JS the form still
  submits to Shopify's /search.
{%- endcomment -%}
<div class="hoa-search" id="hoa-search" role="dialog" aria-modal="true" aria-label="Search" hidden data-lenis-prevent>
  <div class="hoa-search__panel">
    <form class="hoa-search__form" action="{{ routes.search_url }}" method="get" role="search" data-hoa-search-form>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="1.5"/><path d="M15.2 15.2 20 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <label class="hoa-search__sr" for="hoa-search-q">Search</label>
      <input id="hoa-search-q" type="search" name="q" placeholder="Oud, woody, for her…" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" data-hoa-search-input>
      <input type="hidden" name="type" value="product">
      <button type="button" class="hoa-search__close" data-hoa-search-close>Cancel</button>
    </form>
    <div class="hoa-search__body">
      <div class="hoa-search__suggest" data-hoa-search-suggest>
        <p class="hoa-search__label">Popular</p>
        <ul class="hoa-search__chips" role="list">
          <li><button type="button" data-hoa-search-term="Oud">Oud</button></li>
          <li><button type="button" data-hoa-search-term="Woody">Woody</button></li>
          <li><button type="button" data-hoa-search-term="Fresh">Fresh</button></li>
          <li><button type="button" data-hoa-search-term="Floral">Floral</button></li>
          <li><button type="button" data-hoa-search-term="For her">For her</button></li>
        </ul>
      </div>
      <p class="hoa-search__status" aria-live="polite" data-hoa-search-status></p>
      <ul class="hoa-search__results" role="list" data-hoa-search-results></ul>
    </div>
  </div>
</div>
