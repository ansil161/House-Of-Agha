{%- comment -%}
  HOUSE OF AGHA — welcome coupon popup (rendered sitewide from layout/theme.liquid).
  Shows once per browsing session, 10 seconds after page load (see assets/hoa-coupon.js).
  The code comes from the shared mock catalog (snippets/hoa-catalog-data.liquid → coupons), and the bag
  (assets/hoa-commerce.js) validates and applies that same code, so what the popup shows always works.
  Mock only for now: nothing here talks to Shopify.

  TO USE A REAL DISCOUNT CODE: create it in Shopify Admin → Discounts and change the coupon's "code" in
  the catalog to match; the bag already links checkout with ?discount=CODE.
{%- endcomment -%}
{%- capture catalog_json -%}{%- render 'hoa-catalog-data' -%}{%- endcapture -%}
{%- assign catalog = catalog_json | parse_json -%}
{%- assign coupon_code = catalog.coupons[0].code -%}
{%- assign coupon_value = catalog.coupons[0].value -%}
{%- assign coupon_delay_seconds = 10 -%}

<div class="hoa-coupon" data-hoa-coupon data-delay="{{ coupon_delay_seconds | times: 1000 }}" hidden>
  <div class="hoa-coupon__scrim" data-coupon-close></div>
  <div class="hoa-coupon__card" role="dialog" aria-modal="true" aria-labelledby="hoa-coupon-title" aria-describedby="hoa-coupon-desc" tabindex="-1">
    <button type="button" class="hoa-coupon__close" data-coupon-close aria-label="Close offer">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"/></svg>
    </button>

    <div class="hoa-coupon__media" aria-hidden="true">
      <img src="{{ 'hoa-product-oud-fury-sm.webp' | asset_url }}" alt="" width="640" height="800" decoding="async">
    </div>

    <div class="hoa-coupon__body">
      <p class="hoa-coupon__eyebrow">Your exclusive offer</p>
      <h2 class="hoa-coupon__title" id="hoa-coupon-title">Enjoy {{ coupon_value }}% off <em>your first order</em></h2>
      <p class="hoa-coupon__desc" id="hoa-coupon-desc" data-coupon-desc data-done="Use this code in your bag before checkout.">Scratch the gold to reveal your code.</p>

      {%- comment -%} Scratch card: the code sits under an opaque canvas foil (assets/hoa-coupon.js). The real text is only written into the page on the first scratch. {%- endcomment -%}
      <div class="hoa-coupon__scratch" data-coupon-scratch>
        <div class="hoa-coupon__under">
          <span class="hoa-coupon__code-label">Your code</span>
          <span class="hoa-coupon__code-value" data-coupon-code data-code="{{ coupon_code }}" aria-hidden="true">&bull;&bull;&bull;&bull;&bull;&bull;</span>
        </div>
        <canvas class="hoa-coupon__foil" data-scratch-canvas role="img" aria-label="Scratch surface hiding your discount code"></canvas>
        <canvas class="hoa-coupon__fx" data-scratch-fx aria-hidden="true"></canvas>
        <span class="hoa-coupon__hint" data-scratch-hint aria-hidden="true">Scratch to reveal
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v9M4 8.5l4 4 4-4"/></svg>
        </span>
      </div>
      <button type="button" class="hoa-coupon__reveal" data-coupon-reveal>Can&rsquo;t scratch? Reveal my code</button>

      <div class="hoa-coupon__actions">
        <button type="button" class="hoa-coupon__copy" data-coupon-copy hidden>COPY CODE</button>
        <a class="hoa-coupon__cta" href="/collections/all" data-coupon-close-link>SHOP NOW</a>
      </div>
      <p class="hoa-coupon__live" role="status" aria-live="polite" data-coupon-status></p>
    </div>
  </div>
</div>
