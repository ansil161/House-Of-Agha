<!-- Quick View Modal -->
<div class="modal-overlay js-modal-close"></div>

<div class="modal-content-box quick-view-modal">
  <button class="modal-close-btn js-modal-close">&times;</button>

  <div class="grid-2" style="align-items: center;">
    <div style="aspect-ratio: 3/4; overflow: hidden; border: 1px solid var(--color-border); background-color: var(--color-black);">
      <img src="assets/bestseller_oud_royal.jpg" alt="Fragrance Quick View" class="qv-image" style="width: 100%; height: 100%; object-fit: cover;">
    </div>

    <div style="display: flex; flex-direction: column; gap: 16px;">
      <span class="editorial-label qv-meta">50 ML · EXTRAIT DE PARFUM</span>
      <h2 class="qv-title font-serif" style="font-size: 2.2rem; text-transform: uppercase;">OUD ROYAL</h2>
      <p class="qv-price" style="font-size: 1.2rem; font-weight: 500;">₹14,500</p>

      <p class="qv-description text-soft" style="font-size: 0.85rem; line-height: 1.6;">
        A rare, resinous composition built around aged Cambodian oud, crushed pink pepper, wild black rose, and dark leather. Compounded at an unprecedented 35% oil concentration.
      </p>

      <div>
        <label class="editorial-label" style="margin-bottom: 8px; display: block;">SELECT VOLUME</label>
        <div style="display: flex; gap: 12px;">
          <button class="btn-secondary" style="padding: 10px 18px; font-size: 0.7rem;">30 ML</button>
          <button class="btn-primary" style="padding: 10px 18px; font-size: 0.7rem;">50 ML</button>
          <button class="btn-secondary" style="padding: 10px 18px; font-size: 0.7rem;">100 ML</button>
        </div>
      </div>

      <div style="margin-top: 12px;">
        <button class="btn-primary js-add-to-cart" style="width: 100%; justify-content: center;">
          <span>ADD TO BAG</span>
          <span class="btn-arrow">→</span>
        </button>
      </div>
    </div>
  </div>
</div>
