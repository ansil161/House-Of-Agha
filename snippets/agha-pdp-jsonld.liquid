{% comment %}
  AGHA PDP — Product structured data (schema.org/Product), built only from live Shopify data.
  Optional pieces (sku, gtin, images, aggregateRating) are written only when the data exists.
{% endcomment %}
{%- liquid
  assign ld_variant = product.selected_or_first_available_variant
  assign ld_rating = product.metafields.reviews.rating.value
  assign ld_count = product.metafields.reviews.rating_count.value | default: 0
  assign ld_desc = product.description | strip_html | strip_newlines | strip
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  "description": {{ ld_desc | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} }
  {%- if ld_variant.sku != blank -%}, "sku": {{ ld_variant.sku | json }}{%- endif -%}
  {%- if ld_variant.barcode != blank -%}, "gtin": {{ ld_variant.barcode | json }}{%- endif -%}
  {%- if product.images.size > 0 -%}
  , "image": [
    {%- for image in product.images limit: 8 -%}
      {{ image | image_url: width: 1800 | json }}{% unless forloop.last %}, {% endunless %}
    {%- endfor -%}
  ]
  {%- endif -%}
  , "offers": [
    {%- for v in product.variants -%}
    {
      "@type": "Offer",
      "url": {{ shop.url | append: v.url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ v.price | divided_by: 100.0 | round: 2 }},
      "availability": {% if v.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
      "itemCondition": "https://schema.org/NewCondition"
      {%- if v.sku != blank -%}, "sku": {{ v.sku | json }}{%- endif -%}
    }{% unless forloop.last %}, {% endunless %}
    {%- endfor -%}
  ]
  {%- if ld_rating != blank and ld_count > 0 -%}
  , "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ ld_rating.rating | round: 1 }},
    "bestRating": {{ ld_rating.scale_max }},
    "ratingCount": {{ ld_count }}
  }
  {%- endif -%}
}
</script>
