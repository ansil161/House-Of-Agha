<!-- Slide-out Bag Drawer · filled by AghaStore.updateCartUI (theme.js) -->
<div class="cart-drawer-overlay js-cart-close"></div>

<aside class="cart-drawer" role="dialog" aria-modal="true" aria-label="Your bag">
  <div class="cart-drawer-header">
    <div class="cart-drawer-heading">
      <span class="editorial-label">YOUR SELECTION</span>
      <h3 class="cart-drawer-title">Your bag <span class="cart-drawer-count" data-cart-count-label></span></h3>
    </div>
    <button type="button" class="cart-drawer-close js-cart-close" aria-label="Close bag">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div class="cart-drawer-body">
    <!-- Populated dynamically via theme.js -->
  </div>

  <div class="cart-drawer-footer">
    <dl class="cart-summary">
      <div class="cart-summary__row cart-summary__row--save" data-cart-save hidden>
        <dt>You save</dt>
        <dd class="cart-save-amount"></dd>
      </div>
      <div class="cart-summary__row">
        <dt>Shipping</dt>
        <dd>Complimentary</dd>
      </div>
      <div class="cart-summary__row cart-summary__row--total">
        <dt>Subtotal</dt>
        <dd class="cart-total-price">₹0</dd>
      </div>
    </dl>
    <a class="cart-checkout" href="/checkout" data-cart-checkout>
      <span>Checkout</span>
      <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <button type="button" class="cart-continue js-cart-close">Continue shopping</button>
  </div>
</aside>
