<!-- Slide-out Bag Drawer · filled by AghaStore.updateCartUI (theme.js) -->
<div class="cart-drawer-overlay js-cart-close"></div>

<aside class="cart-drawer" data-lenis-prevent role="dialog" aria-modal="true" aria-label="Your bag">
  <div class="cart-drawer-header">
    <div class="cart-drawer-heading">
      <span class="editorial-label">YOUR SELECTION</span>
      <h3 class="cart-drawer-title">Your bag <span class="cart-drawer-count" data-cart-count-label></span></h3>
    </div>
    <button type="button" class="cart-drawer-close js-cart-close" aria-label="Close bag">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
  </div>

  <!-- Lines + coupon + summary scroll together; the pay bar below stays pinned -->
  <div class="cart-drawer-scroll">
  <div class="cart-drawer-body">
    <!-- Populated dynamically: theme.js (AghaStore) → assets/hoa-commerce.js (HOA.renderBag) -->
  </div>

  <div class="cart-drawer-footer">
    <!-- Coupon field, price summary and reassurance are painted by assets/hoa-commerce.js -->
    <div class="bag-coupon" data-bag-coupon></div>
    <dl class="cart-summary"></dl>
    <button type="button" class="cart-continue js-cart-close">Continue shopping</button>
    <div class="bag-badges">
      <ul class="bag-badges__row">
        <li class="bag-badge">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/><path d="M12 14.5v2.5"/></svg>
          <span>Secure<br>payments</span>
        </li>
        <li class="bag-badge">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4.5v4h4"/><path d="M12 8v4l2.5 1.8"/></svg>
          <span>7-day<br>returns</span>
        </li>
        <li class="bag-badge">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.1 1.6 2.6-.2.9 2.5 2.2 1.4-.8 2.5.8 2.5-2.2 1.4-.9 2.5-2.6-.2L12 18.6l-2.1-1.6-2.6.2-.9-2.5-2.2-1.4.8-2.5-.8-2.5 2.2-1.4.9-2.5 2.6.2z"/><path d="M9.2 10.9l1.9 1.9 3.8-3.8"/></svg>
          <span>100%<br>authentic</span>
        </li>
        <li class="bag-badge">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 7h11v9h-11z"/><path d="M13.5 10h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
          <span>Pan-India<br>delivery</span>
        </li>
      </ul>
      <p class="bag-badges__pay"><span class="bag-badges__pay-label">We accept</span>{%- render 'hoa-pay-icons', class: 'bag-pay' -%}
      </p>
    </div>
  </div>
  </div>

  <!-- Always-visible pay bar: total painted by assets/hoa-commerce.js -->
  <div class="bag-paybar" data-bag-paybar hidden>
    <section class="bag-deals" data-bag-offers hidden></section>
    <p class="bag-prepaid" data-bag-prepaid hidden></p>
    <div class="bag-paybar__row">
      <div class="bag-paybar__total" data-bag-paybar-total></div>
      <a class="cart-checkout" href="/checkout" data-cart-checkout>
        <span>Checkout</span>
        <span class="cart-checkout__pay" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#fff"/><text x="12" y="14.6" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="5.6" font-weight="700" letter-spacing="-.2" fill="#012b72">pay<tspan fill="#00b9f1">tm</tspan></text></svg><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#5f259f"/><text x="12" y="16.4" text-anchor="middle" font-family="Nirmala UI,Mangal,Arial,sans-serif" font-size="12" font-weight="700" fill="#fff">पे</text></svg><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#fff"/><path d="M17.6 12.2c0-.4 0-.8-.1-1.2H12v2.3h3.1a2.7 2.7 0 0 1-1.2 1.8v1.5h1.9c1.1-1 1.8-2.6 1.8-4.4z" fill="#4285f4"/><path d="M12 17.8c1.6 0 2.9-.5 3.8-1.4l-1.9-1.5c-.5.4-1.2.6-1.9.6-1.5 0-2.8-1-3.2-2.4h-2v1.5A5.8 5.8 0 0 0 12 17.8z" fill="#34a853"/><path d="M8.8 13.1a3.4 3.4 0 0 1 0-2.2V9.4h-2a5.8 5.8 0 0 0 0 5.2l2-1.5z" fill="#fbbc04"/><path d="M12 8.5c.8 0 1.6.3 2.2.8l1.6-1.6A5.8 5.8 0 0 0 6.8 9.4l2 1.5c.4-1.4 1.7-2.4 3.2-2.4z" fill="#ea4335"/></svg></span>
        <svg class="cart-checkout__chev" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</aside>
