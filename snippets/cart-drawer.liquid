<!-- Slide-out Cart Drawer -->
<div class="cart-drawer-overlay js-cart-close"></div>

<div class="cart-drawer">
  <div class="cart-drawer-header">
    <span class="editorial-label">YOUR SELECTION</span>
    <h3 style="font-family: var(--font-serif); font-size: 1.4rem;">FRAGRANCE BAG</h3>
    <button class="js-cart-close" style="background: none; border: none; color: var(--color-white); font-size: 1.5rem; cursor: pointer;">&times;</button>
  </div>

  <div class="cart-drawer-body">
    <!-- Populated dynamically via theme.js -->
  </div>

  <div class="cart-drawer-footer">
    <div style="border-top: 1px solid var(--color-border); padding-top: 16px; margin-bottom: 16px;">
      <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--color-muted); margin-bottom: 6px;">
        <span>COMPLIMENTARY SHIPPING</span>
        <span style="color: var(--color-white);">ELIGIBLE</span>
      </div>
      <div style="display: flex; justify-content: space-between; font-size: 1.1rem; font-family: var(--font-serif);">
        <span>ESTIMATED TOTAL</span>
        <span class="cart-total-price">₹14,500</span>
      </div>
    </div>

    <button class="btn-primary" style="width: 100%; justify-content: center;">
      <span>PROCEED TO CHECKOUT</span>
      <span class="btn-arrow">→</span>
    </button>
  </div>
</div>
