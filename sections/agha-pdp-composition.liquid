{% comment %}
  AGHA PDP — 03 FRAGRANCE NOTES COLLAGE
  Top / heart / base tiles around the product image. Notes come from the product metafields
  custom.top_notes / custom.heart_notes / custom.base_notes (comma separated); the key-material
  tile from custom.key_material_name / custom.key_material_text. Tiles without data are omitted.
{% endcomment %}
{%- capture pdp_json -%}{%- render 'agha-pdp-data' -%}{%- endcapture -%}
{%- assign pdp = pdp_json | parse_json -%}
{%- liquid
  assign top = pdp.top_notes
  assign heart = pdp.heart_notes
  assign base = pdp.base_notes
  assign key_name = pdp.key_material_name
  assign key_text = pdp.key_material_text
  assign image = section.settings.image | default: product.featured_image
  assign family = pdp.family
-%}

{%- if top != blank or heart != blank or base != blank -%}
<section class="pdp pdp-section pdp-notes" data-pdp-notes>
  <div class="container">
    <header class="pdp-heading" data-pdp-reveal>
      <span class="pdp-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
    </header>

    <div class="pdp-collage">
      {%- if top != blank -%}
        <div class="pdp-tile-note pdp-tile-note--top" data-pdp-card>
          <div class="pdp-tile-note__head"><span class="pdp-chip">Top note</span><span class="pdp-tile-note__time">{{ section.settings.top_window }}</span></div>
          <p class="pdp-tile-note__notes">{%- assign list = top | split: ',' -%}{%- for n in list -%}<span class="pdp-tile-note__note">{{ n | strip }}</span>{%- endfor -%}</p>
        </div>
      {%- endif -%}
      {%- if heart != blank -%}
        <div class="pdp-tile-note pdp-tile-note--heart" data-pdp-card>
          <div class="pdp-tile-note__head"><span class="pdp-chip">Heart note</span><span class="pdp-tile-note__time">{{ section.settings.heart_window }}</span></div>
          <p class="pdp-tile-note__notes">{%- assign list = heart | split: ',' -%}{%- for n in list -%}<span class="pdp-tile-note__note">{{ n | strip }}</span>{%- endfor -%}</p>
        </div>
      {%- endif -%}

      <div class="pdp-collage__bottle" data-pdp-card>
        {%- if image -%}
          {%- assign image_alt = image.alt | default: product.title -%}
          {{ image | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 1101px) 36vw, 100vw', loading: 'lazy', alt: image_alt }}
        {%- endif -%}
        <div class="pdp-collage__caption"><b>{{ product.title }}</b>{%- if family != blank -%}<span>{{ family }}</span>{%- endif -%}</div>
      </div>

      {%- if base != blank -%}
        <div class="pdp-tile-note pdp-tile-note--base{% if key_name == blank %} pdp-tile-note--tall{% endif %}" data-pdp-card>
          <div class="pdp-tile-note__head"><span class="pdp-chip">Base note</span><span class="pdp-tile-note__time">{{ section.settings.base_window }}</span></div>
          <p class="pdp-tile-note__notes">{%- assign list = base | split: ',' -%}{%- for n in list -%}<span class="pdp-tile-note__note">{{ n | strip }}</span>{%- endfor -%}</p>
        </div>
      {%- endif -%}
      {%- if key_name != blank -%}
        <div class="pdp-tile-note pdp-tile-note--key" data-pdp-card>
          <div class="pdp-tile-note__head"><span class="pdp-chip">Key material</span></div>
          <div>
            <p class="pdp-tile-note__name">{{ key_name }}</p>
            {%- if key_text != blank -%}<p class="pdp-tile-note__text" style="margin-top: 10px;">{{ key_text }}</p>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Agha PDP · Notes collage",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The composition" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fragrance notes" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Three movements, from the first spray to the trail that stays on wool the next morning." },
    { "type": "image_picker", "id": "image", "label": "Centre image", "info": "Defaults to the product's featured image." },
    { "type": "text", "id": "top_window", "label": "Top notes window", "default": "First 30 minutes" },
    { "type": "text", "id": "heart_window", "label": "Heart notes window", "default": "30 min – 4 hours" },
    { "type": "text", "id": "base_window", "label": "Base notes window", "default": "4 – 14+ hours" }
  ]
}
{% endschema %}
