                </span>
                {%- if b.kicker != blank -%}<span class="hoa-ab-hyd__kicker">{{ b.kicker }}</span>{%- endif -%}
                <b>{{ b.title }}</b>
                {%- if b.text != blank -%}<span class="hoa-ab-hyd__note-text">{{ b.text }}</span>{%- endif -%}
              </li>
            {%- endfor -%}
