{% schema %}
{
  "name": "About: Hyderabad",
  "tag": "div",
  "class": "hoa-ab-section",
  "settings": [
    { "type": "text", "id": "chip", "label": "Label", "default": "Composed in Hyderabad" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A city that has always worn its fragrance." },
    { "type": "text", "id": "heading_muted", "label": "Heading, muted part", "default": "Ours begins there." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "House of Agha is composed in Hyderabad, the city Muhammad Quli Qutb Shah built around the Charminar in 1591, and known ever since for its courts, its pearls and the attar sellers of the old city. Its arches and lattices are the lines you see across this page." },
    { "type": "text", "id": "urdu", "label": "City name in Urdu (decorative)", "default": "حیدرآباد", "info": "Drawn large and faint behind the illustration. Leave empty to hide." },
    { "type": "text", "id": "caption", "label": "Illustration caption", "default": "Charminar · 1591" }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Heritage note",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "arch", "options": [
          { "value": "arch", "label": "Qutb Shahi arch" },
          { "value": "attar", "label": "Attar vial" },
          { "value": "pearl", "label": "Pearl" },
          { "value": "jaali", "label": "Jaali" }
        ] },
        { "type": "text", "id": "kicker", "label": "Small label" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "About: Hyderabad" }]
}
{% endschema %}
