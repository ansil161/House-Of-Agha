{% comment %}
  AGHA GIFTS HERO SECTION
{% endcomment %}

<section class="section-padding border-bottom-thin" style="padding-top: 160px; padding-bottom: var(--space-2xl);">
  <div class="container">
    <div class="grid-asymmetric-left gsap-reveal">
      <div>
        <span class="editorial-label">01 — BESPOKE CONCIERGE</span>
        <h1 class="headline-hero font-serif" style="margin-top: 16px;">
          GIVE SOMETHING<br>
          THEY WILL REMEMBER.
        </h1>
        <p class="text-soft" style="margin-top: 24px; max-width: 520px; font-size: 1.05rem; line-height: 1.8;">
          An AGHA flacon is an indelible gesture of esteem. Each gift is presented in matte black hardboard packaging, lined with black velvet, tied with silk ribbon, and accompanied by a hand-lettered personalized note.
        </p>

        <div style="margin-top: 36px;">
          <a href="#gift-concierge" class="btn-primary">
            <span>START GIFT CONCIERGE</span>
            <span class="btn-arrow">→</span>
          </a>
        </div>
      </div>

      <div class="gsap-clip-reveal" style="aspect-ratio: 4/3; overflow: hidden; border: 1px solid var(--color-border); position: relative;">
        <img src="{{ 'discovery_box.jpg' | asset_url }}" alt="Bespoke Gift Wrapping" style="width: 100%; height: 100%; object-fit: cover;">
        <div style="position: absolute; bottom: 20px; right: 20px; background: rgba(8,8,8,0.85); padding: 6px 14px; border: 1px solid var(--color-border); font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;">
          HAND-FINISHED IN PARIS
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Agha Gifts Hero",
  "settings": []
}
{% endschema %}
