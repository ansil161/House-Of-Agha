{% comment %}
  SHOP · Page head
  Full-bleed campaign photo (Oud Fury in embers by default). On desktop the photo is pushed
  right so the bottle sits clear of the copy and the left side falls into espresso black.
  Left: pill eyebrow, sans + italic serif title with the live count, copy, pill CTA.
  Right: a "Pictured" card for the product in the photo (from the catalogue).
  Under the buttons: the bottle line-up with count and from-price. The offer marquee runs
  directly underneath.
{% endcomment %}

{%- assign s = section.settings -%}
{%- capture catalog_json -%}{%- render 'hoa-catalog-data' -%}{%- endcapture -%}
{%- assign catalog = catalog_json | parse_json -%}
{%- assign products = catalog.products -%}
{%- assign min_price = 9999999 -%}
{%- assign featured = nil -%}
{%- for p in products -%}
  {%- assign pp = p.salePrice | default: p.regularPrice -%}
  {%- if pp < min_price -%}{%- assign min_price = pp -%}{%- endif -%}
  {%- if p.handle == s.feature_handle -%}{%- assign featured = p -%}{%- endif -%}
{%- endfor -%}

<section class="hoa-shop-head">
  <div class="hoa-shop-head__bg" aria-hidden="true">
    <picture class="hoa-shop-head__media">
      {%- if s.image_mobile != blank -%}
        <source media="(max-width: 767px)" srcset="{{ s.image_mobile | image_url: width: 1200 }}">
      {%- else -%}
        <source media="(max-width: 767px)" srcset="{{ 'hoa-craft-charcoal-sm.webp' | asset_url }} 700w, {{ 'hoa-craft-charcoal.webp' | asset_url }} 1200w" sizes="100vw">
      {%- endif -%}
      {%- if s.image != blank -%}
        <img src="{{ s.image | image_url: width: 2400 }}" alt="" width="2000" height="1125" fetchpriority="high" decoding="async">
      {%- else -%}
        <img src="{{ 'hoa-craft-embers.webp' | asset_url }}" srcset="{{ 'hoa-craft-embers-sm.webp' | asset_url }} 1000w, {{ 'hoa-craft-embers.webp' | asset_url }} 2000w" sizes="120vw" alt="" width="2000" height="1125" fetchpriority="high" decoding="async">
      {%- endif -%}
    </picture>
    <span class="hoa-shop-head__veil"></span>
    <span class="hoa-shop-head__grain"></span>
  </div>

  <div class="hoa-wrap hoa-shop-head__inner">
    <div class="hoa-shop-head__copy">
      {%- if s.kicker != blank -%}
        <p class="hoa-shop-head__pill hoa-shop-head__in" style="--d:1"><span class="hoa-shop-head__pill-dot" aria-hidden="true"></span>{{ s.kicker }}</p>
      {%- endif -%}
      <h1 class="hoa-shop-head__title">
        <span class="hoa-shop-head__line hoa-shop-head__in" style="--d:2">{{ s.heading }}</span>
        {%- if s.heading_accent != blank %} <span class="hoa-shop-head__line hoa-shop-head__line--serif hoa-shop-head__in" style="--d:3"><em>{{ s.heading_accent }}</em><sup class="hoa-shop-head__count" data-hoa-total></sup></span>{%- endif -%}
      </h1>
      {%- if s.text != blank -%}<p class="hoa-shop-head__text hoa-shop-head__in" style="--d:4">{{ s.text }}</p>{%- endif -%}
      <div class="hoa-shop-head__actions hoa-shop-head__in" style="--d:5">
        <a class="hoa-shop-head__cta" href="#catalog">
          <span>{{ s.cta_label }}</span>
          <span class="hoa-shop-head__cta-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M6.5 13.5 12 19l5.5-5.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        {%- if s.link_1_label != blank -%}
          <a class="hoa-shop-head__ghost" href="{{ s.link_1_url | default: '/pages/the-house' }}">{{ s.link_1_label }}</a>
        {%- endif -%}
      </div>
      <div class="hoa-shop-head__lineup hoa-shop-head__in" style="--d:6">
        <ul aria-hidden="true">
          {%- for p in products limit: 7 -%}
            <li style="--i:{{ forloop.index0 }}"><img src="{{ p.image }}" alt="" width="60" height="75" decoding="async"></li>
          {%- endfor -%}
        </ul>
        <p><b>{{ products.size }} Eau de Parfum</b><span>from &#8377;{% if min_price >= 1000 %}{{ min_price | divided_by: 1000 | floor }},{{ min_price | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3 }}{% else %}{{ min_price }}{% endif %}</span></p>
      </div>
    </div>

    {%- if featured -%}
      {%- assign f_price = featured.salePrice | default: featured.regularPrice -%}
      <a class="hoa-shop-head__pictured hoa-shop-head__in" style="--d:7" href="/products/{{ featured.handle }}">
        <span class="hoa-shop-head__pictured-core">
          <span class="hoa-shop-head__pictured-img"><img src="{{ featured.image }}" alt="" width="120" height="150" decoding="async"></span>
          <span class="hoa-shop-head__pictured-txt">
            <small>{{ s.feature_kicker }}</small>
            <b>{{ featured.name }}</b>
            <span>{{ featured.family }} &middot; &#8377;{% if f_price >= 1000 %}{{ f_price | divided_by: 1000 | floor }},{{ f_price | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3 }}{% else %}{{ f_price }}{% endif %}</span>
          </span>
          <span class="hoa-shop-head__pictured-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M7.5 16.5 16.5 7.5M9.5 7.5h7v7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </span>
      </a>
    {%- endif -%}

  </div>

  {%- assign tiers = catalog.settings.quantityTiers -%}
  {%- assign coupon = catalog.coupons | first -%}
  {%- capture offer_items -%}
    <li class="hoa-offer-slide"><span class="hoa-offer-slide__ico"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="7" cy="17" r="1.8" stroke="currentColor" stroke-width="1.5"/><circle cx="17" cy="17" r="1.8" stroke="currentColor" stroke-width="1.5"/></svg></span><span class="hoa-offer-slide__txt"><b>Complimentary shipping</b><span>on orders above &#8377;{{ catalog.settings.freeShippingThreshold | divided_by: 1000 }},{{ catalog.settings.freeShippingThreshold | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3 }}</span></span></li>
    {%- for t in tiers -%}
      <li class="hoa-offer-slide"><span class="hoa-offer-slide__ico"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 5l14 14M7 8.5a1.7 1.7 0 1 0 0-.01M17 18a1.7 1.7 0 1 0 0-.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span><span class="hoa-offer-slide__txt"><b>Save {{ t.percent }}%</b><span>when you buy {{ t.qty }} fragrances</span></span></li>
    {%- endfor -%}
    {%- if coupon -%}
      <li class="hoa-offer-slide"><span class="hoa-offer-slide__ico"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.5 9V6.5h17V9a2.5 2.5 0 0 0 0 5.5V17h-17v-2.5A2.5 2.5 0 0 0 3.5 9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span><span class="hoa-offer-slide__txt"><b>{{ coupon.description }}</b><span>use code <em>{{ coupon.code }}</em></span></span></li>
    {%- endif -%}
  {%- endcapture -%}
  <div class="hoa-offer-marquee" role="region" aria-label="Current offers">
    <ul class="hoa-offer-marquee__track">
      {{ offer_items }}{{ offer_items }}{{ offer_items }}{{ offer_items }}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "HOA Shop head",
  "tag": "div",
  "class": "hoa-shop-head-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (landscape)", "info": "Shifted right on desktop so the subject sits beside the copy. Defaults to Oud Fury in embers." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile background (square or portrait)" },
    { "type": "text", "id": "kicker", "label": "Eyebrow pill", "default": "The collection · Eau de Parfum" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All" },
    { "type": "text", "id": "heading_accent", "label": "Heading, italic serif line", "default": "fragrances" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Seven Eau de Parfum from House of Agha. Filter by who will wear it or by scent family." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "text", "id": "link_1_label", "label": "Secondary link", "default": "Our story" },
    { "type": "url", "id": "link_1_url", "label": "Secondary link URL", "info": "Defaults to /pages/the-house" },
    { "type": "text", "id": "feature_handle", "label": "Pictured product handle", "default": "oud-fury", "info": "The fragrance shown in the photo. Leave empty to hide the card." },
    { "type": "text", "id": "feature_kicker", "label": "Pictured card label", "default": "Pictured" }
  ],
  "presets": [{ "name": "HOA Shop head" }]
}
{% endschema %}
