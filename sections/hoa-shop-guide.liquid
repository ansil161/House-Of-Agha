{% comment %}
  SHOP · Help choosing
  Closes the shop page for anyone still undecided: a short line on the left, and two
  photo links side by side (the scent finder, gifts). Stacks on mobile.
{% endcomment %}

{%- assign s = section.settings -%}
<section class="hoa-shop-guide">
  <div class="hoa-wrap">
    <div class="hoa-shop-guide__head" data-hoa-reveal>
      <h2 class="hoa-shop-guide__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="hoa-shop-guide__text">{{ s.text }}</p>{%- endif -%}
    </div>
    <div class="hoa-shop-guide__cards">
      {%- for i in (1..2) -%}
        {%- liquid
          if i == 1
            assign label = s.card_1_label
            assign note = s.card_1_note
            assign url = s.card_1_url | default: '/pages/discover'
            assign img = s.card_1_image
            assign asset = s.card_1_asset
            assign alt = s.card_1_alt
            assign pos = '50% 40%'
          else
            assign label = s.card_2_label
            assign note = s.card_2_note
            assign url = s.card_2_url | default: '/pages/gifts'
            assign img = s.card_2_image
            assign asset = s.card_2_asset
            assign alt = s.card_2_alt
            assign pos = '50% 55%'
          endif
        -%}
        {%- if label != blank -%}
          <a class="hoa-shop-guide__card" href="{{ url }}" data-hoa-reveal>
            <span class="hoa-shop-guide__media" style="--pos: {{ pos }};">
              {%- render 'hoa-img', name: asset, image: img, w: 1200, h: 1500, alt: alt, sizes: '(min-width: 800px) 34vw, 100vw' -%}
            </span>
            <span class="hoa-shop-guide__row">
              <span class="hoa-shop-guide__label">{{ label }}</span>
              <span class="hoa-shop-guide__arrow" aria-hidden="true">&rarr;</span>
            </span>
            {%- if note != blank -%}<span class="hoa-shop-guide__note">{{ note }}</span>{%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HOA Shop help choosing",
  "tag": "div",
  "class": "hoa-shop-guide-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure yet?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Two ways to narrow it down." },
    { "type": "header", "content": "First card" },
    { "type": "text", "id": "card_1_label", "label": "Label", "default": "Find your scent" },
    { "type": "text", "id": "card_1_note", "label": "Note", "default": "A few questions about the places and moods you love." },
    { "type": "url", "id": "card_1_url", "label": "Link" },
    { "type": "image_picker", "id": "card_1_image", "label": "Image" },
    { "type": "text", "id": "card_1_asset", "label": "Theme asset", "default": "hoa-world-hand" },
    { "type": "text", "id": "card_1_alt", "label": "Alt text", "default": "A hand holding Oud of Dark Paradise" },
    { "type": "header", "content": "Second card" },
    { "type": "text", "id": "card_2_label", "label": "Label", "default": "Gifts" },
    { "type": "text", "id": "card_2_note", "label": "Note", "default": "Shopping for someone else." },
    { "type": "url", "id": "card_2_url", "label": "Link" },
    { "type": "image_picker", "id": "card_2_image", "label": "Image" },
    { "type": "text", "id": "card_2_asset", "label": "Theme asset", "default": "hoa-world-gift" },
    { "type": "text", "id": "card_2_alt", "label": "Alt text", "default": "Agha Blue in its open gift box among peonies" }
  ],
  "presets": [{ "name": "HOA Shop help choosing" }]
}
{% endschema %}
