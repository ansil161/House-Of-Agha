{%- comment -%}
  House of Agha · About 02 · Heritage card collection (redesigned 2026-10-06 to the client's
  "Heritage Fragrance Card Collection" reference).
  Warm parchment ground. Left: THE HOUSE, "Welcome to House of Agha.", two hairline dividers
  and the heritage copy. Right: five tall portrait cards (Qutub, Roses, Vetiver, Ambergris, Oudh)
  standing as one staggered collection in front of a soft Charminar arch, a faint orbit line
  with one node passing behind them. Foot: OUR HERITAGE, a long hairline and the closing line.
  Desktop composition is drawn on the reference's 1536px canvas in container units (hoa-about.css,
  block "HERITAGE CARD COLLECTION"); tablet keeps the stage, phones scroll the cards sideways.
  Motion: assets/hoa-about.js, block "Heritage card collection" (static and complete without it).

  Photos: Unsplash License (free commercial use):
    hoa-hc-qutub      Golconda Fort at golden hour   photo-1470075446540-4391a96ec621
    hoa-hc-rose       red rose                       photo-1559563362-c667ba5f5480
    hoa-hc-vetiver    hanging roots                  photo-1692148292961-210789f8d8c0
    hoa-hc-oud        agarwood pieces                photo-1736098687867-3ec9f69aff2e
    hoa-hc-charminar-front  Charminar, sky keyed out, sepia  photo-1696941515998-d83f24967aca
    hoa-hc-ambergris  = hoa-ing-ambergris (Unsplash photo-1613825432127)
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="hoa-hc" data-hoa-hc aria-labelledby="hoa-hc-title-{{ section.id }}">
  <div class="hoa-hc__canvas">

    <div class="hoa-hc__copy">
      {%- if s.kicker != blank -%}<p class="hoa-hc__kicker" data-hoa-hc-in>{{ s.kicker }}</p>{%- endif -%}
      <h2 class="hoa-hc__title" id="hoa-hc-title-{{ section.id }}" data-hoa-hc-in>
        {%- if s.title_1 != blank -%}<span>{{ s.title_1 }}</span>{%- endif -%}
        {%- if s.title_2 != blank -%} <span>{{ s.title_2 }}</span>{%- endif -%}
      </h2>
      <span class="hoa-hc__rule" aria-hidden="true" data-hoa-hc-rule></span>
      {%- if s.text != blank -%}<p class="hoa-hc__text" data-hoa-hc-in>{{ s.text | newline_to_br }}</p>{%- endif -%}
      <span class="hoa-hc__rule hoa-hc__rule--2" aria-hidden="true" data-hoa-hc-rule></span>
      {%- if s.text_2 != blank -%}<p class="hoa-hc__text-2" data-hoa-hc-in>{{ s.text_2 | newline_to_br }}</p>{%- endif -%}
      {%- comment -%} The Qutub Shahi miniature at the foot of the left column (client, 2026-10-06); enlarged into the second paragraph's space 2026-10-07 {%- endcomment -%}
      {%- if s.mini_asset != blank or s.mini_image != blank -%}
        <figure class="hoa-hc__mini" data-hoa-hc-in>
          <span class="hoa-hc__mini-frame">
            <span class="hoa-hc__mini-img">
              {%- if s.mini_image != blank -%}
                {{ s.mini_image | image_url: width: 500 | image_tag: widths: '300, 500', sizes: '360px', loading: 'lazy', alt: s.mini_alt }}
              {%- else -%}
                <img src="{{ s.mini_asset | append: '-sm.webp' | asset_url }}" srcset="{{ s.mini_asset | append: '-sm.webp' | asset_url }} 400w, {{ s.mini_asset | append: '.webp' | asset_url }} 654w" sizes="360px" width="654" height="686" alt="{{ s.mini_alt | escape }}" loading="lazy" decoding="async">
              {%- endif -%}
            </span>
          </span>
          {%- if s.mini_caption != blank -%}<figcaption class="hoa-hc__mini-cap">{{ s.mini_caption }}</figcaption>{%- endif -%}
        </figure>
      {%- endif -%}
    </div>

    {%- comment -%} Off on About since 2026-10-07 (both settings blank): no label, line or story text. {%- endcomment -%}
    {%- if s.scroll_label != blank or s.lede != blank -%}
    <p class="hoa-hc__lede" data-hoa-hc-in>
      <span class="hoa-hc__lede-mark" aria-hidden="true"></span>
      {%- if s.scroll_label != blank -%}<span class="hoa-hc__scroll">{{ s.scroll_label }}</span>{%- endif -%}
      {%- if s.lede != blank -%}<span class="hoa-hc__lede-text">{{ s.lede | newline_to_br }}</span>{%- endif -%}
    </p>
    {%- endif -%}

    <div class="hoa-hc__stage">
      {%- comment -%} Orbit, traced from the reference (stage px = reference px - 478 / - 300): a small loop
        out of Qutub's left edge round the node, an arc rising from behind Qutub to the moon's left
        edge, and an arc from the monument's right side down to Oudh's top; it runs behind the
        Charminar and the cards. {%- endcomment -%}
      <svg class="hoa-hc__orbit" viewBox="0 0 1002 560" aria-hidden="true" focusable="false">
        <path data-hoa-hc-orbit pathLength="1" d="M24 245C8 262 0 288 1 310C2 330 10 342 24 334M150 152C200 120 244 100 300 82C390 52 560 46 640 72C740 84 860 102 917 126C940 138 956 156 966 176"/>
        <circle class="hoa-hc__node" data-hoa-hc-node cx="1" cy="310" r="4.5"/>
      </svg>
      {%- if s.arch_asset != blank or s.arch_image != blank -%}
        <div class="hoa-hc__arch" aria-hidden="true" data-hoa-hc-arch>
          <span class="hoa-hc__arch-ground"></span>
          <span class="hoa-hc__arch-photo">
            {%- if s.arch_image != blank -%}
              {{ s.arch_image | image_url: width: 1200 | image_tag: widths: '640, 1100', sizes: '(min-width: 1200px) 24vw, 40vw', loading: 'lazy', alt: '' }}
            {%- else -%}
              <img src="{{ s.arch_asset | append: '.webp' | asset_url }}" srcset="{{ s.arch_asset | append: '-sm.webp' | asset_url }} 560w, {{ s.arch_asset | append: '.webp' | asset_url }} 1140w" sizes="(min-width: 1200px) 22vw, 36vw" width="1140" height="1410" alt="" loading="lazy" decoding="async">
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}

      <ul class="hoa-hc__cards" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- capture tag -%}{% if b.url != blank %}a{% else %}div{% endif %}{%- endcapture -%}
          <li class="hoa-hc__slot" {{ block.shopify_attributes }} data-hoa-hc-card>
            <{{ tag }} class="hoa-hc-card hoa-hc-card--{{ b.tone }} hoa-hc-card--arrow-{{ b.arrow }}"{% if b.url != blank %} href="{{ b.url }}"{% endif %}>
              <span class="hoa-hc-card__media" aria-hidden="true">
                {%- if b.image != blank -%}
                  {%- assign focus_css = b.focus | default: '50% 50%' | prepend: 'object-position: ' -%}
                  {{ b.image | image_url: width: 900 | image_tag: widths: '480, 900', sizes: '(min-width: 1200px) 14vw, (min-width: 700px) 22vw, 62vw', loading: 'lazy', alt: '', style: focus_css }}
                {%- elsif b.asset != blank -%}
                  <img src="{{ b.asset | append: '.webp' | asset_url }}" srcset="{{ b.asset | append: '-sm.webp' | asset_url }} 480w, {{ b.asset | append: '.webp' | asset_url }} 800w" sizes="(min-width: 1200px) 14vw, (min-width: 700px) 22vw, 62vw" width="800" height="1200" alt="" loading="lazy" decoding="async"{% if b.focus != blank %} style="object-position: {{ b.focus }}"{% endif %}>
                {%- endif -%}
              </span>
              <span class="hoa-hc-card__body">
                <span class="hoa-hc-card__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="hoa-hc-card__title">{{ b.title }}</span>
                {%- if b.text != blank -%}<span class="hoa-hc-card__text">{{ b.text | newline_to_br }}</span>{%- endif -%}
                <span class="hoa-hc-card__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 12h10M13 8l4 4-4 4"/></svg></span>
              </span>
            </{{ tag }}>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="hoa-hc__foot">
      {%- if s.foot_label != blank -%}<p class="hoa-hc__foot-label" data-hoa-hc-in>{{ s.foot_label }}</p>{%- endif -%}
      <span class="hoa-hc__foot-line" aria-hidden="true" data-hoa-hc-line></span>
      {%- if s.foot_text != blank -%}<p class="hoa-hc__foot-text" data-hoa-hc-in>{{ s.foot_text | newline_to_br }}</p>{%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "About: heritage cards",
  "tag": "div",
  "class": "hoa-ab-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "The House"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Heading line 1",
      "default": "Welcome to"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Heading line 2",
      "default": "House of Agha."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Heritage paragraph (line breaks kept on desktop)",
      "default": "Rooted in the rich heritage of the Qutub Shahi dynasty,\nwe celebrate the art of fine perfumery inspired by the grandeur\nof Golconda and Hyderabad’s golden era. Drawing from\nthe royal legacy of aromatic indulgence, we craft fragrances\nthat embody the sophistication and luxury once cherished\nby the Persian, Turkish rulers."
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Second paragraph",
      "default": "With honor the ancient craft of attar making, blending the finest\nnatural ingredients into scents of timeless luxury. Each bottle\nis a tribute to the refinement and cultural richness that defined\nthe Qutub Shahi era."
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Top-right label",
      "default": "Scroll to explore"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Story line (top right)",
      "default": "Every fragrance tells a story:\nof bustling royal courts, serene palace gardens\nand the intoxicating allure of tradition."
    },
    {
      "type": "header",
      "content": "Charminar arch (behind the cards)"
    },
    {
      "type": "image_picker",
      "id": "arch_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "arch_asset",
      "label": "Fallback theme asset",
      "default": "hoa-hc-charminar-front",
      "info": "Cut-out (transparent sky) so the minarets rise past the arch"
    },
    {
      "type": "header",
      "content": "Qutub Shahi miniature (left, under the copy)"
    },
    {
      "type": "image_picker",
      "id": "mini_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "mini_asset",
      "label": "Fallback theme asset",
      "default": "hoa-qutub-shah"
    },
    {
      "type": "text",
      "id": "mini_alt",
      "label": "Alt text",
      "default": "Miniature portrait of a Qutub Shahi ruler in a jewelled turban, holding a rose"
    },
    {
      "type": "text",
      "id": "mini_caption",
      "label": "Caption",
      "default": "A Qutub Shahi miniature"
    },
    {
      "type": "header",
      "content": "Foot"
    },
    {
      "type": "text",
      "id": "foot_label",
      "label": "Label",
      "default": "Our Heritage"
    },
    {
      "type": "textarea",
      "id": "foot_text",
      "label": "Text",
      "default": "Our passion lies in bridging history and modernity,\ndeeply rooted in the past, our fragrances are made\nfor today’s connoisseurs — an elegant fusion of heritage\nand contemporary sophistication."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Qutub"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text (line breaks kept)",
          "default": "The royal roots\nof a timeless\njourney."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Fallback theme asset",
          "default": "hoa-hc-qutub"
        },
        {
          "type": "text",
          "id": "focus",
          "label": "Image focus (object-position)",
          "default": "50% 50%"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Image tone",
          "default": "dark",
          "options": [
            {
              "value": "dark",
              "label": "Dark image, light text"
            },
            {
              "value": "light",
              "label": "Light image, dark text"
            }
          ]
        },
        {
          "type": "select",
          "id": "arrow",
          "label": "Arrow",
          "default": "foot",
          "options": [
            {
              "value": "text",
              "label": "Under the text"
            },
            {
              "value": "foot",
              "label": "At the bottom"
            }
          ]
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About: heritage cards"
    }
  ]
}
{% endschema %}
