{%- comment -%}
  House of Agha · About 02 · The story, in the house's own words
  Editorial layout under a gold divider: the large line runs across the top as a statement;
  below it the Qutb Shahi miniature in a pointed arch with an antique-gold hairline (left)
  balances the story paragraphs and the four natural ingredients (right).
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="hoa-ab-chapter">
  {%- render 'hoa-ab-rule' -%}
  <div class="hoa-wrap hoa-ab-chapter__grid">
    <p class="hoa-ab-chapter__lede" data-hoa-ab-lede>{{ s.lede }}</p>
    {%- if s.portrait_asset != blank or s.portrait_image != blank -%}
      <figure class="hoa-ab-chapter__portrait">
        {%- comment -%} A manuscript plate: faint jaali ground, Golconda corners, the arch on it {%- endcomment -%}
        <div class="hoa-ab-chapter__plate">
          <span class="hoa-ab-corners" aria-hidden="true" data-hoa-ab-orn></span>
          <div class="hoa-ab-arch hoa-ab-chapter__arch">
            <div class="hoa-ab-arch__frame hoa-ab-chapter__img" data-hoa-ab-img>
              {%- render 'hoa-img', name: s.portrait_asset, image: s.portrait_image, w: 654, h: 686, alt: s.portrait_alt, sizes: '(min-width: 900px) 30vw, 80vw' -%}
            </div>
            {%- render 'hoa-ab-arch' -%}
          </div>
        </div>
        {%- if s.portrait_caption != blank -%}<figcaption class="hoa-ab-caption">{{ s.portrait_caption }}</figcaption>{%- endif -%}
      </figure>
    {%- endif -%}
    <div class="hoa-ab-chapter__body">
      {%- if s.p1 != blank -%}<p class="hoa-ab-chapter__p hoa-ab-chapter__p--first" data-hoa-ab-up>{{ s.p1 }}</p>{%- endif -%}
      {%- if s.p2 != blank -%}<p class="hoa-ab-chapter__p" data-hoa-ab-up>{{ s.p2 }}</p>{%- endif -%}
      {%- comment -%} The four ingredients as specimen niches: a Qutb Shahi arch with a jaali head, a medallion with the ingredient drawn in line, number, name, botanical name, on a double-rule plinth {%- endcomment -%}
      {%- assign notes = s.ingredients | split: ',' -%}
      {%- assign latin = s.ingredients_latin | split: ',' -%}
      {%- if notes.size > 0 -%}
        <ul class="hoa-ab-specimens" aria-label="{{ s.ingredients_label | escape }}" data-hoa-ab-up>
          {%- for n in notes -%}
            {%- assign l = latin[forloop.index0] | strip -%}
            {%- assign nh = n | strip | handleize -%}
            <li class="hoa-ab-specimen">
              <svg class="hoa-ab-specimen__arch" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 100V22C0 10 26 4 50 0C74 4 100 10 100 22V100" vector-effect="non-scaling-stroke"/></svg>
              <span class="hoa-ab-specimen__medal" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
                  {%- case nh -%}
                    {%- when 'oud', 'agarwood' -%}<path d="M5 17.5c1.8-6.2 6-10.3 14-11.5-1 7.2-5.2 11.3-11.6 13.2z"/><path d="M8.2 16.4c2.2-3.2 5-5.8 8.6-7.8M10.4 18c1.6-1.8 3.2-3.1 5.2-4.2"/>
                    {%- when 'rose' -%}<path d="M12 6.5c2.6 0 4.2 1.7 4.2 3.8 0 2.7-2.5 4.6-4.2 4.6s-4.2-1.9-4.2-4.6c0-2.1 1.6-3.8 4.2-3.8z"/><path d="M10.4 9.6c.6-.9 2.6-1 3.2.2.5 1-.4 2-1.5 1.9"/><path d="M12 15v6.5M12 18.6c-2.1-.2-3.4-1.3-3.8-2.8 1.9 0 3.2.9 3.8 2.8z"/>
                    {%- when 'vetiver' -%}<path d="M12 12.5V3.5M12 12.5c-1.4-3-3.4-5-6-6.2M12 12.5c1.4-3 3.4-5 6-6.2M12 12.5c-.6-2.4-1.8-4.2-3.6-5.6M12 12.5c.6-2.4 1.8-4.2 3.6-5.6"/><path d="M5.5 12.5h13"/><path d="M12 12.5v8M12 14.8l-3 4.2M12 14.8l3 4.2M10.6 13.6l-3.2 1.8M13.4 13.6l3.2 1.8"/>
                    {%- when 'ambergris', 'amber' -%}<path d="M5 12.8c0-3.4 3-5.8 7-5.8s7 2.2 7 5.4-2.6 5.3-7 5.3-7-1.6-7-4.9z"/><path d="M9 11.2c.8-1 2-1.6 3.4-1.6"/><path d="M3 20.6c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0"/>
                    {%- else -%}<path d="M5.6 5.6h12.8v12.8H5.6z"/><path d="M12 2.9 21.1 12 12 21.1 2.9 12z"/><circle cx="12" cy="12" r="2.1"/>
                  {%- endcase -%}
                </svg>
              </span>
              <span class="hoa-ab-specimen__no" aria-hidden="true">No. {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="hoa-ab-specimen__name">{{ n | strip }}</span>
              <span class="hoa-ab-specimen__dot" aria-hidden="true"></span>
              {%- if l != blank -%}<span class="hoa-ab-specimen__latin" lang="la">{{ l }}</span>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.p3 != blank -%}<p class="hoa-ab-chapter__p" data-hoa-ab-up>{{ s.p3 }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About: story text",
  "tag": "div",
  "class": "hoa-ab-section",
  "settings": [
    { "type": "textarea", "id": "lede", "label": "Large line", "default": "Every fragrance tells a story: of bustling royal courts, serene palace gardens and the intoxicating allure of tradition." },
    { "type": "textarea", "id": "p1", "label": "Paragraph 1", "default": "Welcome to House of Agha. Rooted in the rich heritage of the Qutb Shahi dynasty, we celebrate the art of fine perfumery inspired by the grandeur of Golconda and Hyderabad's golden era. Drawing from the royal legacy of aromatic indulgence, we craft fragrances that embody the sophistication and luxury once cherished by the Persian-Turkic rulers." },
    { "type": "textarea", "id": "p2", "label": "Paragraph 2", "default": "We honour the ancient craft of attar making, blending the finest natural ingredients into scents of timeless beauty. Each bottle is a tribute to the refinement and cultural richness that defined the Qutb Shahi era." },
    { "type": "text", "id": "ingredients", "label": "Ingredients (comma separated)", "default": "Oud, Rose, Vetiver, Ambergris" },
    { "type": "text", "id": "ingredients_latin", "label": "Botanical names (comma separated, same order)", "default": "Aquilaria, Rosa damascena, Chrysopogon zizanioides, Ambra grisea" },
    { "type": "text", "id": "ingredients_label", "label": "Ingredients list name (screen readers)", "default": "Natural ingredients we blend" },
    { "type": "header", "content": "Portrait (under the large line)" },
    { "type": "image_picker", "id": "portrait_image", "label": "Image" },
    { "type": "text", "id": "portrait_asset", "label": "Fallback theme asset", "default": "hoa-qutb-shah" },
    { "type": "text", "id": "portrait_alt", "label": "Alt text", "default": "Miniature portrait of a Qutb Shahi ruler in a jewelled turban, holding a rose" },
    { "type": "text", "id": "portrait_caption", "label": "Caption", "default": "A Qutb Shahi miniature" },
    { "type": "textarea", "id": "p3", "label": "Paragraph 3", "default": "Our passion lies in bridging history and modernity. Deeply rooted in the past, our fragrances are made for today's connoisseurs: an elegant fusion of heritage and contemporary sophistication." }
  ],
  "presets": [{ "name": "About: story text" }]
}
{% endschema %}
