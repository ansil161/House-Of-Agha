{% comment %}
  AGHA HOUSE ORIGIN & TIMELINE CHAPTERS
{% endcomment %}

<section class="section-padding border-bottom-thin" id="house-timeline">
  <div class="container">
    <div style="margin-bottom: var(--space-3xl);" class="gsap-reveal">
      <span class="editorial-label">02 — CHRONICLES OF CRAFT</span>
      <h2 class="headline-section font-serif" style="margin-top: 12px;">OUR ORIGIN CHAPTERS</h2>
    </div>

    <!-- Timeline Chapters -->
    <div style="display: flex; flex-direction: column;" class="gsap-reveal">
      <!-- Chapter 01 -->
      <div class="timeline-chapter">
        <div class="chapter-number">01</div>
        <div>
          <span class="editorial-label">CHAPTER I · THE REFUSAL (2021)</span>
          <h3 class="font-serif" style="font-size: 2rem; margin-top: 8px;">REJECTING MASS DILUTION</h3>
          <p class="text-soft" style="font-size: 0.95rem; line-height: 1.7; margin-top: 12px;">
            In an industry where 85% of bottle cost is spent on marketing campaigns and 12% alcohol solutions, AGHA declared a total refusal. We decided to invest exclusively in high-potency raw macerates and rare botanical isolates.
          </p>
        </div>
        <div class="gsap-clip-reveal" style="aspect-ratio: 4/3; border: 1px solid var(--color-border); overflow: hidden;">
          <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="Chapter 1 Refusal" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%);">
        </div>
      </div>

      <!-- Chapter 02 -->
      <div class="timeline-chapter">
        <div class="chapter-number">02</div>
        <div>
          <span class="editorial-label">CHAPTER II · 35% CONCENTRATION (2023)</span>
          <h3 class="font-serif" style="font-size: 2rem; margin-top: 8px;">THE UNCOMPROMISED STANDARD</h3>
          <p class="text-soft" style="font-size: 0.95rem; line-height: 1.7; margin-top: 12px;">
            Standard Eau de Parfum ranges between 15% and 20% oil. Our noses locked in an unyielding 35% oil ratio—yielding Extraits de Parfum so concentrated they coat skin in a silky protective sheen.
          </p>
        </div>
        <div class="gsap-clip-reveal" style="aspect-ratio: 4/3; border: 1px solid var(--color-border); overflow: hidden;">
          <img src="{{ 'bestseller_oud_royal.jpg' | asset_url }}" alt="Chapter 2 Maceration" style="width: 100%; height: 100%; object-fit: cover; filter: contrast(1.2);">
        </div>
      </div>

      <!-- Chapter 03 -->
      <div class="timeline-chapter">
        <div class="chapter-number">03</div>
        <div>
          <span class="editorial-label">CHAPTER III · THE OBSIDIAN FLACON (2025)</span>
          <h3 class="font-serif" style="font-size: 2rem; margin-top: 8px;">ARCHITECTURAL VESSEL DESIGN</h3>
          <p class="text-soft" style="font-size: 0.95rem; line-height: 1.7; margin-top: 12px;">
            A living extrait requires protection from UV breakdown. Each heavy Italian glass bottle is weighted at 480 grams, finished with hand-polished sharp corners and a solid magnetic obsidian glass cap.
          </p>
        </div>
        <div class="gsap-clip-reveal" style="aspect-ratio: 4/3; border: 1px solid var(--color-border); overflow: hidden;">
          <img src="{{ 'discovery_box.jpg' | asset_url }}" alt="Chapter 3 Obsidian Flacon" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Full Viewport Visual Interruption Spread -->
<section class="visual-interruption-hero border-bottom-thin">
  <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="Agha Visual Interruption Campaign">
  <div class="visual-interruption-overlay gsap-reveal">
    <span class="editorial-label" style="color: var(--color-white); background: rgba(8,8,8,0.7); padding: 6px 16px; border: 1px solid var(--color-border);">CINEMATIC ART DIRECTION</span>
    <h2 class="font-serif" style="font-size: clamp(2.5rem, 5vw, 4.8rem); margin-top: 16px; color: var(--color-white); text-transform: uppercase;">
      “LESS MARKETING.<br>MORE CONCENTRATION.”
    </h2>
  </div>
</section>

{% schema %}
{
  "name": "Agha House Origin",
  "settings": []
}
{% endschema %}
