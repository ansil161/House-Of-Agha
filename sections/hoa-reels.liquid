{% comment %}
  HOUSE OF AGHA — SHOPPABLE FILMS

  A horizontal row of portrait video cards. Each card is one connected unit:
  the film on top, and directly beneath it the fragrance it belongs to
  (thumbnail, name, family, price, add to bag). Every block is one
  { video, product } pair.

  Product: pick a Shopify product on the block and its title, url, family,
  price, thumbnail and cart form are all live. With no product picked the block
  falls back to the manual name / handle / price fields (used by the local
  preview and a fresh store) and the bag control becomes a link to the product.

  Video: give "video" a theme asset filename (uploaded to /assets) or a full
  hosted URL; "video_webm" is optional. With no video the poster shows as a
  still and no playback controls render.

  Playback (assets/hoa-reels.js): nothing is fetched until a card is near the
  viewport; a film plays muted and looped only while it is visible both in the
  carousel and on the page, and pauses otherwise. Sound is opt-in per card.
{% endcomment %}

{%- comment -%}
  ============================================================================
  TEMPORARY DEVELOPMENT DATA — the ONLY place mock content lives.
  Replace when real Shopify products and brand films exist:
    - Pick a product and upload a video on each block in the Theme Editor
      (or templates/index.json). Any block that has a product or a video of its
      own ignores this list, so you can migrate one card at a time.
    - When every block is real, delete this whole assign line and the
      "mock" lookups below.
  Row order = block order. Fields:
    name | handle | type | price | video URL | poster asset | thumbnail asset
  Videos: free portrait clips hosted on the Pexels CDN (Pexels licence:
  free for commercial use, no attribution required). They are stand-ins only.
  ============================================================================
{%- endcomment -%}
{%- assign mock_rows = 'Oud Fury|oud-fury|Eau de Parfum|₹4,500|https://videos.pexels.com/video-files/7816005/7816005-sd_540_960_25fps.mp4|hoa-oud-fury-portrait|hoa-product-oud-fury;Agha Blue|agha-blue|Eau de Parfum|₹5,200|https://videos.pexels.com/video-files/6764969/6764969-sd_540_960_25fps.mp4|hoa-agha-blue-portrait|hoa-product-agha-blue;Oud of Dark Paradise|oud-of-dark-paradise|Eau de Parfum|₹4,800|https://videos.pexels.com/video-files/12719020/12719020-sd_540_960_30fps.mp4|hoa-dark-paradise-portrait|hoa-product-dark-paradise;Maha|maha|Eau de Parfum|₹4,600|https://videos.pexels.com/video-files/5848516/5848516-sd_540_960_24fps.mp4|hoa-maha-portrait|hoa-product-maha' | split: ';' -%}
{%- liquid
  assign s = section.settings
  assign all_url = s.all_url | default: routes.all_products_collection_url
-%}
<section class="hoa-reels" id="shoppable-films" data-hoa-reels aria-labelledby="reels-{{ section.id }}-title">
  <div class="hoa-wrap">
    <header class="hoa-reels__head">
      <div data-hoa-reveal>
        <p class="hoa-eyebrow">{{ s.eyebrow }}</p>
        <h2 class="hoa-h2" id="reels-{{ section.id }}-title">{{ s.heading }} <em>{{ s.heading_serif }}</em></h2>
      </div>
      <div class="hoa-reels__nav" data-hoa-reveal>
        <a class="hoa-link" href="{{ all_url }}">{{ s.all_label }}</a>
        <div class="hoa-reels__arrows">
          <button type="button" class="hoa-reels__arrow" data-hoa-reels-prev aria-label="Previous films">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="hoa-reels__arrow" data-hoa-reels-next aria-label="Next films">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </header>

    <div class="hoa-reels__viewport">
      <ul class="hoa-reels__track" data-hoa-reels-track role="list" tabindex="0" aria-label="Shoppable fragrance films">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign p = b.product
            assign m = mock_rows[forloop.index0] | split: '|'
            assign use_mock = false
            if p == blank and b.fallback_name == blank
              assign use_mock = true
            endif

            if p != blank
              assign r_name = p.title
              assign r_url = p.url
              assign r_family = p.metafields.custom.family.value | default: p.type
              if p.price_varies
                assign r_price = p.price_min | money | prepend: 'From '
              else
                assign r_price = p.price | money
              endif
              assign r_variant = p.selected_or_first_available_variant
            else
              if use_mock and m.size > 1
                assign r_name = m[0]
                assign r_url = '/products/' | append: m[1]
                assign r_family = m[2]
                assign r_price = m[3]
              else
                assign r_name = b.fallback_name
                assign r_url = b.fallback_url | default: all_url
                assign r_family = b.fallback_family
                assign r_price = b.fallback_price
              endif
            endif

            assign has_video = false
            assign video_in = b.video
            if video_in == blank and use_mock and m.size > 4
              assign video_in = m[4]
            endif
            if video_in != blank
              assign has_video = true
              if video_in contains '://'
                assign video_src = video_in
              else
                assign video_src = video_in | asset_url
              endif
              assign webm_src = ''
              if b.video_webm != blank
                if b.video_webm contains '://'
                  assign webm_src = b.video_webm
                else
                  assign webm_src = b.video_webm | asset_url
                endif
              endif
            endif

            assign poster_name = b.poster_asset
            assign thumb_name = b.thumb_asset
            if use_mock and m.size > 6
              assign poster_name = poster_name | default: m[5]
              assign thumb_name = thumb_name | default: m[6]
            endif
            assign poster_alt = b.poster_alt | default: r_name
            assign thumb_alt = r_name | append: ' bottle'
          -%}
          <li class="hoa-reel" data-hoa-reel {{ block.shopify_attributes }}>
            <div class="hoa-reel__frame">
              <div class="hoa-reel__stage" data-hoa-reel-stage>
                {%- render 'hoa-img', name: poster_name, image: b.poster, w: 1200, h: 1607, alt: poster_alt, sizes: '(min-width: 1101px) 22vw, (min-width: 768px) 38vw, 74vw', class: 'hoa-reel__poster' -%}

                {%- if has_video -%}
                  <video
                    class="hoa-reel__video"
                    data-hoa-reel-video
                    muted
                    loop
                    playsinline
                    preload="none"
                    disablepictureinpicture
                    data-src="{{ video_src }}"
                    {%- if webm_src != blank %} data-src-webm="{{ webm_src }}"{% endif %}
                    aria-label="{{ r_name | escape }} film"
                  ></video>
                  <div class="hoa-reel__controls">
                    <button type="button" class="hoa-reel__ctrl" data-hoa-reel-play aria-label="Pause film">
                      <svg class="hoa-reel__i-play" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5.5V18.5L19 12L8 5.5Z" fill="currentColor"/></svg>
                      <svg class="hoa-reel__i-pause" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="7" y="5" width="3.6" height="14" fill="currentColor"/><rect x="13.4" y="5" width="3.6" height="14" fill="currentColor"/></svg>
                    </button>
                    <button type="button" class="hoa-reel__ctrl" data-hoa-reel-sound aria-label="Turn sound on" aria-pressed="false">
                      <svg class="hoa-reel__i-muted" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9.5V14.5H8L13 18.5V5.5L8 9.5H4Z" fill="currentColor"/><path d="M16.5 9.5L21 14.5M21 9.5L16.5 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      <svg class="hoa-reel__i-sound" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9.5V14.5H8L13 18.5V5.5L8 9.5H4Z" fill="currentColor"/><path d="M16 9C17.2 10.1 17.2 13.9 16 15M18.6 6.6C21.1 9 21.1 15 18.6 17.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </button>
                  </div>
                {%- endif -%}
              </div>

              <div class="hoa-reel__product">
                <span class="hoa-reel__thumb">
                  {%- if p != blank and p.featured_media -%}
                    {{ p.featured_media.preview_image | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '64px', loading: 'lazy', alt: thumb_alt }}
                  {%- elsif thumb_name != blank -%}
                    {%- render 'hoa-img', name: thumb_name, w: 1200, h: 1500, alt: thumb_alt, sizes: '64px' -%}
                  {%- endif -%}
                </span>

                <div class="hoa-reel__info">
                  <h3 class="hoa-reel__name"><a class="hoa-reel__link" href="{{ r_url }}">{{ r_name }}</a></h3>
                  {%- if r_family != blank -%}<p class="hoa-reel__family">{{ r_family }}</p>{%- endif -%}
                  {%- if p != blank and p.available == false -%}
                    <p class="hoa-reel__price">Sold out</p>
                  {%- elsif r_price != blank -%}
                    <p class="hoa-reel__price">{{ r_price }}</p>
                  {%- endif -%}
                </div>

                {%- if p != blank and p.has_only_default_variant and r_variant.available -%}
                  {%- form 'product', p, class: 'hoa-reel__form' -%}
                    <input type="hidden" name="id" value="{{ r_variant.id }}">
                    <button type="submit" name="add" class="hoa-reel__add" data-title="{{ p.title | escape }}" data-price="{{ r_price | escape }}" data-size="{{ r_variant.title | escape }}" data-image="{{ p.featured_media.preview_image | image_url: width: 240 }}" aria-label="Add {{ p.title | escape }} to bag">
                      <svg class="hoa-reel__i-bag" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5.5 8.5H18.5L19.5 20H4.5L5.5 8.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 8.5V7.5C9 5.6 10.3 4 12 4C13.7 4 15 5.6 15 7.5V8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                      <svg class="hoa-reel__i-check" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5L10 17.5L19 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                  {%- endform -%}
                {%- else -%}
                  <a class="hoa-reel__add" href="{{ r_url }}" aria-label="{% if p != blank and p.has_only_default_variant == false %}Choose a size for {{ r_name | escape }}{% else %}View {{ r_name | escape }}{% endif %}">
                    <svg class="hoa-reel__i-bag" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5.5 8.5H18.5L19.5 20H4.5L5.5 8.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 8.5V7.5C9 5.6 10.3 4 12 4C13.7 4 15 5.6 15 7.5V8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <p class="hoa-reels__live" data-hoa-reels-live role="status" aria-live="polite"></p>
  </div>
</section>

<script src="{{ 'hoa-reels.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "HOA Shoppable Films",
  "tag": "div",
  "class": "hoa-reels-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Watch. Discover. Wear." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover our" },
    { "type": "text", "id": "heading_serif", "label": "Heading, serif part", "default": "fragrances." },
    { "type": "text", "id": "all_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "all_url", "label": "Link (defaults to all products)" }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Film + product",
      "settings": [
        { "type": "header", "content": "Film" },
        { "type": "text", "id": "video", "label": "Video", "info": "A filename already uploaded to /assets (e.g. agha-reel-oud-fury.mp4), or a full hosted URL. Portrait 4:5 or 9:16, short and loopable. Leave blank to show the poster only." },
        { "type": "text", "id": "video_webm", "label": "Video, WebM (optional)" },
        { "type": "image_picker", "id": "poster", "label": "Poster image" },
        { "type": "text", "id": "poster_asset", "label": "Poster (theme asset filename, used if no image is picked)" },
        { "type": "text", "id": "poster_alt", "label": "Poster alt text" },
        { "type": "header", "content": "Product" },
        { "type": "product", "id": "product", "label": "Product", "info": "Name, family, price, thumbnail, link and add to bag all come from this product." },
        { "type": "header", "content": "Fallback (used when no product is picked)" },
        { "type": "text", "id": "fallback_name", "label": "Name" },
        { "type": "text", "id": "fallback_family", "label": "Family / type" },
        { "type": "text", "id": "fallback_price", "label": "Price (leave blank to hide)" },
        { "type": "text", "id": "thumb_asset", "label": "Thumbnail (theme asset filename)" },
        { "type": "url", "id": "fallback_url", "label": "Product link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "HOA Shoppable Films",
      "blocks": [{ "type": "reel" }, { "type": "reel" }, { "type": "reel" }, { "type": "reel" }]
    }
  ]
}
{% endschema %}
