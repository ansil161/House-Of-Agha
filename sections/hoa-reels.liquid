{% comment %}
  HOUSE OF AGHA — INSTAGRAM REELS

  A horizontal row of portrait Instagram-style reel cards. Video only: no
  product name, price or bag button. Each card links to its reel on Instagram.

  Home page: shows every reel.
  Product page: turn on "Product page mode" and the section shows just the
  videos that belong to the product being viewed (matched by product handle),
  plain video cards with no Instagram branding, and renders nothing if that
  product has no video. Add one block per video (same product, several blocks).

  Matching: pick a Shopify product on the block, or type its handle in
  "Product handle". With neither, the local-preview mock list below is used.

  Video: give "video" a theme asset filename (uploaded to /assets) or a full
  hosted URL; "video_webm" is optional. With no video the poster shows as a
  still and no playback controls render.

  Playback (assets/hoa-reels.js): nothing is fetched until a card is near the
  viewport; a reel plays muted and looped only while it is visible both in the
  carousel and on the page, and pauses otherwise. Sound is opt-in per card.
{% endcomment %}

{%- comment -%}
  ============================================================================
  TEMPORARY DEVELOPMENT DATA — the ONLY place mock content lives.
  Replace when real brand reels exist:
    - Upload a video and set the product handle on each block in the Theme
      Editor (or templates/index.json / templates/product.json). Any block that
      has a product or a video of its own ignores this list, so you can migrate
      one card at a time.
    - When every block is real, delete this whole assign line and the
      "mock" lookups below.
  Row order = block order. Fields:
    name | handle | type | price (unused) | video URL | poster asset | thumbnail (unused)
  Videos: free portrait clips hosted on the Pexels CDN (Pexels licence:
  free for commercial use, no attribution required). They are stand-ins only.
  ============================================================================
{%- endcomment -%}
{%- assign mock_rows = 'Oud Fury|oud-fury|Eau de Parfum|₹4,500|https://videos.pexels.com/video-files/7816005/7816005-sd_540_960_25fps.mp4|hoa-oud-fury-portrait|hoa-product-oud-fury;Agha Blue|agha-blue|Eau de Parfum|₹5,200|https://videos.pexels.com/video-files/6764969/6764969-sd_540_960_25fps.mp4|hoa-agha-blue-portrait|hoa-product-agha-blue;Oud of Dark Paradise|oud-of-dark-paradise|Eau de Parfum|₹4,800|https://videos.pexels.com/video-files/12719020/12719020-sd_540_960_30fps.mp4|hoa-dark-paradise-portrait|hoa-product-dark-paradise;Maha|maha|Eau de Parfum|₹4,600|https://videos.pexels.com/video-files/5848516/5848516-sd_540_960_24fps.mp4|hoa-maha-portrait|hoa-product-maha' | split: ';' -%}
{%- liquid
  assign s = section.settings
  assign ig_handle = s.instagram_handle | default: 'houseofagha' | remove: '@'
  assign ig_url = s.instagram_url | default: 'https://www.instagram.com/houseofagha/'
  assign single = false
  if s.only_current_product and product != blank
    assign single = true
  endif
  assign shown = 0
-%}
{%- capture reel_cards -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign p = b.product
      assign m = mock_rows[forloop.index0] | split: '|'
      assign use_mock = false
      if p == blank and b.fallback_handle == blank
        assign use_mock = true
      endif

      if p != blank
        assign r_name = p.title
        assign r_handle = p.handle
      elsif use_mock and m.size > 1
        assign r_name = m[0]
        assign r_handle = m[1]
      else
        assign r_name = b.fallback_handle
        assign r_handle = b.fallback_handle
      endif

      assign skip = false
      if single and r_handle != product.handle
        assign skip = true
      endif

      assign has_video = false
      assign video_in = b.video
      if video_in == blank and use_mock and m.size > 4
        assign video_in = m[4]
      endif
      if video_in != blank
        assign has_video = true
        if video_in contains '://'
          assign video_src = video_in
        else
          assign video_src = video_in | asset_url
        endif
        assign webm_src = ''
        if b.video_webm != blank
          if b.video_webm contains '://'
            assign webm_src = b.video_webm
          else
            assign webm_src = b.video_webm | asset_url
          endif
        endif
      endif

      assign poster_name = b.poster_asset
      if use_mock and m.size > 5
        assign poster_name = poster_name | default: m[5]
      endif
      assign poster_alt = b.poster_alt | default: r_name
      assign reel_link = b.reel_url | default: ig_url
    -%}
    {%- unless skip -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="hoa-reel" data-hoa-reel {{ block.shopify_attributes }}>
        <div class="hoa-reel__frame">
          <div class="hoa-reel__stage" data-hoa-reel-stage>
            {%- render 'hoa-img', name: poster_name, image: b.poster, w: 1200, h: 1607, alt: poster_alt, sizes: '(min-width: 1101px) 22vw, (min-width: 768px) 38vw, 74vw', class: 'hoa-reel__poster' -%}

            {%- if has_video -%}
              <video
                class="hoa-reel__video"
                data-hoa-reel-video
                muted
                loop
                playsinline
                preload="none"
                disablepictureinpicture
                data-src="{{ video_src }}"
                {%- if webm_src != blank %} data-src-webm="{{ webm_src }}"{% endif %}
                aria-label="{{ r_name | escape }} reel"
              ></video>
            {%- endif -%}

            {%- unless single -%}
            <a class="hoa-reel__open" href="{{ reel_link }}" target="_blank" rel="noopener" aria-label="Watch the {{ r_name | escape }} reel on Instagram (opens in a new tab)"></a>

            <div class="hoa-reel__ig">
              <span class="hoa-reel__avatar" aria-hidden="true">A</span>
              <span class="hoa-reel__handle">@{{ ig_handle }}</span>
              <svg class="hoa-reel__glyph" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/></svg>
            </div>
            {%- endunless -%}

            {%- if has_video -%}
              <div class="hoa-reel__controls">
                <button type="button" class="hoa-reel__ctrl" data-hoa-reel-play aria-label="Pause reel">
                  <svg class="hoa-reel__i-play" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5.5V18.5L19 12L8 5.5Z" fill="currentColor"/></svg>
                  <svg class="hoa-reel__i-pause" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="7" y="5" width="3.6" height="14" fill="currentColor"/><rect x="13.4" y="5" width="3.6" height="14" fill="currentColor"/></svg>
                </button>
                <button type="button" class="hoa-reel__ctrl" data-hoa-reel-sound aria-label="Turn sound on" aria-pressed="false">
                  <svg class="hoa-reel__i-muted" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9.5V14.5H8L13 18.5V5.5L8 9.5H4Z" fill="currentColor"/><path d="M16.5 9.5L21 14.5M21 9.5L16.5 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  <svg class="hoa-reel__i-sound" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9.5V14.5H8L13 18.5V5.5L8 9.5H4Z" fill="currentColor"/><path d="M16 9C17.2 10.1 17.2 13.9 16 15M18.6 6.6C21.1 9 21.1 15 18.6 17.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </button>
              </div>
            {%- endif -%}

            {%- unless single -%}
            <span class="hoa-reel__badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.6"/><path d="M4 9H20M9.5 4L7.5 9M15.5 4L13.5 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M10.5 12.5V16.5L14 14.5L10.5 12.5Z" fill="currentColor"/></svg>
              Reel
            </span>
            {%- endunless -%}
          </div>
        </div>
      </li>
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 -%}
<section class="hoa-reels{% if single %} hoa-reels--product{% endif %}" id="instagram-reels" data-hoa-reels aria-labelledby="reels-{{ section.id }}-title">
  <div class="hoa-wrap">
    <header class="hoa-reels__head">
      <div data-hoa-reveal>
        <p class="hoa-eyebrow">{{ s.eyebrow }}</p>
        <h2 class="hoa-h2" id="reels-{{ section.id }}-title">{{ s.heading }} <em>{{ s.heading_serif }}</em></h2>
      </div>
      <div class="hoa-reels__nav" data-hoa-reveal>
        {%- unless single -%}<a class="hoa-link" href="{{ ig_url }}" target="_blank" rel="noopener">{{ s.follow_label | default: 'Follow' }} @{{ ig_handle }}</a>{%- endunless -%}
        <div class="hoa-reels__arrows">
          <button type="button" class="hoa-reels__arrow" data-hoa-reels-prev aria-label="Previous reels">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="hoa-reels__arrow" data-hoa-reels-next aria-label="Next reels">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </header>

    <div class="hoa-reels__viewport">
      <ul class="hoa-reels__track" data-hoa-reels-track role="list" tabindex="0" aria-label="Instagram reels">
        {{ reel_cards }}
      </ul>
    </div>
  </div>
</section>

<script src="{{ 'hoa-reels.js' | asset_url }}" defer></script>
{%- elsif request.design_mode -%}
  <p style="padding:24px;text-align:center;font:14px sans-serif">Instagram reels: no reel matches this product yet. Add a block with this product's handle.</p>
{%- endif -%}

{% schema %}
{
  "name": "HOA Instagram Reels",
  "tag": "div",
  "class": "hoa-reels-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "On Instagram" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch the" },
    { "type": "text", "id": "heading_serif", "label": "Heading, serif part", "default": "reels." },
    { "type": "text", "id": "instagram_handle", "label": "Instagram handle", "default": "houseofagha" },
    { "type": "url", "id": "instagram_url", "label": "Instagram profile link", "default": "https://www.instagram.com/houseofagha/" },
    { "type": "text", "id": "follow_label", "label": "Follow link label", "default": "Follow" },
    { "type": "checkbox", "id": "only_current_product", "label": "Product page mode: only this product's videos", "info": "Turn on when this section sits on a product page. Shows just the videos of the product being viewed, with no Instagram branding or links.", "default": false }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Instagram reel",
      "settings": [
        { "type": "text", "id": "video", "label": "Video", "info": "A filename already uploaded to /assets (e.g. agha-reel-oud-fury.mp4), or a full hosted URL. Portrait 9:16, short and loopable. Leave blank to show the poster only." },
        { "type": "text", "id": "video_webm", "label": "Video, WebM (optional)" },
        { "type": "url", "id": "reel_url", "label": "Instagram reel link", "info": "Defaults to the profile link." },
        { "type": "image_picker", "id": "poster", "label": "Poster image" },
        { "type": "text", "id": "poster_asset", "label": "Poster (theme asset filename, used if no image is picked)" },
        { "type": "text", "id": "poster_alt", "label": "Poster alt text" },
        { "type": "product", "id": "product", "label": "Product this reel belongs to", "info": "Used to show the reel on that product's page." },
        { "type": "text", "id": "fallback_handle", "label": "Product handle (if no product is picked)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "HOA Instagram Reels",
      "blocks": [{ "type": "reel" }, { "type": "reel" }, { "type": "reel" }, { "type": "reel" }]
    }
  ]
}
{% endschema %}
