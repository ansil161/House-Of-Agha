{% comment %}
  AGHA DISCOVER HERO SECTION
{% endcomment %}

<section class="section-padding border-bottom-thin" style="padding-top: 160px; padding-bottom: var(--space-2xl);">
  <div class="container">
    <div class="grid-asymmetric-left gsap-reveal">
      <div>
        <span class="editorial-label">01 — OLFACTORY CONSULTATION</span>
        <h1 class="headline-hero font-serif" style="margin-top: 16px;">
          FIND THE SCENT<br>
          THAT FEELS LIKE YOU.
        </h1>
        <p class="text-soft" style="margin-top: 24px; max-width: 520px; font-size: 1.05rem; line-height: 1.8;">
          Scent is an intimate aura that lingers in rooms long after you have departed. Answer three sensory inquiries to pinpoint the AGHA Extrait de Parfum tailored to your skin chemistry and presence.
        </p>
      </div>

      <div class="gsap-clip-reveal" style="aspect-ratio: 4/5; overflow: hidden; border: 1px solid var(--color-border); position: relative;">
        <img src="{{ 'discovery_box.jpg' | asset_url }}" alt="Discover Olfactory Finder" style="width: 100%; height: 100%; object-fit: cover; filter: contrast(1.15);">
        <div style="position: absolute; bottom: 20px; left: 20px; background: rgba(8,8,8,0.85); padding: 8px 16px; border: 1px solid var(--color-border); font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;">
          BESPOKE DIAGNOSTIC ENGINE
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Agha Discover Hero",
  "settings": []
}
{% endschema %}
