{%- comment -%}
  Home V2 · 03 Signature fragrances — an editorial index.
  Desktop: the names are a numbered list; hovering / focusing one brings its bottle onto the stage
  beside it (assets/hoa-v2.js). Phones: a swipeable row of bottles with their names.
  Family + price come from the Shopify product when it exists, else the shared catalog.
{%- endcomment -%}
{%- render 'hoa-v2-assets' -%}
{%- capture catalog_json -%}{%- render 'hoa-catalog-data' -%}{%- endcapture -%}
{%- liquid
  assign s = section.settings
  assign catalog = catalog_json | parse_json
-%}
<section class="v2-sig v2-pad" id="fragrances" data-v2-sig>
  <div class="v2-wrap">
    <header class="v2-head">
      <p class="v2-eyebrow" data-v2-reveal><span>03</span>{{ s.eyebrow }}</p>
      <h2 class="v2-h2" data-v2-lines>{{ s.heading }} <em>{{ s.heading_serif }}</em></h2>
      <a class="v2-link v2-head__link" href="{{ s.all_url | default: routes.all_products_collection_url }}" data-v2-reveal><span>{{ s.all_label }}</span><span class="v2-link__arrow" aria-hidden="true">&rarr;</span></a>
    </header>

    <div class="v2-sig__body">
      <ol class="v2-sig__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign fam = ''
            assign price = ''
            assign url = '/products/' | append: b.handle
            assign sp = all_products[b.handle]
            if sp != blank and sp.id
              assign url = sp.url
              assign fam = sp.metafields.custom.family.value | default: sp.type
              assign price = sp.price | money
            else
              for c in catalog.products
                if c.handle == b.handle
                  assign fam = c.family
                  assign pn = c.salePrice | default: c.regularPrice
                  capture price
                    render 'hoa-v2-inr', n: pn
                  endcapture
                endif
              endfor
            endif
          -%}
          <li class="v2-sig__item{% if forloop.first %} is-active{% endif %}" data-v2-sig-item="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <a class="v2-sig__row" href="{{ url }}">
              <span class="v2-sig__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="v2-sig__name">{{ b.name }}</span>
              <span class="v2-sig__meta">{{ fam }}{% if price != blank %}<span>{{ price }}</span>{% endif %}</span>
            </a>
            <figure class="v2-sig__bottle" data-v2-sig-bottle>
              {%- render 'hoa-img', name: b.asset, image: b.image, w: 1200, h: 1500, alt: b.name, sizes: '(min-width: 961px) 30vw, 60vw' -%}
              <figcaption class="v2-sig__line">{{ b.line }}</figcaption>
            </figure>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "V2 · Signature",
  "class": "v2-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Tag", "default": "Signature fragrances" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seven worlds," },
    { "type": "text", "id": "heading_serif", "label": "Heading (serif italic)", "default": "one House." },
    { "type": "text", "id": "all_label", "label": "Link label", "default": "Shop all fragrances" },
    { "type": "url", "id": "all_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "fragrance",
      "name": "Fragrance",
      "settings": [
        { "type": "text", "id": "handle", "label": "Product handle" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "textarea", "id": "line", "label": "Line" },
        { "type": "image_picker", "id": "image", "label": "Bottle on white" },
        { "type": "text", "id": "asset", "label": "Theme asset (fallback)" }
      ]
    }
  ],
  "presets": [{ "name": "V2 · Signature" }]
}
{% endschema %}
