{% comment %}
  SHOP · Bundles
  A quiet edit between the catalogue and the reviews: the Discovery Set, a "choose any two" duo and the
  Signature Collection. The cards are painted by assets/hoa-commerce.js from the shared mock catalog
  (snippets/hoa-catalog-data.liquid), so their prices always match the shop, the product page and the bag.
  Bundle prices come from the same quantity tiers the bag applies; nothing is added without a click.
  Shopify later: bundle products / an app supply the price and members; this section only needs those.
{% endcomment %}
{%- assign s = section.settings -%}
<section class="hoa-bundles" id="bundles" data-hoa-bundles aria-labelledby="bundles-{{ section.id }}-title">
  <div class="hoa-wrap">
    <header class="hoa-bundles__head" data-hoa-reveal>
      <p class="hoa-eyebrow">{{ s.eyebrow }}</p>
      <h2 class="hoa-bundles__title" id="bundles-{{ section.id }}-title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="hoa-bundles__text">{{ s.text }}</p>{%- endif -%}
    </header>
    <div class="hoa-bundles__grid" data-hoa-bundles-grid></div>
    <noscript><p class="hoa-bundles__text">Bundles need JavaScript to show their prices.</p></noscript>
  </div>
</section>

{% schema %}
{
  "name": "HOA Shop bundles",
  "tag": "div",
  "class": "hoa-shop-bundles-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sets & pairs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore more than one" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choose two fragrances and save 10%, three and save 15%. Or begin with the Discovery Set." }
  ],
  "presets": [{ "name": "HOA Shop bundles" }]
}
{% endschema %}
