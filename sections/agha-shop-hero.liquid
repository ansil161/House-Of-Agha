<section class="section-padding border-bottom-thin" style="padding-top: var(--space-4xl); padding-bottom: var(--space-2xl);">
  <div class="container">
    <div class="grid-asymmetric-left gsap-reveal">
      <div>
        <span class="editorial-label">01 — THE COLLECTION</span>
        <h1 class="headline-hero font-serif" style="margin-top: 16px;">
          SCENTS COMPOSED<br>
          FOR PRESENCE.
        </h1>
        <p class="text-soft" style="margin-top: 24px; max-width: 540px; font-size: 1.05rem; line-height: 1.8;">
          Extraits de parfum formulated at an uncompromising 35% oil concentration. Each flacon is macerated for 90 days, yielding dark, resinous, and atmospheric signatures crafted to linger on fabric and skin.
        </p>

        <div style="margin-top: 36px; display: flex; gap: 16px; align-items: center;">
          <button class="btn-secondary js-filter-toggle">
            <span>FILTER COLLECTION</span>
            <span class="btn-arrow">⚙</span>
          </button>
          <span class="text-muted" style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase;">8 SIGNATURE FORMULATIONS</span>
        </div>
      </div>

      <div class="gsap-clip-reveal" style="aspect-ratio: 16/10; overflow: hidden; border: 1px solid var(--color-border); position: relative;">
        <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="AGHA Perfumes Collection Campaign" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(40%) contrast(1.1);">
        <div style="position: absolute; bottom: 20px; right: 20px; font-size: 0.65rem; letter-spacing: 0.25em; text-transform: uppercase; background: rgba(8,8,8,0.8); padding: 6px 14px; border: 1px solid var(--color-border);">
          FALL / WINTER ARCHIVE
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Agha Shop Hero",
  "settings": []
}
{% endschema %}
