{% comment %}
  07 — THE WORLD OF AGHA
  Merges the former watch-reels.liquid and customer-stories.liquid.

  Reels: "reel" blocks (a Shopify-hosted video, or a theme asset clip filename).
  With no reel blocks the section shows the house films already in /assets
  (agha-hero-*.mp4). Videos are muted, inline, preload="none", and only play
  while on screen (assets/agha-world.js). Reduced motion shows posters only.

  Stories: "story" blocks. Nothing renders when there are none, so no copy is
  invented here. The content lives in templates/index.json and the Theme Editor.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign reels = section.blocks | where: 'type', 'reel'
  assign stories = section.blocks | where: 'type', 'story'
-%}

<section class="agha-world section-padding border-top-thin" id="world" data-agha-world aria-labelledby="world-{{ section.id }}-title">
  <div class="container">

    <header class="agha-section-head gsap-reveal">
      <div>
        <span class="editorial-label">{{ s.label }}</span>
        <h2 class="headline-section font-serif" id="world-{{ section.id }}-title">{{ s.heading }}</h2>
      </div>
      {%- if s.intro != blank -%}<p class="agha-world__intro">{{ s.intro }}</p>{%- endif -%}
    </header>

    {%- comment -%} Reels {%- endcomment -%}
    <div class="agha-world__reels gsap-reveal" id="reels">
      {%- if reels.size > 0 -%}
        {%- for block in reels limit: 3 -%}
          <figure class="agha-reel{% if forloop.first %} agha-reel--feature{% endif %}" {{ block.shopify_attributes }}>
            <div class="agha-reel__frame">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', class: 'agha-reel__video', image_size: '1200x', data-agha-reel: '' }}
              {%- elsif block.settings.asset_clip != blank -%}
                <video class="agha-reel__video" muted loop playsinline preload="none" data-agha-reel
                  {%- if block.settings.asset_poster != blank %} poster="{{ block.settings.asset_poster | asset_url }}"{% endif %}
                  data-src="{{ block.settings.asset_clip | asset_url }}"></video>
              {%- elsif block.settings.poster != blank -%}
                {{ block.settings.poster | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'agha-reel__video', alt: block.settings.title }}
              {%- endif -%}
            </div>
            <figcaption class="agha-reel__caption">
              <span>{{ block.settings.label }}</span>
              {{ block.settings.title }}
            </figcaption>
          </figure>
        {%- endfor -%}
      {%- else -%}
        <figure class="agha-reel agha-reel--feature">
          <div class="agha-reel__frame">
            <video class="agha-reel__video" muted loop playsinline preload="none" data-agha-reel poster="{{ 'agha-hero-bottle-reveal.jpg' | asset_url }}" data-src="{{ 'agha-hero-bottle-reveal.mp4' | asset_url }}"></video>
          </div>
          <figcaption class="agha-reel__caption"><span>Film 01</span>Oud Royal, revealed</figcaption>
        </figure>
        <figure class="agha-reel">
          <div class="agha-reel__frame">
            <video class="agha-reel__video" muted loop playsinline preload="none" data-agha-reel poster="{{ 'agha-hero-ingredient.jpg' | asset_url }}" data-src="{{ 'agha-hero-ingredient.mp4' | asset_url }}"></video>
          </div>
          <figcaption class="agha-reel__caption"><span>Film 02</span>Saffron, black rose, agarwood</figcaption>
        </figure>
        <figure class="agha-reel">
          <div class="agha-reel__frame">
            <video class="agha-reel__video" muted loop playsinline preload="none" data-agha-reel poster="{{ 'agha-hero-bottle-macro.jpg' | asset_url }}" data-src="{{ 'agha-hero-bottle-macro.mp4' | asset_url }}"></video>
          </div>
          <figcaption class="agha-reel__caption"><span>Film 03</span>The label, up close</figcaption>
        </figure>
      {%- endif -%}
    </div>

    {%- comment -%} Stories {%- endcomment -%}
    {%- if stories.size > 0 -%}
      <div class="agha-world__stories" id="stories">
        {%- for block in stories -%}
          {%- if forloop.first -%}
            <blockquote class="agha-story agha-story--lead gsap-reveal" {{ block.shopify_attributes }}>
              <p class="agha-story__quote font-serif">“{{ block.settings.quote }}”</p>
              <cite class="agha-story__cite">{{ block.settings.author }}{% if block.settings.detail != blank %} · {{ block.settings.detail }}{% endif %}</cite>
            </blockquote>
            {%- if stories.size > 1 -%}<ul class="agha-world__more gsap-reveal">{%- endif -%}
          {%- else -%}
            <li class="agha-story" {{ block.shopify_attributes }}>
              <cite class="agha-story__name font-serif">{{ block.settings.author }}</cite>
              <p class="agha-story__line">“{{ block.settings.quote }}”</p>
            </li>
            {%- if forloop.last -%}</ul>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<script src="{{ 'agha-world.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Agha World of Agha",
  "tag": "div",
  "class": "agha-world-section",
  "max_blocks": 7,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "07 — The World of Agha" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "THE WORLD OF AGHA" },
    { "type": "textarea", "id": "intro", "label": "Intro line" }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "limit": 3,
      "settings": [
        { "type": "video", "id": "video", "label": "Video (Shopify-hosted)" },
        { "type": "text", "id": "asset_clip", "label": "Or theme asset clip filename", "info": "e.g. agha-hero-ingredient.mp4" },
        { "type": "text", "id": "asset_poster", "label": "Theme asset poster filename", "info": "e.g. agha-hero-ingredient.jpg" },
        { "type": "image_picker", "id": "poster", "label": "Image (used when there is no video)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Film" },
        { "type": "text", "id": "title", "label": "Title" }
      ]
    },
    {
      "type": "story",
      "name": "Story",
      "limit": 4,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Name or publication" },
        { "type": "text", "id": "detail", "label": "Detail (city, issue)" }
      ]
    }
  ],
  "presets": [{ "name": "Agha World of Agha" }]
}
{% endschema %}
