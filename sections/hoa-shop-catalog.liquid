{% comment %}
  SHOP · Catalogue
  Every fragrance in the collection, filterable by wearer (Men / Women / Unisex) and scent
  family, sortable, and shown as a grid or a list. The toolbar sticks under the header.
  Filtering happens in place (hoa-shop.js) and is mirrored in the URL (?for=, ?family=,
  ?sort=, ?view=list) so a filtered view can be linked. Without JS every product is listed
  in the grid.

  Grid: three columns; one campaign photo (the interlude) spans two columns after the
  third product, so seven products fill three rows. It only shows in the unfiltered,
  featured view, where that arithmetic holds.

  Data per product:
    wearer  custom.gender metafield, else a tag named Men / Women / Unisex
            (also accepts "For Men", "gender:men" …)
    family  custom.family metafield, else the product type
  With no products in the collection (local preview, fresh store) the static House of
  Agha line-up below is listed instead.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign source = collection
  assign use_shopify = false
  if source != blank and source.products_count > 0
    assign use_shopify = true
  endif
  assign families = s.families | split: ','

  comment
    Static line-up: name | handle | family | asset suffix | wearer | gift-ready | price | compare-at
    Prices are PREVIEW-ONLY placeholders (same mock figures as hoa-reels); real prices come from Shopify.
    Wearers are a first draft; confirm them before launch. Gift-ready is an unconfirmed
    merchandising guess (every bottle can be gifted; these three are marked as a starting
    point for the new Gift category) — confirm the real set with the user before launch.
  endcomment
  assign lineup = 'Oud Fury|oud-fury|Woody|oud-fury|men|true|₹4,500|₹5,200;Agha Blue|agha-blue|Fresh|agha-blue|men|false|₹5,200|;Oud of Dark Paradise|oud-of-dark-paradise|Woody|dark-paradise|unisex|false|₹4,800|;Maha|maha|Floral|maha|women|true|₹4,600|₹5,400;Sea Smoke|sea-smoke|Fresh|sea-smoke|unisex|true|₹4,900|;Tobacco Enigma|tobacco-enigma|Aromatic|tobacco-enigma|men|false|₹5,400|;Shamamah|shamamah|Floral|shamamah|women|false|₹4,700|' | split: ';'
  assign interlude_after = 3
-%}

{%- capture interlude -%}
  {%- if s.show_interlude -%}
    <figure class="hoa-shop-interlude" data-hoa-interlude>
      <a class="hoa-shop-interlude__media" href="{{ s.interlude_url | default: '/products/sea-smoke' }}">
        {%- render 'hoa-img', name: s.interlude_asset, image: s.interlude_image, w: 1200, h: 1200, alt: s.interlude_alt, sizes: '(min-width: 1000px) 62vw, 100vw' -%}
      </a>
      <figcaption class="hoa-pc__info hoa-shop-interlude__cap">
        <p class="hoa-pc__name">{{ s.interlude_caption }}</p>
        <p class="hoa-pc__meta"><span>{{ s.interlude_note }}</span></p>
        <p class="hoa-pc__price"><a href="{{ s.interlude_url | default: '/products/sea-smoke' }}">{{ s.interlude_link }}<span aria-hidden="true">&rarr;</span></a></p>
      </figcaption>
    </figure>
  {%- endif -%}
{%- endcapture -%}

<section class="hoa-shop-cat" id="catalog" data-hoa-shop>
  <div class="hoa-shop-bar" data-hoa-shop-bar>
    <div class="hoa-wrap hoa-shop-bar__inner">
      <div class="hoa-shop-bar__group hoa-shop-bar__group--for" role="group" aria-label="Filter by wearer">
        <button type="button" class="hoa-ftab" aria-pressed="true" data-hoa-for="all">{{ s.all_label }}<sup data-hoa-count="all"></sup></button>
        <button type="button" class="hoa-ftab" aria-pressed="false" data-hoa-for="men">{{ s.men_label }}<sup data-hoa-count="men"></sup></button>
        <button type="button" class="hoa-ftab" aria-pressed="false" data-hoa-for="women">{{ s.women_label }}<sup data-hoa-count="women"></sup></button>
        <button type="button" class="hoa-ftab" aria-pressed="false" data-hoa-for="unisex">{{ s.unisex_label }}<sup data-hoa-count="unisex"></sup></button>
      </div>

      <div class="hoa-shop-bar__group hoa-shop-bar__group--family" role="group" aria-label="Filter by scent family">
        <span class="hoa-shop-bar__label">Family</span>
        {%- for f in families -%}
          {%- assign fl = f | strip -%}
          <button type="button" class="hoa-ftag" aria-pressed="false" data-hoa-family="{{ fl | handleize }}">{{ fl }}</button>
        {%- endfor -%}
      </div>

      <div class="hoa-shop-bar__group hoa-shop-bar__group--gift" role="group" aria-label="Shop by occasion">
        <button type="button" class="hoa-ftag hoa-ftag--gift" aria-pressed="false" data-hoa-gift>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6.5h12v2H2zM3 8.5h10V14H3zM8 6.5V14M8 6.5C6.5 6.5 5.5 5.6 5.5 4.5S6.3 3 7 3.6C7.6 4.1 8 5 8 6.5ZM8 6.5c1.5 0 2.5-.9 2.5-2s-.8-1.5-1.5-.9C8.4 4.1 8 5 8 6.5Z" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ s.gift_label }}<sup data-hoa-count="gift"></sup>
        </button>
      </div>

      <div class="hoa-shop-bar__end">
        <label class="hoa-sort">
          <span class="hoa-shop-bar__label">Sort</span>
          <select data-hoa-sort>
            <option value="featured">Featured</option>
            <option value="az">A to Z</option>
            <option value="za">Z to A</option>
            {%- if use_shopify -%}
              <option value="price-asc">Price, low to high</option>
              <option value="price-desc">Price, high to low</option>
            {%- endif -%}
          </select>
        </label>
        <div class="hoa-fview" role="group" aria-label="Layout">
          <button type="button" class="hoa-fview__btn" aria-pressed="true" data-hoa-fview="grid" aria-label="Grid view">
            <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="5" height="5"/><rect x="9.5" y="1.5" width="5" height="5"/><rect x="1.5" y="9.5" width="5" height="5"/><rect x="9.5" y="9.5" width="5" height="5"/></svg>
          </button>
          <button type="button" class="hoa-fview__btn" aria-pressed="false" data-hoa-fview="list" aria-label="List view">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 3.5h13M1.5 8h13M1.5 12.5h13"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="hoa-wrap">
    <p class="hoa-shop-cat__status" aria-live="polite"><span data-hoa-shown></span><button type="button" class="hoa-shop-cat__clear" data-hoa-reset hidden>Clear filters</button></p>

    <div class="hoa-shop-grid" data-hoa-shop-grid data-view="grid">
      {%- if use_shopify -%}
        {%- for product in source.products -%}
          {%- liquid
            assign fam = product.metafields.custom.family.value | default: product.type
            assign wearer = product.metafields.custom.gender.value | downcase
            if wearer == blank
              for t in product.tags
                assign tl = t | downcase | remove: 'gender:' | remove: 'for ' | strip
                if tl == 'men' or tl == 'women' or tl == 'unisex'
                  assign wearer = tl
                  break
                endif
              endfor
            endif
            if wearer == 'man' or wearer == 'male' or wearer == 'him'
              assign wearer = 'men'
            elsif wearer == 'woman' or wearer == 'female' or wearer == 'her'
              assign wearer = 'women'
            endif
            assign wearer = wearer | default: 'unisex'
            assign variant = product.selected_or_first_available_variant
            if product.price_varies
              assign price = product.price_min | money | prepend: 'From '
            else
              assign price = product.price | money
            endif
            assign on_sale = false
            if product.compare_at_price > product.price and product.price_varies == false
              assign on_sale = true
            endif
            assign mood = product.media[1].preview_image
            assign is_gift = false
            if product.metafields.custom.gift.value
              assign is_gift = true
            endif
            for t in product.tags
              if t contains 'gift' or t contains 'Gift'
                assign is_gift = true
              endif
            endfor
            assign about = product.description | strip_html | strip_newlines | truncate: 110
            if about == blank
              assign fam_lc = fam | downcase
              assign article = 'A'
              assign fam_initial = fam_lc | slice: 0
              if 'aeiou' contains fam_initial
                assign article = 'An'
              endif
              assign about = article | append: ' ' | append: fam_lc | append: ' Eau de Parfum from House of Agha.'
            endif
          -%}
          <article class="hoa-pc" data-hoa-item data-for="{{ wearer }}" data-family="{{ fam | handleize }}" data-gift="{{ is_gift }}" data-name="{{ product.title | escape }}" data-price="{{ product.price }}" data-price-text="{{ price | escape }}"{% if on_sale %} data-compare-text="{{ product.compare_at_price | money | escape }}"{% endif %} data-image="{{ product.featured_media.preview_image | image_url: width: 240 }}" data-index="{{ forloop.index0 }}">
            <div class="hoa-pc__visual">
              <a class="hoa-pc__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                <span class="hoa-pc__img hoa-pc__img--product">
                  {%- if product.featured_media -%}
                    {{ product.featured_media.preview_image | image_url: width: 900 | image_tag: widths: '300, 600, 900', sizes: '(min-width: 1000px) 30vw, 50vw', loading: 'lazy', alt: '' }}
                  {%- endif -%}
                </span>
                {%- if mood -%}
                  <span class="hoa-pc__img hoa-pc__img--mood">{{ mood | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}</span>
                {%- endif -%}
              </a>
              <p class="hoa-pc__tag{% if on_sale and product.available %} hoa-pc__tag--sale{% endif %}">
                {%- if product.available -%}
                  {{ price }}{% if on_sale %} <s>{{ product.compare_at_price | money }}</s>{% endif %}
                {%- else -%}
                  Sold out
                {%- endif -%}
              </p>
              <button type="button" class="hoa-pc__like" aria-pressed="false" aria-label="Save {{ product.title | escape }} to your wishlist" data-hoa-like data-key="{{ product.handle }}" data-wishlist-toggle data-wishlist-handle="{{ product.handle }}" data-wishlist-variant="{{ product.selected_or_first_available_variant.id }}" data-wishlist-title="{{ product.title | escape }}">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 17.3S2.3 12.6 1 8.1C.2 5.2 2 2.4 5 2.4c2 0 3.6 1.2 5 3.1 1.4-1.9 3-3.1 5-3.1 3 0 4.8 2.8 4 5.7-1.3 4.5-9 9.2-9 9.2Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="hoa-pc__info">
              <p class="hoa-pc__meta"><span class="hoa-pc__chip">{{ fam }}</span><span class="hoa-pc__chip">{{ wearer | capitalize }}</span></p>
              <h3 class="hoa-pc__name"><a href="{{ product.url }}">{{ product.title }}</a>{%- if is_gift -%}<span class="hoa-pc__gift-tag">Gift</span>{%- endif -%}</h3>
              <p class="hoa-pc__price">{% if product.available %}{{ price }}{% if on_sale %} <s>{{ product.compare_at_price | money }}</s>{% endif %}{% else %}Sold out{% endif %}</p>
              {%- if about != blank -%}<p class="hoa-pc__about">{{ about }}</p>{%- endif -%}
              <div class="hoa-pc__action">
                {%- if variant.available -%}
                  {%- form 'product', product -%}
                    <input type="hidden" name="id" value="{{ variant.id }}">
                    <button type="submit" name="add" class="hoa-pc__cta" aria-label="Add {{ product.title | escape }} to bag"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 5.5h10l-.8 8H3.8L3 5.5ZM5.5 5.5V4.6a2.5 2.5 0 0 1 5 0v.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Add</span></button>
                  {%- endform -%}
                {%- else -%}
                  <button type="button" class="hoa-pc__cta hoa-pc__cta--ghost" disabled><span>Sold out</span></button>
                {%- endif -%}
              </div>
            </div>
          </article>
          {%- if forloop.index == interlude_after -%}{{ interlude }}{%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for row in lineup -%}
          {%- liquid
            assign f = row | split: '|'
            assign p_asset = 'hoa-product-' | append: f[3]
            assign m_asset = 'hoa-' | append: f[3] | append: '-portrait'
            assign fam_lc = f[2] | downcase
            assign article = 'A'
            assign fam_initial = fam_lc | slice: 0
            if 'aeiou' contains fam_initial
              assign article = 'An'
            endif
            assign about = article | append: ' ' | append: fam_lc | append: ' Eau de Parfum from House of Agha.'
          -%}
          <article class="hoa-pc" data-hoa-item data-for="{{ f[4] }}" data-family="{{ f[2] | handleize }}" data-gift="{{ f[5] }}" data-name="{{ f[0] }}" data-index="{{ forloop.index0 }}"
                   data-product-id="{{ f[1] }}" data-title="{{ f[0] | upcase }}" data-image="{{ p_asset | append: '-sm.webp' | asset_url }}" data-price="" data-price-text="{{ f[6] }}"{% if f[7] != blank %} data-compare-text="{{ f[7] }}"{% endif %}>
            <div class="hoa-pc__visual">
              <a class="hoa-pc__media" href="/products/{{ f[1] }}" tabindex="-1" aria-hidden="true">
                <span class="hoa-pc__img hoa-pc__img--product">
                  {%- render 'hoa-img', name: p_asset, w: 1200, h: 1500, alt: '', sizes: '(min-width: 1000px) 30vw, 50vw' -%}
                </span>
                <span class="hoa-pc__img hoa-pc__img--mood">
                  {%- render 'hoa-img', name: m_asset, w: 1200, h: 1607, alt: '', sizes: '(min-width: 1000px) 30vw, 50vw' -%}
                </span>
              </a>
              <p class="hoa-pc__tag{% if f[7] != blank %} hoa-pc__tag--sale{% endif %}">{{ f[6] }}{% if f[7] != blank %} <s>{{ f[7] }}</s>{% endif %}</p>
              <button type="button" class="hoa-pc__like" aria-pressed="false" aria-label="Save {{ f[0] }} to your wishlist" data-hoa-like data-key="{{ f[1] }}" data-wishlist-toggle data-wishlist-handle="{{ f[1] }}" data-wishlist-title="{{ f[0] | escape }}">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 17.3S2.3 12.6 1 8.1C.2 5.2 2 2.4 5 2.4c2 0 3.6 1.2 5 3.1 1.4-1.9 3-3.1 5-3.1 3 0 4.8 2.8 4 5.7-1.3 4.5-9 9.2-9 9.2Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="hoa-pc__info">
              <p class="hoa-pc__meta"><span class="hoa-pc__chip">{{ f[2] }}</span><span class="hoa-pc__chip">{{ f[4] | capitalize }}</span></p>
              <h3 class="hoa-pc__name"><a href="/products/{{ f[1] }}">{{ f[0] }}</a>{%- if f[5] == 'true' -%}<span class="hoa-pc__gift-tag">Gift</span>{%- endif -%}</h3>
              <p class="hoa-pc__price">{{ f[6] }}{% if f[7] != blank %} <s>{{ f[7] }}</s>{% endif %}</p>
              <p class="hoa-pc__about">{{ about }}</p>
              <div class="hoa-pc__action">
                <button type="button" class="hoa-pc__cta" data-hoa-add aria-label="Add {{ f[0] }} to bag"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 5.5h10l-.8 8H3.8L3 5.5ZM5.5 5.5V4.6a2.5 2.5 0 0 1 5 0v.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Add</span></button>
              </div>
            </div>
          </article>
          {%- if forloop.index == interlude_after -%}{{ interlude }}{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="hoa-shop-empty" data-hoa-empty hidden>
      <p class="hoa-shop-empty__title">{{ s.empty_title }}</p>
      <p class="hoa-shop-empty__text">{{ s.empty_text }}</p>
      <button type="button" class="hoa-btn" data-hoa-reset><span>Show all fragrances</span>{% render 'hoa-btn-icon' %}</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HOA Shop catalogue",
  "tag": "div",
  "class": "hoa-shop-cat-section",
  "settings": [
    { "type": "text", "id": "all_label", "label": "All tab", "default": "All" },
    { "type": "text", "id": "men_label", "label": "Men tab", "default": "Men" },
    { "type": "text", "id": "women_label", "label": "Women tab", "default": "Women" },
    { "type": "text", "id": "unisex_label", "label": "Unisex tab", "default": "Unisex" },
    { "type": "text", "id": "families", "label": "Scent families (comma separated)", "info": "Matched against the custom.family metafield or the product type.", "default": "Woody, Fresh, Floral, Aromatic" },
    { "type": "text", "id": "gift_label", "label": "Gift category label", "info": "Matched against the custom.gift metafield or a tag containing \"gift\".", "default": "Gift" },
    { "type": "header", "content": "Campaign photo in the grid" },
    { "type": "checkbox", "id": "show_interlude", "label": "Show photo after the third product", "default": true },
    { "type": "image_picker", "id": "interlude_image", "label": "Image" },
    { "type": "text", "id": "interlude_asset", "label": "Theme asset (when no image is picked)", "default": "hoa-world-poolside" },
    { "type": "text", "id": "interlude_alt", "label": "Alt text", "default": "Sea Smoke on a tray beside a pool" },
    { "type": "text", "id": "interlude_caption", "label": "Caption", "default": "Sea Smoke" },
    { "type": "text", "id": "interlude_note", "label": "Caption note", "default": "By the water" },
    { "type": "text", "id": "interlude_link", "label": "Link label", "default": "View" },
    { "type": "url", "id": "interlude_url", "label": "Link" },
    { "type": "header", "content": "No results" },
    { "type": "text", "id": "empty_title", "label": "Title", "default": "Nothing matches both filters." },
    { "type": "text", "id": "empty_text", "label": "Text", "default": "Try another scent family, or see every fragrance." }
  ],
  "presets": [{ "name": "HOA Shop catalogue" }]
}
{% endschema %}
