{% comment %}
  SHOP · Catalogue
  Every fragrance in the collection, filterable by wearer (Men / Women / Unisex), scent
  family and price, sortable, and shown as a grid or a list. The toolbar sticks under the header.
  Filtering happens in place (hoa-shop.js) and is mirrored in the URL (?for=, ?family=,
  ?price=, ?sort=, ?view=list) so a filtered view can be linked. Without JS every product is
  listed in the grid.

  Grid: three columns; one campaign photo (the interlude) spans two columns after the
  third product, so seven products fill three rows. It only shows in the unfiltered,
  featured view, where that arithmetic holds.

  Data per product:
    wearer  custom.gender metafield, else a tag named Men / Women / Unisex
            (also accepts "For Men", "gender:men" …)
    family  custom.family metafield, else the product type
  With no products in the collection (local preview, fresh store) the static House of
  Agha line-up below is listed instead.

  Cards: both branches render snippets/hoa-shop-card.liquid with the same plain values
  (regular price, sale price, rating, review count, best seller, availability), so swapping
  the mock line-up for Shopify data never touches the card markup. Price filter: a Price
  menu in the toolbar (preset ranges + custom min / max) filters on the selling price.
{% endcomment %}

{%- capture catalog_json -%}{%- render 'hoa-catalog-data' -%}{%- endcapture -%}
{%- liquid
  assign catalog = catalog_json | parse_json
  assign s = section.settings
  assign source = collection
  assign use_shopify = false
  if source != blank and source.products_count > 0
    assign use_shopify = true
  endif
  assign families = s.families | split: ','

  comment
    MOCK CATALOG (preview only; replaced by Shopify products once the collection has some).
    The one mock source for names, prices, offers, ratings and best sellers is
    snippets/hoa-catalog-data.liquid — the product page, bag and bundles read the same data, so a
    product shows the same price everywhere. Mapping to Shopify later: regularPrice <- compare_at_price
    or price, and salePrice <- price. The discount % is calculated by the card, never stored.
    Wearers are a first draft, confirm them before launch. Gift-ready is an unconfirmed
    merchandising guess, confirm the real set with the user before launch.
  endcomment
  assign interlude_after = 3
-%}

{%- capture interlude -%}
  {%- if s.show_interlude -%}
    <figure class="hoa-shop-interlude" data-hoa-interlude>
      <a class="hoa-shop-interlude__media" href="{{ s.interlude_url | default: '/products/sea-smoke' }}">
        {%- render 'hoa-img', name: s.interlude_asset, image: s.interlude_image, w: 1200, h: 1200, alt: s.interlude_alt, sizes: '(min-width: 1000px) 62vw, 100vw' -%}
      </a>
      <figcaption class="hoa-shop-interlude__cap">
        <p class="hoa-shop-interlude__name">{{ s.interlude_caption }}</p>
        <p class="hoa-shop-interlude__meta">{{ s.interlude_note }}</p>
        <p class="hoa-shop-interlude__link"><a href="{{ s.interlude_url | default: '/products/sea-smoke' }}">{{ s.interlude_link }}<span aria-hidden="true">&rarr;</span></a></p>
      </figcaption>
    </figure>
  {%- endif -%}
{%- endcapture -%}

<section class="hoa-shop-cat" id="catalog" data-hoa-shop>
  <div class="hoa-shop-bar" data-hoa-shop-bar>
    <div class="hoa-wrap hoa-shop-bar__inner">
      <div class="hoa-shop-bar__group hoa-shop-bar__group--for" role="group" aria-label="Filter by wearer">
        <button type="button" class="hoa-ftab" aria-pressed="true" data-hoa-for="all">{{ s.all_label }}<sup data-hoa-count="all"></sup></button>
        <button type="button" class="hoa-ftab" aria-pressed="false" data-hoa-for="men">{{ s.men_label }}<sup data-hoa-count="men"></sup></button>
        <button type="button" class="hoa-ftab" aria-pressed="false" data-hoa-for="women">{{ s.women_label }}<sup data-hoa-count="women"></sup></button>
        <button type="button" class="hoa-ftab" aria-pressed="false" data-hoa-for="unisex">{{ s.unisex_label }}<sup data-hoa-count="unisex"></sup></button>
      </div>

      <div class="hoa-shop-bar__group hoa-shop-bar__group--family" role="group" aria-label="Filter by scent family">
        <span class="hoa-shop-bar__label">Family</span>
        {%- for f in families -%}
          {%- assign fl = f | strip -%}
          <button type="button" class="hoa-ftag" aria-pressed="false" data-hoa-family="{{ fl | handleize }}">{{ fl }}</button>
        {%- endfor -%}
      </div>

      <div class="hoa-shop-bar__group hoa-shop-bar__group--gift" role="group" aria-label="Shop by occasion">
        <button type="button" class="hoa-ftag hoa-ftag--gift" aria-pressed="false" data-hoa-gift>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6.5h12v2H2zM3 8.5h10V14H3zM8 6.5V14M8 6.5C6.5 6.5 5.5 5.6 5.5 4.5S6.3 3 7 3.6C7.6 4.1 8 5 8 6.5ZM8 6.5c1.5 0 2.5-.9 2.5-2s-.8-1.5-1.5-.9C8.4 4.1 8 5 8 6.5Z" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ s.gift_label }}<sup data-hoa-count="gift"></sup>
        </button>
      </div>

      <div class="hoa-shop-bar__end">
        <div class="hoa-price" data-hoa-price>
          <button type="button" class="hoa-price__btn" aria-expanded="false" aria-controls="hoa-price-panel-{{ section.id }}" data-hoa-price-btn>
            <span data-hoa-price-label>Price</span>
            <svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="hoa-price__panel" id="hoa-price-panel-{{ section.id }}" data-hoa-price-panel hidden>
            <p class="hoa-price__title">Price</p>
            <div class="hoa-price__opts" role="group" aria-label="Price range">
              <button type="button" class="hoa-ftag" aria-pressed="true" data-hoa-price-opt="">Any price</button>
              <button type="button" class="hoa-ftag" aria-pressed="false" data-hoa-price-opt="0-1499">Under ₹1,500</button>
              <button type="button" class="hoa-ftag" aria-pressed="false" data-hoa-price-opt="1500-2499">₹1,500 &ndash; ₹2,500</button>
              <button type="button" class="hoa-ftag" aria-pressed="false" data-hoa-price-opt="2500-3999">₹2,500 &ndash; ₹4,000</button>
              <button type="button" class="hoa-ftag" aria-pressed="false" data-hoa-price-opt="4000-">Above ₹4,000</button>
            </div>
            <form class="hoa-price__custom" data-hoa-price-form novalidate>
              <label><span>Min</span><input type="number" inputmode="numeric" min="0" step="100" placeholder="₹ 0" data-hoa-price-min aria-label="Minimum price in rupees"></label>
              <span class="hoa-price__dash" aria-hidden="true">&ndash;</span>
              <label><span>Max</span><input type="number" inputmode="numeric" min="0" step="100" placeholder="₹ any" data-hoa-price-max aria-label="Maximum price in rupees"></label>
              <button type="submit" class="hoa-price__apply">Apply</button>
            </form>
          </div>
        </div>
        <label class="hoa-sort">
          <span class="hoa-shop-bar__label">Sort</span>
          <select data-hoa-sort>
            <option value="featured">Featured</option>
            <option value="az">A to Z</option>
            <option value="za">Z to A</option>
            <option value="price-asc">Price, low to high</option>
            <option value="price-desc">Price, high to low</option>
          </select>
        </label>
        <div class="hoa-fview" role="group" aria-label="Layout">
          <button type="button" class="hoa-fview__btn" aria-pressed="true" data-hoa-fview="grid" aria-label="Grid view">
            <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="5" height="5"/><rect x="9.5" y="1.5" width="5" height="5"/><rect x="1.5" y="9.5" width="5" height="5"/><rect x="9.5" y="9.5" width="5" height="5"/></svg>
          </button>
          <button type="button" class="hoa-fview__btn" aria-pressed="false" data-hoa-fview="list" aria-label="List view">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 3.5h13M1.5 8h13M1.5 12.5h13"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="hoa-wrap">
    <p class="hoa-shop-cat__status" aria-live="polite"><span data-hoa-shown></span><button type="button" class="hoa-shop-cat__clear" data-hoa-reset hidden>Clear filters</button></p>

    <div class="hoa-shop-grid" data-hoa-shop-grid data-view="grid">
      {%- if use_shopify -%}
        {%- for product in source.products -%}
          {%- liquid
            assign fam = product.metafields.custom.family.value | default: product.type
            assign wearer = product.metafields.custom.gender.value | downcase
            if wearer == blank
              for t in product.tags
                assign tl = t | downcase | remove: 'gender:' | remove: 'for ' | strip
                if tl == 'men' or tl == 'women' or tl == 'unisex'
                  assign wearer = tl
                  break
                endif
              endfor
            endif
            if wearer == 'man' or wearer == 'male' or wearer == 'him'
              assign wearer = 'men'
            elsif wearer == 'woman' or wearer == 'female' or wearer == 'her'
              assign wearer = 'women'
            endif
            assign wearer = wearer | default: 'unisex'
            assign variant = product.selected_or_first_available_variant
            assign mood = product.media[1].preview_image
            assign is_gift = false
            if product.metafields.custom.gift.value
              assign is_gift = true
            endif
            for t in product.tags
              if t contains 'gift' or t contains 'Gift'
                assign is_gift = true
              endif
            endfor

            comment
              Card values from Shopify. Reviews and best-seller are not wired yet: point
              rating_v / rating_count at a reviews app or metafields, and best at a tag or
              metafield. A blank rating leaves the review row empty.
            endcomment
            assign sale_rupees = product.price | divided_by: 100
            assign regular_rupees = ''
            assign regular_txt = ''
            if product.compare_at_price > product.price and product.price_varies == false
              assign regular_rupees = product.compare_at_price | divided_by: 100
              assign regular_txt = product.compare_at_price | money
            endif
            assign sale_txt = product.price | money
            if product.price_varies
              assign sale_txt = product.price_min | money | prepend: 'From '
            endif
            assign rating_v = product.metafields.reviews.rating.value.rating
            assign rating_count = product.metafields.reviews.rating_count.value
            assign best = false
            if product.tags contains 'best-seller' or product.tags contains 'Best Seller'
              assign best = true
            endif
            assign thumb = product.featured_media.preview_image | image_url: width: 240
          -%}
          {%- capture img_main -%}{%- if product.featured_media -%}{{ product.featured_media.preview_image | image_url: width: 900 | image_tag: widths: '300, 600, 900', sizes: '(min-width: 1000px) 30vw, 50vw', loading: 'lazy', alt: '' }}{%- endif -%}{%- endcapture -%}
          {%- capture img_mood -%}{%- if mood -%}{{ mood | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}{%- endcapture -%}
          {%- render 'hoa-shop-card',
            index: forloop.index0,
            handle: product.handle,
            url: product.url,
            name: product.title,
            family: fam,
            wearer: wearer,
            gift: is_gift,
            img_main: img_main,
            img_mood: img_mood,
            thumb: thumb,
            available: product.available,
            sale_price: sale_rupees,
            regular_price: regular_rupees,
            sale_text: sale_txt,
            regular_text: regular_txt,
            rating: rating_v,
            review_count: rating_count,
            best_seller: best,
            shopify_product: product,
            variant_id: variant.id
          -%}
          {%- if forloop.index == interlude_after -%}{{ interlude }}{%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for p in catalog.products -%}
          {%- liquid
            assign p_asset = 'hoa-product-' | append: p.asset
            assign m_asset = 'hoa-' | append: p.asset | append: '-portrait'
            assign thumb_file = p_asset | append: '-sm.webp'
            assign thumb = thumb_file | asset_url
            assign purl = '/products/' | append: p.handle
            assign sale_v = p.salePrice | default: p.regularPrice
            assign gift_v = p.gift | append: ''
            assign is_available = true
            if p.inventory == 0
              assign is_available = false
            endif
          -%}
          {%- capture img_main -%}{%- render 'hoa-img', name: p_asset, w: 1200, h: 1500, alt: '', sizes: '(min-width: 1000px) 30vw, 50vw' -%}{%- endcapture -%}
          {%- capture img_mood -%}{%- render 'hoa-img', name: m_asset, w: 1200, h: 1607, alt: '', sizes: '(min-width: 1000px) 30vw, 50vw' -%}{%- endcapture -%}
          {%- render 'hoa-shop-card',
            index: forloop.index0,
            handle: p.handle,
            url: purl,
            name: p.name,
            family: p.family,
            wearer: p.wearer,
            gift: gift_v,
            img_main: img_main,
            img_mood: img_mood,
            thumb: thumb,
            available: is_available,
            sale_price: sale_v,
            regular_price: p.regularPrice,
            rating: p.rating,
            review_count: p.reviewCount,
            best_seller: p.isBestSeller,
            product_id: p.handle
          -%}
          {%- if forloop.index == interlude_after -%}{{ interlude }}{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="hoa-shop-empty" data-hoa-empty hidden>
      <p class="hoa-shop-empty__title">{{ s.empty_title }}</p>
      <p class="hoa-shop-empty__text">{{ s.empty_text }}</p>
      <button type="button" class="hoa-btn" data-hoa-reset><span>Show all fragrances</span>{% render 'hoa-btn-icon' %}</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HOA Shop catalogue",
  "tag": "div",
  "class": "hoa-shop-cat-section",
  "settings": [
    { "type": "text", "id": "all_label", "label": "All tab", "default": "All" },
    { "type": "text", "id": "men_label", "label": "Men tab", "default": "Men" },
    { "type": "text", "id": "women_label", "label": "Women tab", "default": "Women" },
    { "type": "text", "id": "unisex_label", "label": "Unisex tab", "default": "Unisex" },
    { "type": "text", "id": "families", "label": "Scent families (comma separated)", "info": "Matched against the custom.family metafield or the product type.", "default": "Woody, Fresh, Floral, Aromatic" },
    { "type": "text", "id": "gift_label", "label": "Gift category label", "info": "Matched against the custom.gift metafield or a tag containing \"gift\".", "default": "Gift" },
    { "type": "header", "content": "Campaign photo in the grid" },
    { "type": "checkbox", "id": "show_interlude", "label": "Show photo after the third product", "default": true },
    { "type": "image_picker", "id": "interlude_image", "label": "Image" },
    { "type": "text", "id": "interlude_asset", "label": "Theme asset (when no image is picked)", "default": "hoa-world-poolside" },
    { "type": "text", "id": "interlude_alt", "label": "Alt text", "default": "Sea Smoke on a tray beside a pool" },
    { "type": "text", "id": "interlude_caption", "label": "Caption", "default": "Sea Smoke" },
    { "type": "text", "id": "interlude_note", "label": "Caption note", "default": "By the water" },
    { "type": "text", "id": "interlude_link", "label": "Link label", "default": "View" },
    { "type": "url", "id": "interlude_url", "label": "Link" },
    { "type": "header", "content": "No results" },
    { "type": "text", "id": "empty_title", "label": "Title", "default": "Nothing matches both filters." },
    { "type": "text", "id": "empty_text", "label": "Text", "default": "Try another scent family, or see every fragrance." }
  ],
  "presets": [{ "name": "HOA Shop catalogue" }]
}
{% endschema %}
