        <div>
          <span class="editorial-label">BY NOTES</span>
          <h3 class="font-serif" style="font-size: 1.8rem; margin-top: 8px;">OUD & SMOKE</h3>
          <p class="text-muted" style="font-size: 0.85rem; margin-top: 8px;">Cambodian Agarwood, Birch Tar, Resins.</p>
        </div>
