        </div>
        <a href="/collections/all" class="btn-secondary" style="padding: 10px 16px; font-size: 0.65rem;">EXPLORE EVENING →</a>
      </div>

      <div style="border: 1px solid var(--color-border); padding: var(--space-xl); background: var(--color-near-black); display: flex; flex-direction: column; justify-content: space-between; height: 320px;">
