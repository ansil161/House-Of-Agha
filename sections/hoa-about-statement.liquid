{%- comment -%}
  House of Agha · About 02 · Statement
  One centred paragraph. On scroll each word brightens in reading order
  (assets/hoa-about.js splits the words; without JS it is plain text).
  Wrap words in *asterisks* to set them in serif italic.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign parts = s.statement | escape | split: '*'
-%}
<section class="hoa-ab-statement">
  <div class="hoa-wrap">
    <p class="hoa-ab-statement__text" data-hoa-ab-words>
      {%- for part in parts -%}
        {%- assign odd = forloop.index0 | modulo: 2 -%}
        {%- if odd == 1 -%}<em>{{ part }}</em>{%- else -%}{{ part }}{%- endif -%}
      {%- endfor -%}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "About: statement",
  "tag": "div",
  "class": "hoa-ab-section",
  "settings": [
    { "type": "textarea", "id": "statement", "label": "Statement", "info": "Wrap words in *asterisks* to set them in serif italic.", "default": "We start with a *place*: a smoke-lit room, an ice cave, a palace garden. Then we build the scent, the bottle and the photograph around it, so each fragrance feels like *somewhere you have been*." }
  ],
  "presets": [{ "name": "About: statement" }]
}
{% endschema %}
