{%- comment -%}
  Home V2 · 02 The House — one statement, one photograph, three principles.
  Copy is the homepage's existing House statement (sections/hoa-manifesto.liquid defaults).
{%- endcomment -%}
{%- render 'hoa-v2-assets' -%}
{%- assign s = section.settings -%}
<section class="v2-house v2-pad" id="the-house">
  <div class="v2-wrap v2-house__grid">
    <p class="v2-eyebrow v2-house__eyebrow" data-v2-reveal><span>02</span>{{ s.eyebrow }}</p>

    <h2 class="v2-house__statement" data-v2-lines>
      {%- assign parts = s.statement | split: '*' -%}
      {%- for part in parts -%}{%- assign odd = forloop.index0 | modulo: 2 -%}{% if odd == 1 %}<em>{{ part }}</em>{% else %}{{ part }}{% endif %}{%- endfor -%}
    </h2>

    <figure class="v2-house__photo" data-v2-reveal>
      <div class="v2-house__photo-inner" data-v2-drift>
        {%- render 'hoa-img', name: s.photo_asset, image: s.photo, w: 1088, h: 1445, alt: s.photo_alt, sizes: '(min-width: 768px) 26vw, 70vw' -%}
      </div>
      {%- if s.photo_caption != blank -%}<figcaption>{{ s.photo_caption }}</figcaption>{%- endif -%}
    </figure>

    <div class="v2-house__side" data-v2-reveal>
      <p class="v2-house__body">{{ s.body }}</p>
      <a class="v2-link" href="{{ s.link_url | default: '/pages/the-house' }}"><span>{{ s.link_label }}</span><span class="v2-link__arrow" aria-hidden="true">&rarr;</span></a>
    </div>

    <ol class="v2-house__principles" data-v2-stagger>
      {%- for i in (1..3) -%}
        {%- capture tk -%}note_{{ i }}_title{%- endcapture -%}
        {%- capture xk -%}note_{{ i }}_text{%- endcapture -%}
        <li><span class="v2-house__n">0{{ i }}</span><strong>{{ s[tk] }}</strong><span>{{ s[xk] }}</span></li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "V2 · The House",
  "class": "v2-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Tag", "default": "The House" },
    { "type": "textarea", "id": "statement", "label": "Statement", "info": "Wrap words in *asterisks* for serif italic.", "default": "Every Agha fragrance begins as a *place*: a smoke-lit room, an ice cave, a garden after rain. It ends as something you *carry close*." },
    { "type": "textarea", "id": "body", "label": "Supporting line", "default": "House of Agha composes eaux de parfum around a single world at a time, and dresses each one in its own bottle, colour and light." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "The story of the House" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "image_picker", "id": "photo", "label": "Photograph" },
    { "type": "text", "id": "photo_asset", "label": "Theme asset (fallback)", "default": "hoa-family-green" },
    { "type": "text", "id": "photo_alt", "label": "Alt text", "default": "Tobacco Enigma on moss in a sunlit forest" },
    { "type": "text", "id": "photo_caption", "label": "Caption", "default": "Tobacco Enigma, in the green" },
    { "type": "text", "id": "note_1_title", "label": "Principle 1", "default": "One world" },
    { "type": "text", "id": "note_1_text", "label": "Principle 1 line", "default": "Each fragrance is composed around a single place." },
    { "type": "text", "id": "note_2_title", "label": "Principle 2", "default": "Its own light" },
    { "type": "text", "id": "note_2_text", "label": "Principle 2 line", "default": "A bottle, colour and mood made for that world alone." },
    { "type": "text", "id": "note_3_title", "label": "Principle 3", "default": "Worn close" },
    { "type": "text", "id": "note_3_text", "label": "Principle 3 line", "default": "Eaux de parfum meant to stay near the skin." }
  ],
  "presets": [{ "name": "V2 · The House" }]
}
{% endschema %}
