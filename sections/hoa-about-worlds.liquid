{%- comment -%}
  House of Agha · About 03 · The seven worlds
  Desktop: the section pins and the row of fragrances pans sideways with scroll
  (GSAP ScrollTrigger in assets/hoa-about.js). Touch / narrow screens and reduced
  motion: a native scroll-snap row. Each block is one fragrance.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="hoa-ab-worlds" id="worlds" data-hoa-ab-worlds>
  <div class="hoa-ab-worlds__pin" data-hoa-ab-pin>
    <div class="hoa-wrap hoa-ab-worlds__head">
      <h2 class="hoa-h2">{{ s.heading }}{% if s.heading_serif != blank %} <em>{{ s.heading_serif }}</em>{% endif %}</h2>
      {%- if s.text != blank -%}<p class="hoa-lede">{{ s.text }}</p>{%- endif -%}
    </div>

    <div class="hoa-ab-worlds__viewport">
      <ol class="hoa-ab-worlds__track" data-hoa-ab-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign p = b.product
            if p != blank
              assign w_name = p.title
              assign w_url = p.url
            else
              assign w_name = b.name
              assign w_url = b.url | default: routes.all_products_collection_url
            endif
          -%}
          <li class="hoa-ab-world" style="--hoa-tint: {{ b.tint | default: '#2b241d' }};" {{ block.shopify_attributes }}>
            <a class="hoa-ab-world__link" href="{{ w_url }}">
              <figure class="hoa-ab-world__media">
                {%- render 'hoa-img', name: b.asset, image: b.image, w: 1200, h: 1607, alt: b.alt, sizes: '(min-width: 900px) 26vw, 72vw' -%}
              </figure>
              <div class="hoa-ab-world__body">
                <p class="hoa-ab-world__family">{{ b.family }}</p>
                <h3 class="hoa-ab-world__name">{{ w_name }}</h3>
                <p class="hoa-ab-world__line">{{ b.line }}</p>
                <span class="hoa-ab-world__cta">Discover {% render 'hoa-btn-icon' %}</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About: fragrances row",
  "tag": "div",
  "class": "hoa-ab-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "One house," },
    { "type": "text", "id": "heading_serif", "label": "Heading, serif part", "default": "seven worlds." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every fragrance has its own setting, colour and bottle. Choose one to see it up close." }
  ],
  "blocks": [
    {
      "type": "world",
      "name": "Fragrance",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Uses the product title and link. Leave empty to use the fields below." },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "text", "id": "family", "label": "Scent family" },
        { "type": "textarea", "id": "line", "label": "One line" },
        { "type": "image_picker", "id": "image", "label": "Image (portrait)" },
        { "type": "text", "id": "asset", "label": "Fallback theme asset" },
        { "type": "text", "id": "alt", "label": "Image alt text" },
        { "type": "color", "id": "tint", "label": "Card tint", "default": "#2b241d" }
      ]
    }
  ],
  "presets": [{ "name": "About: fragrances row" }]
}
{% endschema %}
