{%- comment -%}
  House of Agha · About 03 · The seven worlds

  Wide screens (768px+): the section pins behind a pair of carved palace doors (.hoa-ab-gate).
  The first scroll swings them open; then vertical scroll pans the canvas sideways while each
  world comes into focus at the centre (GSAP ScrollTrigger, assets/hoa-about.js ->
  initSevenWorlds). Phones: the worlds stack and each one settles into view as you scroll. Reduced motion / no JS: the same stack, static and complete.

  Every block is one world (one fragrance). Nothing here is hard-coded: the number is the
  block's position (or the "Number" override), the total is the block count, the name and link
  come from the picked product (or the text fields), the image from the image picker (or the
  fallback theme asset), the tint from the colour setting.

  Hyderabad dress (2026-09-28): the canvas is a night arcade. Each photograph sits inside a
  Qutb Shahi pointed arch with a brass arch outline around it (drawn in when the world is in
  focus), a faint jaali lattice covers the stage, a line skyline of the city (Charminar, the
  Qutb Shahi tombs, Golconda's wall; assets/hoa-skyline.svg) drifts slower than the canvas,
  the world number is repeated large in Urdu numerals, and progress is a string of pearls.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign total = section.blocks.size
  assign total_label = total
  if total < 10
    assign total_label = total | prepend: '0'
  endif
-%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@500&display=swap&text=%DB%B0%DB%B1%DB%B2%DB%B3%DB%B4%DB%B5%DB%B6%DB%B7%DB%B8%DB%B9">
<section class="hoa-ab-worlds" id="worlds" data-hoa-ab-worlds aria-labelledby="worlds-{{ section.id }}-title">
  <div class="hoa-ab-worlds__pin" data-hoa-ab-pin>
    <span class="hoa-ab-worlds__jaali" aria-hidden="true"></span>
    <span class="hoa-ab-worlds__skyline" aria-hidden="true" data-hoa-ab-skyline></span>
    <div class="hoa-ab-gate" aria-hidden="true" data-hoa-ab-gate>
      <span class="hoa-ab-gate__leaf hoa-ab-gate__leaf--l" data-hoa-ab-leaf="l"></span>
      <span class="hoa-ab-gate__leaf hoa-ab-gate__leaf--r" data-hoa-ab-leaf="r"></span>
      <div class="hoa-ab-gate__copy" data-hoa-ab-gate-copy>
        <span class="hoa-ab-gate__seal">
          <svg viewBox="0 0 52 52" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round"><rect x="12" y="12" width="28" height="28"/><rect x="12" y="12" width="28" height="28" transform="rotate(45 26 26)"/><circle cx="26" cy="26" r="8"/><circle cx="26" cy="26" r="2.2" fill="currentColor"/></svg>
        </span>
        {%- if s.gate_kicker != blank -%}<p class="hoa-ab-gate__kicker">{{ s.gate_kicker }}</p>{%- endif -%}
        {%- if s.gate_title != blank -%}<p class="hoa-ab-gate__title">{{ s.gate_title }}</p>{%- endif -%}
        {%- if s.gate_hint != blank -%}<p class="hoa-ab-gate__hint">{{ s.gate_hint }}</p>{%- endif -%}
      </div>
    </div>
    <header class="hoa-wrap hoa-ab-worlds__head">
      <div class="hoa-ab-worlds__intro">
        {%- if s.chip != blank -%}<p class="hoa-ab-worlds__chip"><span aria-hidden="true"></span>{{ s.chip }}</p>{%- endif -%}
        <h2 class="hoa-ab-h2" id="worlds-{{ section.id }}-title">{{ s.heading }}{% if s.heading_serif != blank %} <span class="hoa-ab-muted">{{ s.heading_serif }}</span>{% endif %}</h2>
        {%- if s.text != blank -%}<p class="hoa-ab-sub">{{ s.text }}</p>{%- endif -%}
      </div>
      {%- if total > 1 -%}
        <nav class="hoa-ab-worlds__pearls" aria-label="Worlds" data-hoa-ab-pearls>
          <ol>
            {%- for block in section.blocks -%}
              {%- assign pearl_name = block.settings.product.title | default: block.settings.name -%}
              <li><button type="button" class="hoa-ab-pearl" data-hoa-ab-pearl="{{ forloop.index0 }}" aria-label="Go to {{ pearl_name | escape }}"></button></li>
            {%- endfor -%}
          </ol>
        </nav>
      {%- endif -%}
    </header>

    <div class="hoa-ab-worlds__viewport">
      <ol class="hoa-ab-worlds__track" data-hoa-ab-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign p = b.product
            if p != blank
              assign w_name = p.title
              assign w_url = p.url
            else
              assign w_name = b.name
              assign w_url = b.url | default: routes.all_products_collection_url
            endif
            assign w_no = b.number
            if w_no == blank
              assign w_no = forloop.index
              if forloop.index < 10
                assign w_no = w_no | prepend: '0'
              endif
            endif
            assign variant_i = forloop.index0 | modulo: 3
            assign variant = 'a'
            if variant_i == 1
              assign variant = 'b'
            elsif variant_i == 2
              assign variant = 'c'
            endif
            assign long_name = false
            assign name_size = w_name | size
            if name_size > 12
              assign long_name = true
            endif
            assign cta = b.cta_label | default: 'Discover'
            assign alt_text = b.alt | default: w_name
            assign eager = 'lazy'
            if forloop.first
              assign eager = 'eager'
            endif
            assign w_no_ur = w_no | append: '' | replace: '0', '۰' | replace: '1', '۱' | replace: '2', '۲' | replace: '3', '۳' | replace: '4', '۴' | replace: '5', '۵' | replace: '6', '۶' | replace: '7', '۷' | replace: '8', '۸' | replace: '9', '۹'
          -%}
          <li class="hoa-ab-world{% if long_name %} hoa-ab-world--long{% endif %}" data-hoa-ab-world data-variant="{{ variant }}" data-tint="{{ b.tint | default: '#2b241d' }}" style="--hoa-tint: {{ b.tint | default: '#2b241d' }};" {{ block.shopify_attributes }}>
            <a class="hoa-ab-world__media" href="{{ w_url }}" tabindex="-1" data-hoa-ab-media>
              <span class="hoa-ab-world__frame">
                {%- render 'hoa-img', name: b.asset, image: b.image, w: 1200, h: 1607, alt: alt_text, sizes: '(min-width: 768px) 44vh, 92vw', loading: eager, class: 'hoa-ab-world__img' -%}
              </span>
              <svg class="hoa-ab-world__arch" viewBox="0 0 100 125" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M0 125 V44 C0 22 28 9 50 0 C72 9 100 22 100 44 V125"/></svg>
            </a>
            <div class="hoa-ab-world__body" data-hoa-ab-body>
              <span class="hoa-ab-world__ur" lang="ur" aria-hidden="true">{{ w_no_ur }}</span>
              <p class="hoa-ab-world__kicker" data-hoa-ab-meta>World {{ w_no }} <span>/ {{ total_label }}</span></p>
              <h3 class="hoa-ab-world__name" data-hoa-ab-title><a href="{{ w_url }}">{{ w_name }}</a></h3>
              <p class="hoa-ab-world__meta" data-hoa-ab-meta>
                {%- if b.location != blank -%}<span>{{ b.location }}</span>{%- endif -%}
                {%- if b.family != blank -%}<span>{{ b.family }}</span>{%- endif -%}
              </p>
              {%- if b.line != blank -%}<p class="hoa-ab-world__line" data-hoa-ab-meta>{{ b.line }}</p>{%- endif -%}
              <a class="hoa-ab-world__cta" href="{{ w_url }}" data-hoa-ab-meta aria-label="{{ cta }}: {{ w_name | escape }}">
                <span>{{ cta }}</span>
                <span class="hoa-ab-world__cta-ic" aria-hidden="true"><svg viewBox="0 0 24 8" fill="none"><path d="M0 4h22M18.5 1L22 4l-3.5 3" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </a>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About: seven worlds",
  "tag": "div",
  "class": "hoa-ab-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "chip", "label": "Label", "default": "Seven worlds · One city" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One house," },
    { "type": "text", "id": "heading_serif", "label": "Heading, muted part", "default": "seven worlds." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every fragrance has its own setting, colour and bottle. Scroll to travel through them." },
    { "type": "header", "content": "Palace doors (desktop entrance)" },
    { "type": "text", "id": "gate_kicker", "label": "Small label", "default": "House of Agha · Hyderabad" },
    { "type": "text", "id": "gate_title", "label": "Title on the doors", "default": "Enter the seven worlds" },
    { "type": "text", "id": "gate_hint", "label": "Hint", "default": "Scroll to open" }
  ],
  "blocks": [
    {
      "type": "world",
      "name": "World",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "info": "Leave empty to number worlds by their order (01, 02 ...)." },
        { "type": "product", "id": "product", "label": "Product", "info": "Uses the product title and link. Leave empty to use the fields below." },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "location", "label": "Location / setting (small label)" },
        { "type": "text", "id": "family", "label": "Scent family" },
        { "type": "textarea", "id": "line", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Image (portrait)" },
        { "type": "text", "id": "asset", "label": "Fallback theme asset" },
        { "type": "text", "id": "alt", "label": "Image alt text" },
        { "type": "color", "id": "tint", "label": "Accent colour", "default": "#2b241d", "info": "Tints the section background very lightly while this world is in focus." },
        { "type": "text", "id": "cta_label", "label": "Link text", "default": "Discover" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "About: seven worlds" }]
}
{% endschema %}
