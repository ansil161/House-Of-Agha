{% comment %}
  01 — HOUSE OF AGHA · CINEMATIC HERO
  Full-viewport campaign sequence (one "slide" block per fragrance world) with the
  house name split around the bottle. Slides crossfade on a slow timer, the words
  rise in on load, and the frame drifts back as the page scrolls (assets/hoa-home.js).
  Reduced motion: first slide only, no timer.
  Imagery: House of Agha campaign photography (Drive → assets/hoa-hero-*.webp).

  Scroll journey (one bottle, start to finish): on the slide with "Lift the bottle" on
  (Oud Fury, first), the backdrop is the same photo with the bottle painted out
  (<asset>-plate), and the photo's OWN bottle, cut from that exact frame
  (<asset>-bottle), sits back in place on top, with the wood chip that stands in front of
  its glass laid over it again (<asset>-chip). At rest this is pixel-identical to the
  photo. assets/hoa-home.js (initHeroBottleJourney) then scroll-drives that single
  [data-hoa-hero-bottle] element down into the first Signature Fragrances card.
  Files are made by tools/hero-bottle/lift.py, which also prints the lift boxes.
  While the journey runs, the slides don't auto-advance: the first-screen bottle is locked.
{% endcomment %}

{%- assign s = section.settings -%}
<section class="hoa-hero{% if s.static %} hoa-hero--static{% endif %}" id="hoa-hero" data-hoa-hero{% if s.static %} data-hoa-hero-static{% endif %} data-interval="{{ s.interval | times: 1000 }}" aria-roledescription="carousel" aria-label="{{ s.word_one }} {{ s.word_two }}">
  <div class="hoa-hero__media" data-hoa-hero-media>
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign load = 'lazy'
        if forloop.first
          assign load = 'eager'
        endif
      -%}
      {%- if forloop.first and b.lift_bottle -%}
        {%- liquid
          assign lb = b.lift_box | split: ','
          assign lbm = b.lift_box_mobile | split: ','
          assign plate = b.asset | append: '-plate'
        -%}
        <figure class="hoa-hero__slide hoa-hero__slide--lift is-active" data-hoa-slide
          style="--lift-x: {{ lb[0] }}%; --lift-y: {{ lb[1] }}%; --lift-w: {{ lb[2] }}%; --lift-h: {{ lb[3] }}%; --lift-xm: {{ lbm[0] }}%; --lift-ym: {{ lbm[1] }}%; --lift-wm: {{ lbm[2] }}%; --lift-hm: {{ lbm[3] }}%;"
          {{ block.shopify_attributes }}>
          <div class="hoa-hero__frame">
            <picture>
              <source media="(max-width: 767px)" srcset="{{ b.asset_mobile | append: '-plate-sm.webp' | asset_url }} 700w, {{ b.asset_mobile | append: '-plate.webp' | asset_url }} 1200w" sizes="100vw">
              {%- render 'hoa-img', name: plate, w: 2000, h: 1125, alt: b.alt, sizes: '100vw', loading: 'eager', priority: true -%}
            </picture>
            <div class="hoa-hero__lift-slot" data-hoa-hero-bottle-slot>
              <div class="hoa-hero__lift" data-hoa-hero-bottle>
                <picture>
                  <source media="(max-width: 767px)" srcset="{{ b.asset_mobile | append: '-bottle.webp' | asset_url }}">
                  <img src="{{ b.asset | append: '-bottle.webp' | asset_url }}" width="480" height="1272" alt="" decoding="async" fetchpriority="high" draggable="false">
                </picture>
              </div>
            </div>
            <picture class="hoa-hero__lift-chip" data-hoa-hero-chip>
              <source media="(max-width: 767px)" srcset="{{ b.asset_mobile | append: '-chip.webp' | asset_url }}">
              <img src="{{ b.asset | append: '-chip.webp' | asset_url }}" width="480" height="1272" alt="" decoding="async">
            </picture>
          </div>
        </figure>
      {%- else -%}
        <figure class="hoa-hero__slide{% if forloop.first %} is-active{% endif %}" data-hoa-slide {{ block.shopify_attributes }}>
          <picture>
            {%- if b.image_mobile != blank -%}
              <source media="(max-width: 767px)" srcset="{{ b.image_mobile | image_url: width: 1200 }}">
            {%- elsif b.asset_mobile != blank -%}
              <source media="(max-width: 767px)" srcset="{{ b.asset_mobile | append: '-sm.webp' | asset_url }} 700w, {{ b.asset_mobile | append: '.webp' | asset_url }} 1200w" sizes="100vw">
            {%- endif -%}
            {%- if forloop.first -%}
              {%- render 'hoa-img', name: b.asset, image: b.image, w: 2000, h: 1125, alt: b.alt, sizes: '100vw', loading: load, priority: true -%}
            {%- else -%}
              {%- render 'hoa-img', name: b.asset, image: b.image, w: 2000, h: 1125, alt: b.alt, sizes: '100vw', loading: load -%}
            {%- endif -%}
          </picture>
        </figure>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="hoa-hero__veil" aria-hidden="true"></div>

  <div class="hoa-hero__content">
    {%- if s.show_crest -%}
      {%- comment -%} The House seal: the client's 3D Agha crest, top right, opposite the eyebrow (assets/hoa-crest.js) {%- endcomment -%}
      {%- assign crest_src = s.crest_model_url | default: 'agha-crest.glb' -%}
      {%- unless crest_src contains '/' -%}{%- assign crest_src = crest_src | asset_url -%}{%- endunless -%}
      <div class="hoa-hero__crest" data-hoa-crest data-src="{{ crest_src }}">
        <canvas aria-hidden="true"></canvas>
        <button type="button" class="hoa-hero__crest-hit" data-hoa-crest-hit aria-label="Spin the House of Agha crest"></button>
      </div>
    {%- endif -%}
    <p class="hoa-eyebrow hoa-hero__eyebrow" data-hoa-hero-fade>{{ s.eyebrow }}</p>

    <h1 class="hoa-hero__title">
      <span class="hoa-hero__word"><span data-hoa-hero-word>{{ s.word_one }}</span></span>
      <span class="hoa-hero__word hoa-hero__word--serif"><span data-hoa-hero-word>{{ s.word_two }}</span></span>
    </h1>

    <div class="hoa-hero__foot">
      <p class="hoa-hero__lede" data-hoa-hero-fade>{{ s.lede }}</p>
      <a href="{{ s.cta_url | default: '#fragrances' }}" class="hoa-btn hoa-btn--glass hoa-hero__cta" data-hoa-hero-fade>
        <span>{{ s.cta_label }}</span>{% render 'hoa-btn-icon' %}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HOA Hero",
  "tag": "div",
  "class": "hoa-hero-section",
  "limit": 1,
  "max_blocks": 5,
  "settings": [
    { "type": "checkbox", "id": "show_crest", "label": "3D Agha crest", "default": true, "info": "The gold Agha crest, top right. It sways slowly and tilts toward the cursor." },
    { "type": "text", "id": "crest_model_url", "label": "Crest model (.glb) URL", "info": "Leave empty to use agha-crest.glb from theme assets. If the theme upload rejects .glb, upload it under Content > Files and paste its URL here." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Eau de Parfum · Seven fragrances" },
    { "type": "text", "id": "word_one", "label": "Headline, left word", "default": "House" },
    { "type": "text", "id": "word_two", "label": "Headline, right word (serif)", "default": "of Agha" },
    { "type": "textarea", "id": "lede", "label": "Short line", "default": "Seven fragrances, each one a world of its own." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Explore the fragrances" },
    { "type": "url", "id": "cta_url", "label": "Button link (defaults to the fragrances section)" },
    { "type": "checkbox", "id": "static", "label": "Static hero (no motion)", "default": true, "info": "First slide only: no crossfade, entrance, scroll drift or bottle journey. Use with the HOA Scroll Film section below it." },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 4, "max": 12, "step": 1, "default": 7 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "name", "label": "Fragrance name" },
        { "type": "image_picker", "id": "image", "label": "Desktop image (16:9)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (4:5 or taller)" },
        { "type": "text", "id": "asset", "label": "Theme asset (when no image is picked)", "info": "Base name without extension, e.g. hoa-hero-oud-fury" },
        { "type": "text", "id": "asset_mobile", "label": "Theme asset, mobile" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "checkbox", "id": "lift_bottle", "label": "Lift the bottle (first slide only)", "default": false, "info": "Needs <asset>-plate / -bottle / -chip files from tools/hero-bottle/lift.py. The bottle then travels into the first Signature Fragrances card on scroll." },
        { "type": "text", "id": "lift_box", "label": "Bottle box, desktop art", "info": "left,top,width,height in % of the photo (printed by lift.py)" },
        { "type": "text", "id": "lift_box_mobile", "label": "Bottle box, mobile art" }
      ]
    }
  ],
  "presets": [{ "name": "HOA Hero" }]
}
{% endschema %}
