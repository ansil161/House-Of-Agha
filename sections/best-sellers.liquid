{% comment %}
  06 — BEST SELLERS
{% endcomment %}

<section class="section-padding border-top-thin" id="best-sellers">
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--space-xl);" class="gsap-reveal">
      <div>
        <span class="editorial-label">06 — CURATED SELECTION</span>
        <h2 class="headline-section font-serif" style="margin-top: 12px;">BESTSELLERS</h2>
      </div>
      <a href="#signature" class="btn-secondary">VIEW ALL FRAGRANCES →</a>
    </div>

    <div class="grid-4 gsap-reveal">
      <!-- Product 1 -->
      <div class="product-card" data-product-id="p1" data-title="OUD ROYAL" data-price="₹14,500" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/bestseller_oud_royal.jpg" data-description="A resinous composition built around aged Cambodian oud, pink pepper, black rose, and dark leather.">
        <div class="product-card-media">
          <img src="{{ 'bestseller_oud_royal.jpg' | asset_url }}" alt="Oud Royal">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <div>
            <span class="product-meta">EXTRAIT DE PARFUM</span>
            <h3 class="product-title">OUD ROYAL</h3>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
            <span class="product-price">₹14,500</span>
            <button class="btn-secondary js-add-to-cart" data-title="OUD ROYAL" data-price="₹14,500" data-image="assets/bestseller_oud_royal.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>

      <!-- Product 2 -->
      <div class="product-card" data-product-id="p2" data-title="VELVET IRIS" data-price="₹13,200" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/hero_perfume_bottle.jpg" data-description="An ethereal suede iris fused with white amber and Florentine violet leaves.">
        <div class="product-card-media">
          <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="Velvet Iris" style="filter: grayscale(80%);">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <div>
            <span class="product-meta">EXTRAIT DE PARFUM</span>
            <h3 class="product-title">VELVET IRIS</h3>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
            <span class="product-price">₹13,200</span>
            <button class="btn-secondary js-add-to-cart" data-title="VELVET IRIS" data-price="₹13,200" data-image="assets/hero_perfume_bottle.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>

      <!-- Product 3 -->
      <div class="product-card" data-product-id="p3" data-title="SANTAL NOCTURNE" data-price="₹15,000" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/bestseller_oud_royal.jpg" data-description="Australian sandalwood, smoked papyrus, and bourbon vanilla extract.">
        <div class="product-card-media">
          <img src="{{ 'bestseller_oud_royal.jpg' | asset_url }}" alt="Santal Nocturne" style="filter: contrast(1.2);">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <div>
            <span class="product-meta">EXTRAIT DE PARFUM</span>
            <h3 class="product-title">SANTAL NOCTURNE</h3>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
            <span class="product-price">₹15,000</span>
            <button class="btn-secondary js-add-to-cart" data-title="SANTAL NOCTURNE" data-price="₹15,000" data-image="assets/bestseller_oud_royal.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>

      <!-- Product 4 -->
      <div class="product-card" data-product-id="p4" data-title="AMBER ABSOLUTE" data-price="₹16,500" data-meta="50 ML · EXTRAIT DE PARFUM" data-image="assets/hero_perfume_bottle.jpg" data-description="Golden Baltic resin, benzoin tear drops, and crushed Madagascar clove.">
        <div class="product-card-media">
          <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="Amber Absolute">
          <div class="product-card-quick-add">
            <button class="btn-primary js-quick-view" style="padding: 10px 20px; font-size: 0.65rem;">QUICK VIEW</button>
          </div>
        </div>
        <div class="product-card-body">
          <div>
            <span class="product-meta">EXTRAIT DE PARFUM</span>
            <h3 class="product-title">AMBER ABSOLUTE</h3>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
            <span class="product-price">₹16,500</span>
            <button class="btn-secondary js-add-to-cart" data-title="AMBER ABSOLUTE" data-price="₹16,500" data-image="assets/hero_perfume_bottle.jpg" style="padding: 8px 14px; font-size: 0.65rem;">+ BAG</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
