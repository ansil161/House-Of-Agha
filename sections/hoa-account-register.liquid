{% comment %}
  ACCOUNT · Create account (templates/customers/register.json)
  Posts Shopify's 'create_customer' form. Shopify validates, creates the customer,
  runs its own bot protection when enabled, then signs the customer in.
{% endcomment %}

{%- assign s = section.settings -%}
<section class="hoa-auth">
  <div class="hoa-auth__main">
    <div class="hoa-auth__inner">
      <div class="hoa-auth__panel">
        <header class="hoa-auth__head">
          <p class="hoa-auth__crumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>Account</p>
          <h1 class="hoa-auth__title">{{ s.heading }} <em>{{ s.heading_italic }}</em></h1>
          {%- if s.text != blank -%}<p class="hoa-auth__lede">{{ s.text }}</p>{%- endif -%}
        </header>

        {%- form 'create_customer', class: 'hoa-form', novalidate: 'novalidate' -%}
          {%- liquid
            render 'hoa-form-errors', errors: form.errors, id: 'RegisterErrors'
            assign email_invalid = false
            assign password_invalid = false
            if form.errors contains 'email'
              assign email_invalid = true
            endif
            if form.errors contains 'password'
              assign password_invalid = true
            endif
          -%}
          <div class="hoa-form__pair">
            {%- render 'hoa-field',
              id: 'RegisterFirstName',
              name: 'customer[first_name]',
              label: 'First name',
              value: form.first_name,
              autocomplete: 'given-name'
            -%}
            {%- render 'hoa-field',
              id: 'RegisterLastName',
              name: 'customer[last_name]',
              label: 'Last name',
              value: form.last_name,
              autocomplete: 'family-name'
            -%}
          </div>
          {%- render 'hoa-field',
            id: 'RegisterEmail',
            name: 'customer[email]',
            type: 'email',
            label: 'Email',
            value: form.email,
            autocomplete: 'email',
            required: true,
            invalid: email_invalid
          -%}
          {%- render 'hoa-field',
            id: 'RegisterPassword',
            name: 'customer[password]',
            type: 'password',
            label: 'Password',
            autocomplete: 'new-password',
            required: true,
            invalid: password_invalid,
            hint: 'At least 5 characters.'
          -%}
          <button class="hoa-btn hoa-btn--block" type="submit" data-hoa-submit data-loading-label="Creating account">
            <span data-label>Create account</span>{% render 'hoa-btn-icon' %}
          </button>
        {%- endform -%}

        <p class="hoa-auth__alt">Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a></p>
      </div>
    </div>
  </div>

  {%- render 'hoa-auth-media',
    image: s.image,
    name: 'hoa-world-gift',
    alt: 'Agha Blue in its gift box among peonies',
    title: s.caption_title,
    text: s.caption_text
  -%}
</section>

{% schema %}
{
  "name": "HOA Account register",
  "tag": "div",
  "class": "hoa-auth-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Create an" },
    { "type": "text", "id": "heading_italic", "label": "Heading, italic word", "default": "account" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Keep your orders, addresses and details together, and check out faster next time." },
    { "type": "header", "content": "Photograph" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown beside the form on screens 1024px and wider. Defaults to the theme photograph." },
    { "type": "text", "id": "caption_title", "label": "Caption", "default": "Agha Blue" },
    { "type": "text", "id": "caption_text", "label": "Caption line", "default": "Eau de Parfum" }
  ]
}
{% endschema %}
