{%- comment -%}
  House of Agha · About 05 · Our philosophy (2026-10-13).
  Later the same day (user): the ORIGINAL content is back (heading "Our philosophy.", the six
  principles Legacy ... Craft with their titles, lines and photos); only position and design
  follow the reference. Three principles on each side of the bottle.
  Built to the client's brief and generated reference image (luxury editorial):
    top      eyebrow + hairline on the left, "Discover our craft" + hairline + circled arrow
             on the right.
    centre   "Our Philosophy" heading with a hairline either side (user, 2026-10-13), above the headline.
    stage    left: stories 01-02, wide tinted panels, the photo a tall oval / D shape at
             the panel's left edge · centre: the two-line headline (second line italic), a
             short line, then the real Agha bottle in a tall capsule (no curve line since
             2026-10-13) · right: pill panels with a round photo overlapping their left
             edge. No side indicator (removed, user 2026-10-13).
  Centre media = the client's pour film (assets/hoa-philo-pour.mp4, cropped to the arch,
  muted loop, poster hoa-philo-pour-poster.webp), replacing the bottle photo. Sound on by
  default (from the visitor's first gesture if the browser requires); a speaker button mutes it.
    A faint silk ribbon drifts across the bottom left (SVG, decorative, desktop). No hairline rules.
  Tablet: headline + bottle on top, stories in two columns. Phones: headline, bottle, then
  the five stories. 
  Styles: assets/hoa-philosophy.css (scoped to .hoa-ph). Motion: assets/hoa-philosophy.js.
  Everything is visible without JS; animation start states are only ever set from JS.
  Earlier versions the same day (dark pinned still, minimal list, maximalist bands, bento)
  were replaced; see git history.
{%- endcomment -%}
{%- assign s = section.settings -%}
{{ 'hoa-philosophy.css' | asset_url | stylesheet_tag }}
<section class="hoa-ab-philo hoa-ph" id="philosophy" aria-labelledby="hoa-ph-title-{{ section.id }}" data-hoa-ph>
  {%- comment -%} Faint silk ribbon across the bottom left (decorative; user wants it kept, 2026-10-13) {%- endcomment -%}
  <svg class="hoa-ph__silk" viewBox="0 0 800 300" preserveAspectRatio="none" aria-hidden="true" data-hoa-ph-silk>
    <defs>
      <linearGradient id="hoa-ph-silk-{{ section.id }}" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#C9B49A" stop-opacity="0.05"/>
        <stop offset="0.45" stop-color="#C9B49A" stop-opacity="0.5"/>
        <stop offset="1" stop-color="#C9B49A" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <path d="M-20 70C120 60 170 190 300 200S520 120 640 190 780 280 820 270" stroke="url(#hoa-ph-silk-{{ section.id }})" stroke-width="34" fill="none" stroke-linecap="round"/>
    <path d="M-20 110C110 100 190 230 320 236S540 160 660 222 790 300 830 296" stroke="url(#hoa-ph-silk-{{ section.id }})" stroke-width="18" fill="none" stroke-linecap="round"/>
    <path d="M-20 40C140 34 160 160 290 176S500 100 620 160" stroke="url(#hoa-ph-silk-{{ section.id }})" stroke-width="1.2" fill="none"/>
    <path d="M-20 150C100 150 200 260 330 262S560 196 680 250" stroke="url(#hoa-ph-silk-{{ section.id }})" stroke-width="10" fill="none" stroke-linecap="round"/>
    <path d="M-20 92C126 84 178 214 308 222S530 142 650 208" stroke="url(#hoa-ph-silk-{{ section.id }})" stroke-width="0.8" fill="none"/>
  </svg>

  <div class="hoa-wrap">
    <div class="hoa-ph__top">
      {%- if s.eyebrow != blank -%}
        <p class="hoa-ph__eyebrow" data-hoa-ph-in><span>{{ s.eyebrow }}</span></p>
      {%- endif -%}
      {%- if s.link_label != blank -%}
        <a class="hoa-ph__link" href="{{ s.link_url | default: routes.all_products_collection_url }}" data-hoa-ph-in>
          <span>{{ s.link_label }}</span>
          
          <span class="hoa-ph__link-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h8M8.5 4.5L12 8l-3.5 3.5"/></svg>
          </span>
        </a>
      {%- endif -%}
    </div>

    <div class="hoa-ph__stage">
      <div class="hoa-ph__centre">
        {%- if s.kicker != blank -%}<p class="hoa-ph__kicker" data-hoa-ph-in>{{ s.kicker }}</p>{%- endif -%}
        <h2 class="hoa-ph__title" id="hoa-ph-title-{{ section.id }}">
          {%- if s.heading_1 != blank -%}<span class="hoa-ph__title-line" data-hoa-ph-in>{{ s.heading_1 }}</span>{%- endif -%}
          {%- if s.heading_2 != blank -%} <em class="hoa-ph__title-line hoa-ph__title-line--em" data-hoa-ph-in>{{ s.heading_2 }}</em>{%- endif -%}
        </h2>
        {%- if s.text != blank -%}<p class="hoa-ph__lede" data-hoa-ph-in>{{ s.text }}</p>{%- endif -%}

        {%- comment -%} The real bottle, in a tall capsule (the hairline curve with text beside it was removed, user 2026-10-13) {%- endcomment -%}
        <figure class="hoa-ph__bottle" data-hoa-ph-bottle>
          <span class="hoa-ph__capsule" data-hoa-ph-mask="rise">
            <span class="hoa-ph__capsule-img" data-hoa-ph-drift>
              {%- comment -%} The pour film (client's video, 2026-10-13) plays muted on a loop; the photo is its fallback {%- endcomment -%}
              {%- if s.centre_video_asset != blank -%}
                {%- assign poster = s.centre_poster_asset | asset_url -%}
                {%- if s.centre_image != blank -%}{%- assign poster = s.centre_image | image_url: width: 900 -%}{%- endif -%}
                <video class="hoa-ph__video" autoplay muted loop playsinline preload="metadata" poster="{{ poster }}" aria-label="{{ s.centre_alt | escape }}" data-hoa-ph-video>
                  <source src="{{ s.centre_video_asset | asset_url }}" type="video/mp4">
                </video>
              {%- else -%}
                {%- render 'hoa-img', name: s.centre_asset, image: s.centre_image, w: s.centre_w, h: s.centre_h, alt: s.centre_alt, sizes: '(min-width: 1100px) 24vw, (min-width: 700px) 50vw, 86vw' -%}
              {%- endif -%}
            </span>
          </span>
          {%- if s.centre_video_asset != blank -%}
            {%- comment -%} Sound is ON by default (from the first click/tap if the browser needs one); this mutes / unmutes {%- endcomment -%}
            <button type="button" class="hoa-ph__sound" aria-pressed="true" aria-label="Turn sound off" data-hoa-ph-sound hidden>
              <svg class="hoa-ph__sound-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="M16 9.5l5 5M21 9.5l-5 5"/></svg>
              <svg class="hoa-ph__sound-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.5a7.6 7.6 0 0 1 0 11"/></svg>
            </button>
          {%- endif -%}
        </figure>
      </div>

      {%- comment -%} The principles: the first half on the left, the rest on the right (wrappers vanish
         below 1100px). Each panel's shape comes from its place: l1 oval, l2 "D", l3 round photo
         over the panel's end; r1/r2 round photos, r3 "D". {%- endcomment -%}
      {%- assign half = section.blocks.size | plus: 1 | divided_by: 2 | floor -%}
      {%- assign right_start = half | plus: 1 -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign n = forloop.index -%}
        {%- liquid
          if n <= half
            assign pos = 'l' | append: n
          else
            assign k = n | minus: half
            assign pos = 'r' | append: k
          endif
          assign words = b.title | split: ' '
          assign last_word = words | last
          assign lead_size = words.size | minus: 1
          assign lines = b.lines | newline_to_br | split: '<br />'
        -%}
        {%- if n == 1 -%}<div class="hoa-ph__col hoa-ph__col--left">{%- endif -%}
        {%- if n == right_start -%}</div><div class="hoa-ph__col hoa-ph__col--right">{%- endif -%}
        <article class="hoa-ph-story hoa-ph-story--{{ pos }} hoa-ph-story--{{ b.tone | default: 'champagne' }}" id="hoa-ph-story-{{ section.id }}-{{ n }}" data-hoa-ph-story {{ block.shopify_attributes }}>
          <figure class="hoa-ph-story__media" data-hoa-ph-mask="{% if pos == 'l2' or pos == 'r3' %}rise{% else %}circle{% endif %}">
            {%- if b.asset != blank or b.image != blank -%}
              {%- render 'hoa-img', name: b.asset, image: b.image, w: b.w, h: b.h, alt: b.alt, sizes: '(min-width: 1100px) 15vw, (min-width: 700px) 22vw, 40vw' -%}
            {%- endif -%}
          </figure>
          <div class="hoa-ph-story__text" data-hoa-ph-text>
            {%- comment -%} a small line icon per principle in place of the number (user, 2026-10-13): chosen by key word, else by place {%- endcomment -%}
            {%- assign key = b.word | downcase | strip -%}
            {%- unless 'legacy,passion,purpose,innovation,loyalty,craft' contains key and key != blank -%}
              {%- assign keys = 'legacy,passion,purpose,innovation,loyalty,craft' | split: ',' -%}
              {%- assign key = keys[forloop.index0] | default: 'craft' -%}
            {%- endunless -%}
            <p class="hoa-ph-story__no">
              <span class="hoa-ph-story__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                  {%- case key -%}
                    {%- when 'legacy' -%}<path d="M5 20.5V11a7 7 0 0 1 14 0v9.5M3 20.5h18M9.5 20.5v-5a2.5 2.5 0 0 1 5 0v5M12 4V2.5"/>
                    {%- when 'passion' -%}<path d="M12 21c-3.8 0-6.3-2.5-6.3-5.9 0-3.3 2.5-5.1 3.5-8.2.9 1.7 1.9 2.6 3 3.2.4-2.1 1.3-4 2.9-5.6.7 3.4 3.2 5.5 3.2 10.2 0 3.7-2.5 6.3-6.3 6.3z"/><path d="M12 21c-1.5 0-2.6-1-2.6-2.5 0-1.6 1.4-2.3 2.6-4 1.2 1.7 2.6 2.4 2.6 4 0 1.5-1.1 2.5-2.6 2.5z"/>
                    {%- when 'purpose' -%}<path d="M5 19.5C5 11.5 10.5 5.5 19.5 4.5c0 9-5.5 15-14.5 15z"/><path d="M5 19.5l8.5-8.5"/>
                    {%- when 'innovation' -%}<path d="M12 3v3.5M12 17.5V21M3 12h3.5M17.5 12H21"/><path d="M12 8.2l1.1 2.7 2.7 1.1-2.7 1.1L12 15.8l-1.1-2.7L8.2 12l2.7-1.1z"/>
                    {%- when 'loyalty' -%}<path d="M8.2 8.8a3.2 3.2 0 1 0 0 6.4c2.1 0 3.1-1.6 3.8-3.2s1.7-3.2 3.8-3.2a3.2 3.2 0 1 1 0 6.4c-2.1 0-3.1-1.6-3.8-3.2s-1.7-3.2-3.8-3.2z"/>
                    {%- else -%}<path d="M15.5 3.5l5 5M18 6l-8.8 8.8-2.4.6.6-2.4L16.2 4.2M6.8 15.4L4.5 19.5l4.1-2.3"/>
                  {%- endcase -%}
                </svg>
              </span>
              {%- if b.word != blank -%}<span class="hoa-ph-story__word">{{ b.word }}</span>{%- endif -%}
            </p>
            <h3 class="hoa-ph-story__title">{% for w in words limit: lead_size %}{{ w }} {% endfor %}<em>{{ last_word }}</em></h3>
            {%- if lines.size > 0 -%}
              <p class="hoa-ph-story__copy">{%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != blank -%}{{ t }} {% endif -%}{%- endfor -%}</p>
            {%- endif -%}
          </div>
        </article>
        {%- if forloop.last -%}</div>{%- endif -%}
      {%- endfor -%}

    </div>
  </div>
</section>
<script src="{{ 'hoa-philosophy.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "About: philosophy",
  "tag": "div",
  "class": "hoa-ab-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The art of perfumery" },
    { "type": "text", "id": "kicker", "label": "Small heading above the headline" },
    { "type": "text", "id": "heading_1", "label": "Heading line 1", "default": "Our" },
    { "type": "text", "id": "heading_2", "label": "Heading line 2 (italic)", "default": "philosophy." },
    { "type": "textarea", "id": "text", "label": "Short line under the heading", "default": "What guides every bottle." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover our craft" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Centre photograph (the real bottle)" },
    { "type": "text", "id": "centre_video_asset", "label": "Video (theme asset .mp4)", "default": "hoa-philo-pour.mp4", "info": "Plays muted on a loop. Leave blank to show the photo instead." },
    { "type": "text", "id": "centre_poster_asset", "label": "Video poster (theme asset)", "default": "hoa-philo-pour-poster.webp" },
    { "type": "image_picker", "id": "centre_image", "label": "Image (used as poster, or alone when there is no video)" },
    { "type": "text", "id": "centre_asset", "label": "Fallback theme asset", "default": "hoa-pgal-shamamah-garden" },
    { "type": "number", "id": "centre_w", "label": "Fallback asset width", "default": 1000 },
    { "type": "number", "id": "centre_h", "label": "Fallback asset height", "default": 1333 },
    { "type": "text", "id": "centre_alt", "label": "Alt text", "default": "A gold dropper releasing a drop of attar into a glass flask, among oud wood and jasmine" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Principle",
      "settings": [
        { "type": "text", "id": "word", "label": "Key word" },
        { "type": "text", "id": "title", "label": "Title", "info": "The last word is set in italic." },
        { "type": "textarea", "id": "lines", "label": "Lines (one per line)" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Fallback theme asset" },
        { "type": "number", "id": "w", "label": "Fallback asset width", "default": 1200 },
        { "type": "number", "id": "h", "label": "Fallback asset height", "default": 1500 },
        { "type": "text", "id": "alt", "label": "Alt text" },
        {
          "type": "select",
          "id": "tone",
          "label": "Panel colour",
          "default": "champagne",
          "options": [
            { "value": "champagne", "label": "Champagne" },
            { "value": "sage", "label": "Sage" },
            { "value": "blue", "label": "Soft blue" },
            { "value": "blush", "label": "Blush" },
            { "value": "lavender", "label": "Lavender" }
          ]
        }
      ]
    }
  ],
  "presets": [{ "name": "About: philosophy" }]
}
{% endschema %}
