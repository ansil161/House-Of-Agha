{% comment %}
  AGHA CRAFTSMANSHIP & CLOSING SECTION
{% endcomment %}

<section class="section-padding" id="house-craftsmanship">
  <div class="container">
    <div style="margin-bottom: var(--space-2xl);" class="gsap-reveal">
      <span class="editorial-label">03 — ARTISANAL PILLARS</span>
      <h2 class="headline-section font-serif" style="margin-top: 12px;">THE CRAFT PHILOSOPHY</h2>
    </div>

    <div class="grid-3 gsap-reveal" style="margin-bottom: var(--space-3xl);">
      <div style="border: 1px solid var(--color-border); padding: var(--space-xl); background: var(--color-near-black);">
        <span class="art-step-num">01</span>
        <h3 class="font-serif" style="font-size: 1.6rem; margin-top: 12px;">SUSTAINABLE PROVENANCE</h3>
        <p class="text-soft" style="font-size: 0.88rem; line-height: 1.7; margin-top: 12px;">
          Wild Cambodian agarwood from Assam, Florentine iris root aged for three years, and Madagascan pink pepper—harvested by hand during optimal moon phases.
        </p>
      </div>

      <div style="border: 1px solid var(--color-border); padding: var(--space-xl); background: var(--color-near-black);">
        <span class="art-step-num">02</span>
        <h3 class="font-serif" style="font-size: 1.6rem; margin-top: 12px;">90-DAY OBSIDIAN MACERATION</h3>
        <p class="text-soft" style="font-size: 0.88rem; line-height: 1.7; margin-top: 12px;">
          Unpolished compounding mixtures mature inside temperature-stabilized obsidian vaults for 90 days. Molecules bind smoothly without harsh alcohol topnotes.
        </p>
      </div>

      <div style="border: 1px solid var(--color-border); padding: var(--space-xl); background: var(--color-near-black);">
        <span class="art-step-num">03</span>
        <h3 class="font-serif" style="font-size: 1.6rem; margin-top: 12px;">INDIVIDUAL NUMBERING</h3>
        <p class="text-soft" style="font-size: 0.88rem; line-height: 1.7; margin-top: 12px;">
          Each flacon is laser-engraved with its unique batch code and compounding date before being hand-wrapped in matte black hardboard packaging.
        </p>
      </div>
    </div>

    <!-- House Closing Banner -->
    <div style="text-align: center; max-width: 750px; margin: 0 auto; padding-top: var(--space-2xl); border-top: 1px solid var(--color-border);" class="gsap-reveal">
      <h2 class="font-serif" style="font-size: clamp(2rem, 4vw, 3.2rem); text-transform: uppercase;">
        ENTER THE WORLD OF AGHA.
      </h2>
      <p class="text-muted" style="margin-top: 16px; font-size: 0.95rem;">
        Discover the signature extrait de parfum designed to define your aura.
      </p>

      <div style="margin-top: 32px;">
        <a href="/collections/all" class="btn-primary" style="padding: 18px 36px;">
          <span>EXPLORE THE COLLECTION</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Agha House Craft",
  "settings": []
}
{% endschema %}
