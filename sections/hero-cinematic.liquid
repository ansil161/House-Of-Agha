{% comment %}
  01 — CINEMATIC HERO
{% endcomment %}

<section class="hero-wrapper" id="hero">
  <img src="{{ 'hero_perfume_bottle.jpg' | asset_url }}" alt="AGHA Perfume Campaign" class="hero-bg-media">
  <div class="hero-overlay-gradient"></div>

  <div class="hero-content-layer">
    <div class="hero-top-bar">
      <div class="hero-editorial-tag">
        <span class="editorial-label">AUTUMN / WINTER COLLECTION</span>
      </div>
      <div class="tag-pill">EXTRAIT DE PARFUM · 35% CONCENTRATION</div>
    </div>

    <div class="hero-body">
      <h1 class="headline-hero hero-headline">
        <span>THE SCENT IS</span>
        <span>THE LUXURY.</span>
      </h1>
      <p class="subheadline text-soft" style="margin-top: 24px; max-width: 520px;">
        Unapologetic extraits de parfum crafted from rare botanical extracts, aged Cambodian oud, and wild iris. Designed for those who leave an indelible presence.
      </p>

      <div class="hero-actions-group" style="margin-top: 36px; display: flex; gap: 16px; opacity: 0;">
        <a href="#signature" class="btn-primary">
          <span>EXPLORE SIGNATURES</span>
          <span class="btn-arrow">→</span>
        </a>
        <a href="#discover" class="btn-secondary">
          <span>DISCOVER YOUR SCENT</span>
        </a>
      </div>
    </div>

    <div class="hero-footer-bar" style="opacity: 0;">
      <div class="hero-scroll-indicator">
        <div class="scroll-line"><div class="scroll-line-fill"></div></div>
        <span>SCROLL TO ENTER THE HOUSE</span>
      </div>
      <div style="font-size: 0.72rem; letter-spacing: 0.2em; color: var(--color-muted);">
        AGHA PARFUMS · NO. 01–08
      </div>
    </div>
  </div>
</section>
