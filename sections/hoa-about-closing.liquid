{%- comment -%}
  House of Agha · About 04 · Closing card
  One dark rounded card: headline and shop button on one side, photo on the other.
  Grows from slightly inset to full width as it scrolls in (assets/hoa-about.js).
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="hoa-ab-closing" data-hoa-ab-closing>
  <div class="hoa-wrap">
    <div class="hoa-ab-cta" data-hoa-ab-cta>
      <div class="hoa-ab-cta__copy">
        <h2 class="hoa-ab-h2">{{ s.heading }}{% if s.heading_muted != blank %} <span class="hoa-ab-muted">{{ s.heading_muted }}</span>{% endif %}</h2>
        {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
        {%- if s.cta_label != blank -%}
          <a class="hoa-btn hoa-btn--light" href="{{ s.cta_url | default: routes.all_products_collection_url }}"><span>{{ s.cta_label }}</span>{% render 'hoa-btn-icon' %}</a>
        {%- endif -%}
      </div>
      <figure class="hoa-ab-cta__media"{% if s.focus != blank %} style="--pos: {{ s.focus }}"{% endif %}>
        <div class="hoa-ab-cta__img" data-hoa-ab-parallax>
          {%- render 'hoa-img', name: s.asset, image: s.image, w: s.w, h: s.h, alt: s.alt, sizes: '(min-width: 900px) 50vw, 100vw' -%}
        </div>
      </figure>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About: closing",
  "tag": "div",
  "class": "hoa-ab-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the one" },
    { "type": "text", "id": "heading_muted", "label": "Heading, muted part", "default": "you carry close." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Seven eaux de parfum, each with its own world. Start with the one that sounds like you." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image (landscape)" },
    { "type": "text", "id": "asset", "label": "Fallback theme asset", "default": "hoa-world-profile" },
    { "type": "number", "id": "w", "label": "Fallback asset width", "default": 2000 },
    { "type": "number", "id": "h", "label": "Fallback asset height", "default": 1125 },
    { "type": "text", "id": "focus", "label": "Crop focus (CSS object-position)", "info": "e.g. 50% 38%. Keeps the subject in frame when the photo is cropped." },
    { "type": "text", "id": "alt", "label": "Alt text", "default": "A man holds Oud Fury against an amber backdrop" }
  ],
  "presets": [{ "name": "About: closing" }]
}
{% endschema %}
