{% comment %}
  02 — THE HOUSE · "The Vessel" (2026-10-09, v3: one fragrance, Agha Blue)
  Same copy as before (tag, statement, supporting line + CTA, three principles); new layout.
  The section pins. The ice cave fills the screen; the real Agha Blue silhouette closes around
  it until the place sits inside the actual flacon (cut-out, assets/hoa-vessel-agha-blue.webp),
  [2026-10-12: place photo = hoa-house-agha-blue (client portrait AB POT 2 outpainted to 21:9, shown whole below the navbar); principles list removed]
  the cave still glowing in its glass, light drifting through it like water caustics, the
  bottle mirrored on still water below. The statement lights up word by word on the way; it
  is rendered twice (ink under the glass, white masked to the silhouette above it) so it is
  white exactly where the place is behind it. "an ice cave" is underlined once it has settled.
  Motion: assets/hoa-vessel.js. Styles: assets/hoa-vessel.css. Reduced motion / no JS = the
  finished state, no pin. Wrap words in *asterisks* in the statement for the serif italic.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign statement = s.statement | escape
  assign parts = statement | split: '*'
  assign phrase = s.place_label | escape
  assign glow = s.glow | default: 60 | divided_by: 100.0
-%}
{{ 'hoa-vessel.css' | asset_url | stylesheet_tag }}

<section class="hoa-manifesto hoa-vessel" id="the-house" data-hoa-manifesto data-hoa-vessel style="--focus: {{ s.focus_x | default: 0 }}; --glow: {{ glow }}">
  <div class="hoa-vessel__track" data-vessel-track>
    <div class="hoa-vessel__stage" data-vessel-stage>

      {%- capture layout -%}
        <div class="hoa-vessel__lead">
          <div class="hoa-vessel__meta">
            <span class="hoa-vessel__tag">{{ s.eyebrow }}</span>
          </div>
          <p class="hoa-vessel__statement" data-vessel-words>
            {%- for part in parts -%}
              {%- assign odd = forloop.index0 | modulo: 2 -%}
              {%- assign seg = part -%}
              {%- if phrase != blank and seg contains phrase -%}
                {%- capture mark %}<span class="hoa-vessel__phrase">{{ phrase }}</span>{% endcapture -%}
                {%- assign seg = seg | replace: phrase, mark -%}
              {%- endif -%}
              {%- if odd == 1 %}<em>{{ seg }}</em>{% else %}{{ seg }}{% endif -%}
            {%- endfor -%}
          </p>
          <div class="hoa-vessel__foot" style="--i: 0">
            <p class="hoa-vessel__lede">{{ s.body }}</p>
            <a class="hoa-btn" href="{{ s.link_url | default: '/pages/the-house' }}"><span>{{ s.link_label }}</span>{% render 'hoa-btn-icon' %}</a>
          </div>
        </div>

        <div class="hoa-vessel__center">
          <div class="hoa-vessel__slot" data-vessel-slot aria-hidden="true"></div>
        </div>

        {%- comment -%} the three principles (One world / Its own light / Worn close) were removed 2026-10-12 {%- endcomment -%}
      {%- endcapture -%}

      {%- comment -%} a faint cold halo behind the finished bottle {%- endcomment -%}
      <span class="hoa-vessel__halo" aria-hidden="true"></span>

      {%- comment -%} The content in ink, under the glass {%- endcomment -%}
      <div class="hoa-vessel__layout" data-vessel-layout>{{ layout }}</div>

      <div class="hoa-vessel__place">
        {%- comment -%} the bottle mirrored on still water {%- endcomment -%}
        <img class="hoa-vessel__reflect" src="{{ s.bottle | default: 'hoa-vessel-agha-blue' | append: '.webp' | asset_url }}" width="430" height="1104" alt="" aria-hidden="true" loading="lazy" decoding="async">
        {%- comment -%} the place, seen through the bottle's silhouette {%- endcomment -%}
        <div class="hoa-vessel__scene">
          {%- render 'hoa-img', name: s.asset, image: s.image, w: 2400, h: 1018, alt: s.alt, sizes: '100vw' -%}
        </div>
        {%- comment -%} the real bottle, arriving as the place condenses {%- endcomment -%}
        <img class="hoa-vessel__bottle" src="{{ s.bottle | default: 'hoa-vessel-agha-blue' | append: '.webp' | asset_url }}" width="430" height="1104" alt="{{ s.fragrance | escape }}" loading="lazy" decoding="async">
        {%- comment -%} the place again, glowing inside the glass (screen blend, body only) {%- endcomment -%}
        <div class="hoa-vessel__scene hoa-vessel__ghost" aria-hidden="true">
          {%- render 'hoa-img', name: s.asset, image: s.image, w: 2400, h: 1018, alt: '', sizes: '100vw' -%}
        </div>
        {%- comment -%} light moving through the glass like caustics off water {%- endcomment -%}
        <span class="hoa-vessel__caustics" aria-hidden="true"></span>
      </div>
      <span class="hoa-vessel__shadow" aria-hidden="true"></span>

      {%- comment -%} The same content in white, shown only through the bottle's silhouette, so the
         statement changes colour exactly where the glass passes over it {%- endcomment -%}
      <div class="hoa-vessel__layout hoa-vessel__layout--glass" aria-hidden="true" inert>{{ layout }}</div>
    </div>

    {%- comment -%} Where the 3D logo lands (hoa-crest.js): the printed crest of the finished bottle {%- endcomment -%}
    <span class="hoa-vessel__seal" data-vessel-seal aria-hidden="true"></span>
  </div>
</section>

<script src="{{ 'hoa-vessel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "HOA The House",
  "tag": "div",
  "class": "hoa-manifesto-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Tag", "default": "The House" },
    { "type": "textarea", "id": "statement", "label": "Statement", "info": "Wrap words in *asterisks* to set them in serif italic.", "default": "Every Agha fragrance begins as a *place*: a smoke-lit room, an ice cave, a garden after rain. It ends as something you *carry close*." },
    { "type": "textarea", "id": "body", "label": "Supporting line", "default": "House of Agha composes eaux de parfum around a single world at a time, and dresses each one in its own bottle, colour and light." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "The story of the House" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "The bottle" },
    { "type": "text", "id": "fragrance", "label": "Fragrance", "default": "Agha Blue" },
    { "type": "text", "id": "bottle", "label": "Bottle cut-out (theme asset)", "default": "hoa-vessel-agha-blue", "info": "Base name of a transparent 430 × 1104 WebP of the bottle." },
    { "type": "text", "id": "place_label", "label": "Place in the statement", "default": "an ice cave", "info": "Underlined in the statement once the bottle has settled. Write it exactly as it appears there." },
    { "type": "image_picker", "id": "image", "label": "Place photograph" },
    { "type": "text", "id": "asset", "label": "Place photograph fallback (theme asset)", "default": "hoa-house-agha-blue" },
    { "type": "text", "id": "alt", "label": "Alt text", "default": "Agha Blue on still water under a glowing planet, snow peaks behind" },
    { "type": "range", "id": "glow", "label": "Place glowing in the glass", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 60 },
    { "type": "range", "id": "focus_x", "label": "Slide inside the glass", "min": -30, "max": 30, "step": 1, "unit": "%", "default": -22, "info": "Moves the photograph sideways once it sits inside the bottle, e.g. to keep a campaign bottle out of the glass." }
  ],
  "presets": [{ "name": "HOA The House" }]
}
{% endschema %}
