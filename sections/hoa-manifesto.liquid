{% comment %}
  02 — THE HOUSE (2026-10-06 editorial split)
  Left: a pill tag, the statement sharpening word by word on scroll, the supporting line + CTA,
  and three numbered principles on a hairline. Right: two photographs in nested frames
  (outer shell + inner core), the small one overlapping the large one on desktop and drifting
  at its own speed. Phones: one column, the two photos side by side, no overlap.
  Wrap words in *asterisks* in the statement to set them in the serif italic.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign statement = s.statement | escape
  assign parts = statement | split: '*'
-%}
<section class="hoa-manifesto" id="the-house" data-hoa-manifesto>
  {%- if s.show_mandala -%}{%- render 'hoa-hero-mandala', class: 'hoa-manifesto__mandala' -%}{%- endif -%}
  <div class="hoa-wrap hoa-manifesto__grid">
    <div class="hoa-manifesto__copy">
      <div class="hoa-manifesto__meta" data-hoa-reveal>
        <span class="hoa-manifesto__tag">{{ s.eyebrow }}</span>
        <span class="hoa-manifesto__rule" aria-hidden="true"></span>
      </div>

      <p class="hoa-manifesto__text" data-hoa-words>
        {%- for part in parts -%}
          {%- assign odd = forloop.index0 | modulo: 2 -%}
          {%- if odd == 1 %}<em>{{ part }}</em>{% else %}{{ part }}{% endif -%}
        {%- endfor -%}
      </p>

      <div class="hoa-manifesto__foot" data-hoa-reveal>
        <p class="hoa-lede">{{ s.body }}</p>
        <a class="hoa-btn" href="{{ s.link_url | default: '/pages/the-house' }}"><span>{{ s.link_label }}</span>{% render 'hoa-btn-icon' %}</a>
      </div>

      <ol class="hoa-manifesto__notes" data-hoa-reveal>
        {%- for i in (1..3) -%}
          {%- capture key_t %}note_{{ i }}_title{% endcapture -%}
          {%- capture key_b %}note_{{ i }}_text{% endcapture -%}
          {%- if s[key_t] != blank -%}
            <li class="hoa-manifesto__note">
              {%- comment -%} Icons instead of numbers (2026-10-07): 1 compass rose (one world), 2 sunburst (its own light), 3 drop (worn close) {%- endcomment -%}
              <span class="hoa-manifesto__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                  {%- case i -%}
                    {%- when 1 -%}<circle cx="12" cy="12" r="9.2"/><path d="M12 4.6l1.9 5.5L19.4 12l-5.5 1.9L12 19.4l-1.9-5.5L4.6 12l5.5-1.9z"/><circle cx="12" cy="12" r="1"/>
                    {%- when 2 -%}<circle cx="12" cy="12" r="4"/><path d="M12 2.8v2.6M12 18.6v2.6M2.8 12h2.6M18.6 12h2.6M5.5 5.5l1.8 1.8M16.7 16.7l1.8 1.8M18.5 5.5l-1.8 1.8M7.3 16.7l-1.8 1.8"/>
                    {%- else -%}<path d="M12 3.2c3.4 4.2 6 7.6 6 10.8a6 6 0 0 1-12 0c0-3.2 2.6-6.6 6-10.8z"/><path d="M9.2 14.4a2.9 2.9 0 0 0 2.4 2.7"/>
                  {%- endcase -%}
                </svg>
              </span>
              <span class="hoa-manifesto__note-title">{{ s[key_t] }}</span>
              {%- if s[key_b] != blank %}<span class="hoa-manifesto__note-text">{{ s[key_b] }}</span>{% endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>

    <div class="hoa-manifesto__media">
      <div class="hoa-manifesto__plate hoa-manifesto__plate--main" data-hoa-reveal>
        <figure class="hoa-manifesto__shell" data-hoa-speed="-0.05">
          <div class="hoa-manifesto__core">
            {%- render 'hoa-img', name: 'hoa-shamamah-lily', image: s.image_one, w: 1086, h: 1448, alt: 'Shamamah by House of Agha, held in a dried lily', sizes: '(min-width: 961px) 34vw, 50vw' -%}
          </div>
        </figure>
      </div>
      <div class="hoa-manifesto__plate hoa-manifesto__plate--sub" data-hoa-reveal>
        <figure class="hoa-manifesto__shell" data-hoa-speed="0.14">
          <div class="hoa-manifesto__core">
            {%- render 'hoa-img', name: 'hoa-ingredients-tobacco', image: s.image_two, w: 969, h: 969, alt: 'Tobacco Enigma among bergamot, cinnamon, honey and jasmine', sizes: '(min-width: 961px) 16vw, 50vw' -%}
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HOA The House",
  "tag": "div",
  "class": "hoa-manifesto-section",
  "settings": [
    { "type": "checkbox", "id": "show_mandala", "label": "Rotating mandala", "default": false, "info": "A faint brass geometric mandala turning slowly behind the statement (90 s per turn; still for reduced-motion visitors)." },
    { "type": "text", "id": "eyebrow", "label": "Tag", "default": "The House" },
    { "type": "textarea", "id": "statement", "label": "Statement", "info": "Wrap words in *asterisks* to set them in serif italic.", "default": "Every Agha fragrance begins as a *place*: a smoke-lit room, an ice cave, a garden after rain. It ends as something you *carry close*." },
    { "type": "textarea", "id": "body", "label": "Supporting line", "default": "House of Agha composes eaux de parfum around a single world at a time, and dresses each one in its own bottle, colour and light." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "The story of the House" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Principles" },
    { "type": "text", "id": "note_1_title", "label": "Principle 1", "default": "One world" },
    { "type": "text", "id": "note_1_text", "label": "Principle 1 line", "default": "Each fragrance is composed around a single place." },
    { "type": "text", "id": "note_2_title", "label": "Principle 2", "default": "Its own light" },
    { "type": "text", "id": "note_2_text", "label": "Principle 2 line", "default": "A bottle, colour and mood made for that world alone." },
    { "type": "text", "id": "note_3_title", "label": "Principle 3", "default": "Worn close" },
    { "type": "text", "id": "note_3_text", "label": "Principle 3 line", "default": "Eaux de parfum meant to stay near the skin." },
    { "type": "header", "content": "Photographs" },
    { "type": "image_picker", "id": "image_one", "label": "Main image (portrait)" },
    { "type": "image_picker", "id": "image_two", "label": "Detail image (square)" }
  ],
  "presets": [{ "name": "HOA The House" }]
}
{% endschema %}
