{% comment %}
  AGHA PDP — 08 YOU MAY ALSO LIKE
  Uses Shopify product recommendations. The first render is an empty shell; pdp.js fetches this
  section with ?section_id=…&product_id=… and swaps in the recommended products.
{% endcomment %}
{%- capture pdp_json -%}{%- render 'agha-pdp-data' -%}{%- endcapture -%}
{%- assign pdp = pdp_json | parse_json -%}
<section class="pdp pdp-section pdp-related" data-pdp-related data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="pdp-related__head">
        <header class="pdp-heading pdp-heading--left">
          <span class="pdp-eyebrow">{{ section.settings.eyebrow }}</span>
          <h2>{{ section.settings.heading }}</h2>
        </header>
        <a class="pdp-link" href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
      </div>
      <div class="pdp-related__grid">
        {%- for item in recommendations.products -%}
          <a class="pdp-rel" href="{{ item.url }}" data-pdp-reveal>
            <div class="pdp-rel__frame">
              {%- if item.featured_image -%}
                {%- assign item_alt = item.featured_image.alt | default: item.title -%}
                {{ item.featured_image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 901px) 25vw, 50vw', loading: 'lazy', alt: item_alt }}
              {%- endif -%}
            </div>
            <div class="pdp-rel__body">
              {%- assign item_family = item.metafields.custom.family.value | default: item.type -%}
              {%- if item_family != blank -%}<span class="pdp-rel__meta">{{ item_family }}</span>{%- endif -%}
              <h3 class="pdp-rel__title">{{ item.title }}</h3>
              <span class="pdp-rel__price">{{ item.price | money }}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- elsif recommendations.performed and pdp.use_mock and pdp.related.size > 0 -%}
    {%- comment -%} Mock mode only: Shopify returned no recommendations, so show demo cards (real recommendations replace these). {%- endcomment -%}
    <div class="container" data-pdp-mock="related">
      <div class="pdp-related__head">
        <header class="pdp-heading pdp-heading--left">
          <span class="pdp-eyebrow">{{ section.settings.eyebrow }}</span>
          <h2>{{ section.settings.heading }}</h2>
        </header>
        <a class="pdp-link" href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
      </div>
      <div class="pdp-related__grid">
        {%- assign shown = 0 -%}
        {%- for item in pdp.related -%}
          {%- if item.handle != product.handle and shown < section.settings.limit -%}
            {%- assign shown = shown | plus: 1 -%}
            <a class="pdp-rel" href="{{ routes.root_url | append: 'products/' | append: item.handle }}" data-pdp-reveal>
              <div class="pdp-rel__frame"><img src="{{ item.image | asset_url }}" alt="{{ item.title | escape }}" loading="lazy" width="800" height="800"></div>
              <div class="pdp-rel__body">
                {%- if item.family != blank -%}<span class="pdp-rel__meta">{{ item.family }}</span>{%- endif -%}
                <h3 class="pdp-rel__title">{{ item.title }}</h3>
                <span class="pdp-rel__price">{{ item.price }}</span>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Agha PDP · You may also like",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore the house" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
