{% comment %}
  AGHA GIFT FINDER & PERSONALIZATION MODULE
{% endcomment %}

<section class="section-padding" id="gift-concierge">
  <div class="container">
    <!-- Interactive Gift Concierge Selection -->
    <div style="margin-bottom: var(--space-2xl);" class="gsap-reveal">
      <span class="editorial-label">03 — CONCIERGE RECOMMENDATIONS</span>
      <h2 class="headline-section font-serif" style="margin-top: 12px;">SELECT GIFT PARAMETERS</h2>
    </div>

    <div class="grid-3 gsap-reveal" style="margin-bottom: var(--space-3xl);">
      <!-- Filter 1: Recipient -->
      <div>
        <label class="editorial-label" style="margin-bottom: 12px; display: block;">WHO IS THE RECIPIENT?</label>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <div class="gift-concierge-card selected">
            <h4 class="font-serif" style="font-size: 1.2rem;">SPOUSE / PARTNER</h4>
            <p class="text-muted" style="font-size: 0.78rem;">Intimate, nocturnal, intense extraits.</p>
          </div>
          <div class="gift-concierge-card">
            <h4 class="font-serif" style="font-size: 1.2rem;">ESTEEMED FRIEND</h4>
            <p class="text-muted" style="font-size: 0.78rem;">Sophisticated suede & iris formulations.</p>
          </div>
          <div class="gift-concierge-card">
            <h4 class="font-serif" style="font-size: 1.2rem;">COLLEAGUE / PATRON</h4>
            <p class="text-muted" style="font-size: 0.78rem;">Universal Discovery Sampler Box.</p>
          </div>
        </div>
      </div>

      <!-- Filter 2: Occasion -->
      <div>
        <label class="editorial-label" style="margin-bottom: 12px; display: block;">WHAT IS THE OCCASION?</label>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <div class="gift-concierge-card selected">
            <h4 class="font-serif" style="font-size: 1.2rem;">ANNIVERSARY / CELEBRATION</h4>
            <p class="text-muted" style="font-size: 0.78rem;">Includes custom engraved initials on flacon cap.</p>
          </div>
          <div class="gift-concierge-card">
            <h4 class="font-serif" style="font-size: 1.2rem;">MILESTONE BIRTHDAY</h4>
            <p class="text-muted" style="font-size: 0.78rem;">Includes velvet-lined hardboard gift box.</p>
          </div>
          <div class="gift-concierge-card">
            <h4 class="font-serif" style="font-size: 1.2rem;">EXPRESSION OF GRATITUDE</h4>
            <p class="text-muted" style="font-size: 0.78rem;">Hand-wrapped with personalized card note.</p>
          </div>
        </div>
      </div>

      <!-- Gift Message Input -->
      <div>
        <label class="editorial-label" style="margin-bottom: 12px; display: block;">PERSONAL GIFT CARD MESSAGE</label>
        <div style="border: 1px solid var(--color-border); padding: var(--space-lg); background: var(--color-near-black); height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <span style="font-size: 0.7rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.2em; display: block; margin-bottom: 8px;">HAND-LETTERED BY CONCIERGE</span>
            <textarea placeholder="ENTER YOUR PERSONAL MESSAGE TO BE HAND-WRITTEN ON MATTE CARDSTOCK..." rows="5" class="vault-input" style="border: 1px solid var(--color-border); padding: 12px; font-size: 0.8rem; resize: none;"></textarea>
          </div>
          <div style="margin-top: 16px;">
            <button class="btn-secondary" onclick="AghaStore.showToast('Personal gift message attached to order.');" style="width: 100%; justify-content: center; font-size: 0.68rem;">SAVE MESSAGE</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Packaging Showcase -->
    <div style="border: 1px solid var(--color-border); padding: var(--space-2xl); background: var(--color-near-black);" class="gsap-reveal">
      <div class="grid-2" style="align-items: center;">
        <div class="gsap-clip-reveal" style="aspect-ratio: 4/3; border: 1px solid var(--color-border); overflow: hidden;">
          <img src="{{ 'discovery_box.jpg' | asset_url }}" alt="Packaging Craft" style="width: 100%; height: 100%; object-fit: cover;">
        </div>

        <div>
          <span class="editorial-label">UNBOXING RITUAL</span>
          <h3 class="font-serif" style="font-size: 2.2rem; margin-top: 8px;">MATTE BLACK HARDBOARD & SILK RIBBON</h3>
          <p class="text-soft" style="font-size: 0.95rem; line-height: 1.7; margin-top: 16px;">
            Every AGHA gift arrives ready for presentation. Encased in rigid 1200gsm matte black board lined with plush black velvet, secured with high-density woven silk ribbon, and sealed with black wax.
          </p>
          <div style="margin-top: 24px; display: flex; gap: 16px;">
            <a href="/collections/all" class="btn-primary">
              <span>EXPLORE GIFTABLE FLACONS</span>
              <span class="btn-arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Agha Gift Finder",
  "settings": []
}
{% endschema %}
