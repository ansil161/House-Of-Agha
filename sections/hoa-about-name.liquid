{%- comment -%}
  House of Agha · About 04 · The name
  A dictionary-style entry for "Agha", set in Hyderabad: on a sand panel with a gold jaali
  band, the word and its Persian script above a Qutb Shahi tomb in a pointed arch with a
  gold hairline (left); an archival photograph above four usages, each with a Hyderabad
  line icon (right). Sources, photo credits and the disclaimer below. Photos carry the
  page's warm archival tone (--ab-tone in assets/hoa-about.css).
  Photos: Wikimedia Commons, public domain / CC0 (see the credits setting).
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if s.script != blank -%}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@500&display=swap&text={{ s.script | url_encode }}">
{%- endif -%}
<section class="hoa-ab-name">
  {%- render 'hoa-ab-rule' -%}
  <div class="hoa-wrap">
    <div class="hoa-ab-name__card">
      <div class="hoa-ab-name__side">
        <div class="hoa-ab-name__word">
          <h2 class="hoa-ab-name__title"><span class="hoa-sr">The name </span>{{ s.word }}</h2>
          {%- if s.script != blank -%}<p class="hoa-ab-name__script" lang="fa" dir="rtl">{{ s.script }}</p>{%- endif -%}
          {%- render 'hoa-ab-floral' -%}
          {%- if s.meaning != blank -%}<p class="hoa-ab-name__meaning">{{ s.meaning }}</p>{%- endif -%}
        </div>
        {%- if s.arch_asset != blank or s.arch_image != blank -%}
          {%- liquid
            assign aw = s.arch_w | default: 1200
            assign ah = s.arch_h | default: 1600
          -%}
          <figure class="hoa-ab-name__arch">
            <div class="hoa-ab-arch">
              <div class="hoa-ab-arch__frame hoa-ab-name__arch-img">
                <div class="hoa-ab-name__img" data-hoa-ab-img>
                  {%- render 'hoa-img', name: s.arch_asset, image: s.arch_image, w: aw, h: ah, alt: s.arch_alt, sizes: '(min-width: 900px) 34vw, 90vw' -%}
                </div>
              </div>
              {%- render 'hoa-ab-arch' -%}
            </div>
            {%- if s.arch_caption != blank -%}<figcaption>{{ s.arch_caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
        {%- comment -%} Second photo under the arch; on wide screens it fills the rest of the panel. {%- endcomment -%}
        {%- if s.extra_asset != blank or s.extra_image != blank -%}
          {%- liquid
            assign xw = s.extra_w | default: 900
            assign xh = s.extra_h | default: 1200
          -%}
          <figure class="hoa-ab-name__extra">
            <div class="hoa-ab-name__extra-img">
              <span class="hoa-ab-corners" aria-hidden="true" data-hoa-ab-orn></span>
              <div class="hoa-ab-name__img" data-hoa-ab-img>
                {%- render 'hoa-img', name: s.extra_asset, image: s.extra_image, w: xw, h: xh, alt: s.extra_alt, sizes: '(min-width: 900px) 34vw, 90vw' -%}
              </div>
            </div>
            {%- if s.extra_caption != blank -%}<figcaption>{{ s.extra_caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
      </div>

      {%- comment -%} The wide photo fills the column width in its own shape; a tall photo is trimmed only slightly (3:4 frame). {%- endcomment -%}
      {%- liquid
        assign pw = s.photo_w | default: 2400
        assign ph = s.photo_h | default: 1674
        if s.photo_image != blank
          assign pw = s.photo_image.width
          assign ph = s.photo_image.height
        endif
      -%}
      <div class="hoa-ab-name__main">
        {%- if s.photo_asset != blank or s.photo_image != blank -%}
          <figure class="hoa-ab-name__photo{% if ph > pw %} hoa-ab-name__photo--tall{% endif %}" style="--ratio: {{ pw }} / {{ ph }}" data-hoa-ab-up>
            <div class="hoa-ab-name__photo-img">
              <span class="hoa-ab-corners" aria-hidden="true" data-hoa-ab-orn></span>
              <div class="hoa-ab-name__img" data-hoa-ab-img>
                {%- render 'hoa-img', name: s.photo_asset, image: s.photo_image, w: s.photo_w, h: s.photo_h, alt: s.photo_alt, sizes: '(min-width: 900px) 52vw, 100vw' -%}
              </div>
            </div>
            {%- if s.photo_caption != blank -%}<figcaption>{{ s.photo_caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <dl class="hoa-ab-name__uses">
            {%- for block in section.blocks -%}
              {%- assign b = block.settings -%}
              <div class="hoa-ab-name__use" data-hoa-ab-up {{ block.shopify_attributes }}>
                <span class="hoa-ab-name__icon" aria-hidden="true">
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                    {%- case b.icon -%}
                      {%- when 'qalam' -%}<path d="M22.5 4.5 27.5 9.5 12 25l-6.5 1.5L7 20z"/><path d="M19.5 7.5l5 5M7 20l5 5"/><path d="M4 28h9"/>
                      {%- when 'crest' -%}<path d="M6 23 8 10.5l5.2 5.3L16 7l2.8 8.8 5.2-5.3L26 23z"/><path d="M6 26.5h20"/><circle cx="16" cy="19" r="1.6"/>
                      {%- when 'pearl' -%}<circle cx="16" cy="17" r="8"/><path d="M12.5 13.8a4.2 4.2 0 0 1 3.5-2"/><path d="M4 9c3 1.6 5.3 3.3 7 5M28 9c-3 1.6-5.3 3.3-7 5"/>
                      {%- when 'jaali' -%}<path d="M16 5 27 16 16 27 5 16Z"/><path d="M8.2 8.2h15.6v15.6H8.2Z"/><circle cx="16" cy="16" r="2.4"/>
                      {%- else -%}<path d="M7 28V15c0-4.6 4-8.3 9-10.5 5 2.2 9 5.9 9 10.5v13"/><path d="M11 28V16.5c0-3.2 2.4-5.8 5-7.3 2.6 1.5 5 4.1 5 7.3V28M4 28h24"/>
                    {%- endcase -%}
                  </svg>
                </span>
                <dt>{{ b.label }}</dt>
                <dd>{{ b.text }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        {%- endif -%}
      </div>

      {%- if s.sources != blank or s.disclaimer != blank -%}
        <div class="hoa-ab-name__foot">
          {%- if s.sources != blank -%}<p>{{ s.sources }}</p>{%- endif -%}
          {%- if s.disclaimer != blank -%}<p>{{ s.disclaimer }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About: the name",
  "tag": "div",
  "class": "hoa-ab-section",
  "settings": [
    { "type": "text", "id": "word", "label": "Word", "default": "Agha" },
    { "type": "text", "id": "script", "label": "Word in Persian script", "default": "آقا" },
    { "type": "textarea", "id": "meaning", "label": "Meaning", "default": "A title of respect, authority and nobility in Qutb Shahi culture." },
    { "type": "header", "content": "Arch photo (left)" },
    { "type": "image_picker", "id": "arch_image", "label": "Image (portrait)" },
    { "type": "text", "id": "arch_asset", "label": "Fallback theme asset", "default": "hoa-hyd-tombs" },
    { "type": "number", "id": "arch_w", "label": "Theme asset width (px)", "default": 1200 },
    { "type": "number", "id": "arch_h", "label": "Theme asset height (px)", "default": 1600 },
    { "type": "text", "id": "arch_alt", "label": "Alt text", "default": "A domed Qutb Shahi tomb in Hyderabad with arched colonnades" },
    { "type": "text", "id": "arch_caption", "label": "Caption" },
    { "type": "header", "content": "Second photo (under the arch)" },
    { "type": "image_picker", "id": "extra_image", "label": "Image" },
    { "type": "text", "id": "extra_asset", "label": "Fallback theme asset", "default": "hoa-hyd-arcade" },
    { "type": "number", "id": "extra_w", "label": "Theme asset width (px)", "default": 900 },
    { "type": "number", "id": "extra_h", "label": "Theme asset height (px)", "default": 1200 },
    { "type": "text", "id": "extra_alt", "label": "Alt text", "default": "Pointed Deccan arches receding through a carved stone hall" },
    { "type": "text", "id": "extra_caption", "label": "Caption" },
    { "type": "header", "content": "Wide photo (right)" },
    { "type": "image_picker", "id": "photo_image", "label": "Image (landscape)" },
    { "type": "text", "id": "photo_asset", "label": "Fallback theme asset", "default": "hoa-hyd-oldcity" },
    { "type": "number", "id": "photo_w", "label": "Fallback asset width", "default": 2400 },
    { "type": "number", "id": "photo_h", "label": "Fallback asset height", "default": 1674 },
    { "type": "text", "id": "photo_focus", "label": "Crop focus (unused)", "info": "The photo is shown whole inside the frame, so no crop focus is needed." },
    { "type": "text", "id": "photo_alt", "label": "Alt text", "default": "An early photograph of Hyderabad's old city, with the Charminar at the end of a busy street" },
    { "type": "text", "id": "photo_caption", "label": "Caption", "default": "The old city and the Charminar, in an early photograph" },
    { "type": "header", "content": "Footer" },
    { "type": "text", "id": "sources", "label": "Sources line", "info": "Optional line under the card." },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "info": "Optional line under the card." }
  ],
  "blocks": [
    {
      "type": "use",
      "name": "Usage",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "arch", "options": [
          { "value": "qalam", "label": "Qalam (pen)" },
          { "value": "crest", "label": "Crown" },
          { "value": "arch", "label": "Qutb Shahi arch" },
          { "value": "pearl", "label": "Pearl" },
          { "value": "jaali", "label": "Jaali" }
        ] },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "About: the name" }]
}
{% endschema %}
