{%- comment -%}
  Home V2 · 03 "Born in ice" (2026-10-12), the House's version of a "Grown at altitude" lock-up.
  A deep green section slides up over the story. A portrait photo card rises from below with the
  headline over it; then the section holds (ScrollTrigger pin), the headline splits apart and the
  photo opens out to fill the screen (assets/hoa-v2.js, initPlace). The card is the full-screen photo
  clipped down (clip-path), so opening it never re-lays anything out.
  Without JS or with reduced motion: the card and the headline sit still, centred.
{%- endcomment -%}
{%- render 'hoa-v2-assets' -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap">
{%- liquid
  assign s = section.settings
  if s.photo != blank
    assign src = s.photo | image_url: width: 2000
    assign src_sm = s.photo | image_url: width: 900
  else
    assign src = s.asset | append: '.webp' | asset_url
    assign src_sm = s.asset | append: '-sm.webp' | asset_url
  endif
-%}
<section class="v2-place" data-v2-place style="--v2-place-bg: {{ s.background }}; --v2-place-focal: {{ s.focal | default: '50% 50%' }}" aria-label="{{ s.heading_a | append: ' ' | append: s.heading_b | escape }}">
  <div class="v2-place__stage">
    <span class="v2-place__dot" aria-hidden="true"></span>
    <div class="v2-place__frame" data-v2-place-frame>
      <img class="v2-place__img" data-v2-place-img src="{{ src }}" srcset="{{ src_sm }} 900w, {{ src }} 1600w" sizes="100vw" alt="{{ s.alt | escape }}" loading="lazy" decoding="async">
    </div>
    <h2 class="v2-place__title">
      <span class="v2-place__a" data-v2-place-a>{{ s.heading_a }}</span>
      <em class="v2-place__b" data-v2-place-b>{{ s.heading_b }}</em>
    </h2>
  </div>
</section>

{% schema %}
{
  "name": "V2 · Born in ice",
  "class": "v2-section v2-section--place",
  "settings": [
    { "type": "text", "id": "heading_a", "label": "Headline, left part", "default": "Born" },
    { "type": "text", "id": "heading_b", "label": "Headline, right part (italic)", "default": "in ice" },
    { "type": "image_picker", "id": "photo", "label": "Photo" },
    { "type": "text", "id": "asset", "label": "Theme asset when no photo is picked", "default": "hoa-hero-agha-blue" },
    { "type": "text", "id": "alt", "label": "Alt text", "default": "Agha Blue standing in still water inside an ice cave, daylight behind it" },
    { "type": "text", "id": "focal", "label": "Photo focal point", "default": "50% 50%", "info": "CSS object-position, e.g. 40% 50%." },
    { "type": "color", "id": "background", "label": "Background", "default": "#1E3932" }
  ],
  "presets": [{ "name": "V2 · Born in ice" }]
}
{% endschema %}
