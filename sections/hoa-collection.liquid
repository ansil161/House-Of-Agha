{% comment %}
  06 — THE COLLECTION
  Best sellers and the Discovery Collection in one shopping moment.
  Tabs filter by scent family (custom.family metafield, else product type).
  Cards: studio bottle on warm paper; on hover the campaign image (second product
  image) fades in and an add-to-bag pill rises. The last tile is the Discovery Set.

  Products: "Collection" setting, else the "best-sellers" collection, else the static
  House of Agha line-up below (used by the local preview and a fresh store).
{% endcomment %}

{%- capture catalog_json -%}{%- render 'hoa-catalog-data' -%}{%- endcapture -%}
{%- liquid
  assign s = section.settings
  assign source = s.collection
  if source == blank
    assign source = collections['best-sellers']
  endif
  assign use_shopify = false
  if source != blank and source.products_count > 0
    assign use_shopify = true
  endif
  assign tabs = s.tabs | split: ','
  assign all_url = s.all_url | default: routes.all_products_collection_url

  comment
    Static line-up: the shared mock catalog (snippets/hoa-catalog-data.liquid) — the same names,
    prices, offers, ratings and best sellers as the shop and product pages.
  endcomment
  assign catalog = catalog_json | parse_json
-%}

<section class="hoa-collection" id="collection" data-hoa-collection>
  <div class="hoa-wrap">
    <header class="hoa-collection__head">
      <div>
        <p class="hoa-eyebrow" data-hoa-reveal>{{ s.eyebrow }}</p>
        <p class="hoa-offer-note hoa-collection__note" data-hoa-reveal>{{ catalog.settings.messages.tiers }}</p>
        <div class="hoa-tabs" role="tablist" aria-label="Filter by scent family" data-hoa-reveal>
          <button class="hoa-tab" role="tab" type="button" aria-selected="true" data-hoa-filter="all">{{ s.all_tab }}</button>
          {%- for t in tabs -%}
            {%- assign tl = t | strip -%}
            <button class="hoa-tab" role="tab" type="button" aria-selected="false" data-hoa-filter="{{ tl | handleize }}">{{ tl }}</button>
          {%- endfor -%}
        </div>
      </div>
      <a class="hoa-link" href="{{ all_url }}" data-hoa-reveal>{{ s.all_label }}</a>
    </header>

    <div class="hoa-collection__grid" data-hoa-grid>
      {%- if use_shopify -%}
        {%- for product in source.products limit: s.limit -%}
          {%- liquid
            assign fam = product.metafields.custom.family.value | default: product.type
            assign wearer = product.metafields.custom.gender.value | downcase
            if wearer == blank
              for t in product.tags
                assign tl = t | downcase | remove: 'gender:' | remove: 'for ' | strip
                if tl == 'men' or tl == 'women' or tl == 'unisex'
                  assign wearer = tl
                  break
                endif
              endfor
            endif
            if wearer == 'man' or wearer == 'male' or wearer == 'him'
              assign wearer = 'men'
            elsif wearer == 'woman' or wearer == 'female' or wearer == 'her'
              assign wearer = 'women'
            endif
            assign variant = product.selected_or_first_available_variant
            assign mood = product.media[1].preview_image
            assign sale_rupees = product.price | divided_by: 100
            assign regular_rupees = ''
            assign regular_txt = ''
            if product.compare_at_price > product.price and product.price_varies == false
              assign regular_rupees = product.compare_at_price | divided_by: 100
              assign regular_txt = product.compare_at_price | money
            endif
            assign sale_txt = product.price | money
            if product.price_varies
              assign sale_txt = product.price_min | money | prepend: 'From '
            endif
            assign best = false
            if product.tags contains 'best-seller' or product.tags contains 'Best Seller'
              assign best = true
            endif
            assign thumb = product.featured_media.preview_image | image_url: width: 240
          -%}
          {%- capture img_main -%}{%- if product.featured_media -%}{{ product.featured_media.preview_image | image_url: width: 900 | image_tag: widths: '300, 600, 900', sizes: '(min-width: 1101px) 25vw, (min-width: 768px) 33vw, 50vw', loading: 'lazy', alt: product.title }}{%- endif -%}{%- endcapture -%}
          {%- capture img_mood -%}{%- if mood -%}{{ mood | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}{%- endcapture -%}
          {%- render 'hoa-shop-card',
            index: forloop.index0,
            handle: product.handle,
            url: product.url,
            name: product.title,
            family: fam,
            wearer: wearer,
            gift: false,
            img_main: img_main,
            img_mood: img_mood,
            thumb: thumb,
            available: product.available,
            sale_price: sale_rupees,
            regular_price: regular_rupees,
            sale_text: sale_txt,
            regular_text: regular_txt,
            rating: product.metafields.reviews.rating.value.rating,
            review_count: product.metafields.reviews.rating_count.value,
            best_seller: best,
            kind: s.product_label,
            shopify_product: product,
            variant_id: variant.id
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- for p in catalog.products -%}
          {%- liquid
            assign p_asset = 'hoa-product-' | append: p.asset
            assign m_asset = 'hoa-' | append: p.asset | append: '-portrait'
            assign p_alt = p.name | append: ' Eau de Parfum bottle'
            assign thumb_file = p_asset | append: '-sm.webp'
            assign thumb = thumb_file | asset_url
            assign purl = '/products/' | append: p.handle
            assign sale_v = p.salePrice | default: p.regularPrice
            assign is_available = true
            if p.inventory == 0
              assign is_available = false
            endif
          -%}
          {%- capture img_main -%}{%- render 'hoa-img', name: p_asset, w: 1200, h: 1500, alt: p_alt, sizes: '(min-width: 1101px) 25vw, (min-width: 768px) 33vw, 50vw' -%}{%- endcapture -%}
          {%- capture img_mood -%}{%- render 'hoa-img', name: m_asset, w: 1200, h: 1607, alt: '', sizes: '(min-width: 1101px) 25vw, 50vw' -%}{%- endcapture -%}
          {%- render 'hoa-shop-card',
            index: forloop.index0,
            handle: p.handle,
            url: purl,
            name: p.name,
            family: p.family,
            wearer: p.wearer,
            gift: false,
            img_main: img_main,
            img_mood: img_mood,
            thumb: thumb,
            available: is_available,
            sale_price: sale_v,
            regular_price: p.regularPrice,
            rating: p.rating,
            review_count: p.reviewCount,
            best_seller: p.isBestSeller,
            kind: s.product_label,
            product_id: p.handle
          -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Discovery Collection — secondary entry point {%- endcomment -%}
      {%- liquid
        assign disc = s.discovery_product
        if disc != blank
          assign disc_url = disc.url
        else
          assign disc_url = s.discovery_url | default: routes.all_products_collection_url
        endif
      -%}
      <article class="hoa-card hoa-card--feature" data-family="all" data-hoa-card id="discovery">
        <a class="hoa-card__media" href="{{ disc_url }}">
          <span class="hoa-card__img">
            {%- if s.discovery_image != blank -%}
              {{ s.discovery_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: s.discovery_title }}
            {%- elsif disc != blank and disc.featured_media -%}
              {{ disc.featured_media.preview_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: disc.title }}
            {%- else -%}
              <img src="{{ 'discovery_box.jpg' | asset_url }}" alt="{{ s.discovery_title | escape }}" loading="lazy" width="1200" height="900">
            {%- endif -%}
          </span>
          <div class="hoa-card__overlay">
            <div>
              <p class="hoa-eyebrow">{{ s.discovery_eyebrow }}</p>
              <h3>{% if disc != blank %}{{ disc.title }}{% else %}{{ s.discovery_title }}{% endif %}</h3>
              <p>{{ s.discovery_text }}</p>
            </div>
            <span class="hoa-btn hoa-btn--light hoa-btn--small" style="align-self: flex-start;"><span>{{ s.discovery_cta }}</span>{% render 'hoa-btn-icon' %}</span>
          </div>
        </a>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HOA The Collection",
  "tag": "div",
  "class": "hoa-collection-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Falls back to a collection with the handle best-sellers." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 11, "step": 1, "default": 7 },
    { "type": "text", "id": "all_tab", "label": "First tab", "default": "All" },
    { "type": "text", "id": "tabs", "label": "Family tabs (comma separated)", "info": "Matched against the custom.family metafield or the product type.", "default": "Woody, Fresh, Floral, Aromatic" },
    { "type": "text", "id": "product_label", "label": "Line under each product", "default": "Eau de Parfum" },
    { "type": "text", "id": "all_label", "label": "Link label", "default": "Shop all fragrances" },
    { "type": "url", "id": "all_url", "label": "Link" },

    { "type": "header", "content": "Discovery Collection" },
    { "type": "product", "id": "discovery_product", "label": "Discovery set product" },
    { "type": "image_picker", "id": "discovery_image", "label": "Image" },
    { "type": "text", "id": "discovery_eyebrow", "label": "Eyebrow", "default": "Discover the House" },
    { "type": "text", "id": "discovery_title", "label": "Title (when no product is picked)", "default": "The Discovery Collection" },
    { "type": "textarea", "id": "discovery_text", "label": "Text", "default": "Wear the House at home before you choose a full bottle." },
    { "type": "text", "id": "discovery_cta", "label": "Button label", "default": "Explore the set" },
    { "type": "url", "id": "discovery_url", "label": "Link when no product is picked" }
  ],
  "presets": [{ "name": "HOA The Collection" }]
}
{% endschema %}
