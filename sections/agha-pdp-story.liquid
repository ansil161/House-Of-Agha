{% comment %}
  AGHA PDP — 04 STORY
  Split layout: rounded image (optionally a close-up crop of the product photo) beside the story.
  Falls back to product metafields custom.story_heading / custom.story; the fact pills come from
  custom.family / custom.mood / custom.sillage.
{% endcomment %}
{%- liquid
  assign heading = section.settings.heading | default: product.metafields.custom.story_heading.value
  assign body = section.settings.body | default: product.metafields.custom.story.value
  assign image = section.settings.image | default: product.featured_image
  assign mf_family = product.metafields.custom.family.value
  assign mf_mood = product.metafields.custom.mood.value
  assign mf_sillage = product.metafields.custom.sillage.value
  assign zoom = section.settings.zoom | divided_by: 100.0
-%}

{%- if heading != blank -%}
<section class="pdp pdp-section pdp-story" data-pdp-story>
  <div class="container pdp-story__grid">
    {%- if image -%}
      <div class="pdp-story__media" data-pdp-story-media style="--pdp-focal: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%; --pdp-zoom: {{ zoom }};">
        <div class="pdp-story__zoom">
          {%- assign image_alt = image.alt | default: product.title -%}
          {{ image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 901px) 50vw, 100vw', loading: 'lazy', alt: image_alt }}
        </div>
      </div>
    {%- endif -%}
    <div data-pdp-reveal>
      <span class="pdp-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="pdp-story__title">{{ heading }}</h2>
      {%- if body != blank -%}<div class="pdp-story__body">{{ body }}</div>{%- endif -%}
      {%- if mf_family != blank or mf_mood != blank or mf_sillage != blank -%}
        <div class="pdp-story__facts">
          {%- if mf_family != blank -%}<span class="pdp-chip">{{ mf_family }}</span>{%- endif -%}
          {%- if mf_mood != blank -%}<span class="pdp-chip">Mood · {{ mf_mood }}</span>{%- endif -%}
          {%- if mf_sillage != blank -%}<span class="pdp-chip">Sillage · {{ mf_sillage }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Agha PDP · Story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The story" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the custom.story_heading metafield." },
    { "type": "richtext", "id": "body", "label": "Text", "info": "Leave blank to use the custom.story metafield." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the product's featured image." },
    { "type": "range", "id": "zoom", "label": "Close-up zoom", "min": 100, "max": 250, "step": 10, "unit": "%", "default": 190 },
    { "type": "range", "id": "focal_x", "label": "Focus (horizontal)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y", "label": "Focus (vertical)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 56 }
  ]
}
{% endschema %}
