{% comment %}
  AGHA PDP — 07 FAQ
{% endcomment %}
{%- if section.blocks.size > 0 -%}
<section class="pdp pdp-section pdp-faq">
  <div class="container pdp-faq__wrap">
    <header class="pdp-heading" data-pdp-reveal>
      <span class="pdp-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </header>
    <div class="pdp-accordion" data-pdp-reveal>
      {%- for block in section.blocks -%}
        <details data-pdp-accordion {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="pdp-accordion__icon" aria-hidden="true"></span></summary>
          <div class="pdp-accordion__body">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Agha PDP · FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you choose" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How many sprays should I use?" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ]
}
{% endschema %}
