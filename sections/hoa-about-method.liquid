{%- comment -%}
  House of Agha · About 04 · How we work
  Bento of four cells: three photographs with a short caption each, and one tinted
  facts cell. Grid collapses to one column under 760px.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="hoa-ab-method">
  <div class="hoa-wrap">
    <h2 class="hoa-h2 hoa-ab-method__title" data-hoa-ab-up>{{ s.heading }}{% if s.heading_serif != blank %} <em>{{ s.heading_serif }}</em>{% endif %}</h2>

    <div class="hoa-ab-bento">
      <article class="hoa-ab-cell hoa-ab-cell--place" data-hoa-ab-up>
        <figure class="hoa-ab-cell__media">
          {%- render 'hoa-img', name: s.place_asset, image: s.place_image, w: 2000, h: 1125, alt: s.place_alt, sizes: '(min-width: 760px) 62vw, 100vw' -%}
        </figure>
        <div class="hoa-ab-cell__body">
          <h3>{{ s.place_title }}</h3>
          <p>{{ s.place_text }}</p>
        </div>
      </article>

      <article class="hoa-ab-cell hoa-ab-cell--facts" data-hoa-ab-up>
        <dl class="hoa-ab-facts">
          {%- for i in (1..3) -%}
            {%- liquid
              assign fv = 'fact_' | append: i | append: '_value'
              assign fl = 'fact_' | append: i | append: '_label'
            -%}
            {%- if s[fv] != blank -%}
              <div><dt>{{ s[fl] }}</dt><dd>{{ s[fv] }}</dd></div>
            {%- endif -%}
          {%- endfor -%}
        </dl>
      </article>

      <article class="hoa-ab-cell hoa-ab-cell--materials" data-hoa-ab-up>
        <figure class="hoa-ab-cell__media">
          {%- render 'hoa-img', name: s.materials_asset, image: s.materials_image, w: 969, h: 969, alt: s.materials_alt, sizes: '(min-width: 760px) 30vw, 100vw' -%}
        </figure>
        <div class="hoa-ab-cell__body">
          <h3>{{ s.materials_title }}</h3>
          <p>{{ s.materials_text }}</p>
        </div>
      </article>

      <article class="hoa-ab-cell hoa-ab-cell--bottle" data-hoa-ab-up>
        <figure class="hoa-ab-cell__media">
          {%- render 'hoa-img', name: s.bottle_asset, image: s.bottle_image, w: 1086, h: 1448, alt: s.bottle_alt, sizes: '(min-width: 760px) 30vw, 100vw' -%}
        </figure>
        <div class="hoa-ab-cell__body">
          <h3>{{ s.bottle_title }}</h3>
          <p>{{ s.bottle_text }}</p>
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About: how we work",
  "tag": "div",
  "class": "hoa-ab-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How a fragrance" },
    { "type": "text", "id": "heading_serif", "label": "Heading, serif part", "default": "comes together." },
    { "type": "header", "content": "Place" },
    { "type": "text", "id": "place_title", "label": "Title", "default": "A place comes first" },
    { "type": "textarea", "id": "place_text", "label": "Text", "default": "Black sand, cold stone, a garden in late sun. Each fragrance starts from one setting and stays true to it." },
    { "type": "image_picker", "id": "place_image", "label": "Image (landscape)" },
    { "type": "text", "id": "place_asset", "label": "Fallback theme asset", "default": "hoa-craft-sand" },
    { "type": "text", "id": "place_alt", "label": "Alt text", "default": "Oud of Dark Paradise standing on dark sand in a beam of light" },
    { "type": "header", "content": "Materials" },
    { "type": "text", "id": "materials_title", "label": "Title", "default": "Materials from that world" },
    { "type": "textarea", "id": "materials_text", "label": "Text", "default": "Tobacco leaf and moss, bergamot and jasmine, oud wood and sea salt." },
    { "type": "image_picker", "id": "materials_image", "label": "Image (square)" },
    { "type": "text", "id": "materials_asset", "label": "Fallback theme asset", "default": "hoa-ingredients-tobacco" },
    { "type": "text", "id": "materials_alt", "label": "Alt text", "default": "Tobacco Enigma surrounded by moss, bergamot, lemon, cinnamon and jasmine" },
    { "type": "header", "content": "Bottle" },
    { "type": "text", "id": "bottle_title", "label": "Title", "default": "A bottle of its own" },
    { "type": "textarea", "id": "bottle_text", "label": "Text", "default": "No shared flacon. Each fragrance gets its own glass, cap and colour." },
    { "type": "image_picker", "id": "bottle_image", "label": "Image (portrait)" },
    { "type": "text", "id": "bottle_asset", "label": "Fallback theme asset", "default": "hoa-shamamah-lily" },
    { "type": "text", "id": "bottle_alt", "label": "Alt text", "default": "Shamamah with its crystal cap among golden lilies" },
    { "type": "header", "content": "Facts" },
    { "type": "text", "id": "fact_1_value", "label": "Fact 1 value", "default": "7" },
    { "type": "text", "id": "fact_1_label", "label": "Fact 1 label", "default": "Fragrances" },
    { "type": "text", "id": "fact_2_value", "label": "Fact 2 value", "default": "4" },
    { "type": "text", "id": "fact_2_label", "label": "Fact 2 label", "default": "Scent families" },
    { "type": "text", "id": "fact_3_value", "label": "Fact 3 value", "default": "EDP" },
    { "type": "text", "id": "fact_3_label", "label": "Fact 3 label", "default": "Eau de Parfum" }
  ],
  "presets": [{ "name": "About: how we work" }]
}
{% endschema %}
