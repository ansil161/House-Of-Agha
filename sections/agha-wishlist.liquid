{% comment %}
  WISHLIST PAGE  (/pages/wishlist  ·  templates/page.wishlist.json)
  ---------------------------------------------------------------------------
  Guests: a login-required state that sends them to Shopify's own login page and back here
  (routes.account_login_url ?return_url=/pages/wishlist). No forms, no credentials, nothing custom.
  Customers: assets/agha-wishlist-page.js reads the saved list from assets/agha-wishlist.js
  (stored by the wishlist app / proxy, see that file) and fills the grid from each product's
  public /products/{handle}.js. States: loading, list, empty, error.
{% endcomment %}

{%- assign s = section.settings -%}
{%- capture heart_svg -%}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 17.3S2.3 12.6 1 8.1C.2 5.2 2 2.4 5 2.4c2 0 3.6 1.2 5 3.1 1.4-1.9 3-3.1 5-3.1 3 0 4.8 2.8 4 5.7-1.3 4.5-9 9.2-9 9.2Z" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>{%- endcapture -%}

<section class="hoa-wl" data-wl-page{% if customer %} data-wl-customer{% endif %}>
  <div class="hoa-wrap">
    <header class="hoa-wl__head">
      <p class="hoa-wl__crumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>{{ s.eyebrow }}</p>
      <h1 class="hoa-wl__title">{{ s.heading }} <em>{{ s.heading_italic }}</em><sup class="hoa-wl__count" data-wl-count></sup></h1>
      {%- if customer and s.text != blank -%}<p class="hoa-wl__lede">{{ s.text }}</p>{%- endif -%}
    </header>

    {%- if customer == nil -%}
      <div class="hoa-wl__state hoa-wl__state--login" role="status">
        <span class="hoa-wl__mark" aria-hidden="true">{{ heart_svg }}</span>
        <h2 class="hoa-wl__state-title">{{ s.login_title }}</h2>
        <p class="hoa-wl__state-text">{{ s.login_text }}</p>
        <a class="hoa-btn" href="{{ routes.account_login_url }}?return_url={{ request.path | default: '/pages/wishlist' | url_encode }}">
          <span>{{ s.login_button }}</span>{% render 'hoa-btn-icon' %}
        </a>
      </div>
    {%- else -%}
      <div class="hoa-wl__grid hoa-wl__grid--skeleton" data-wl-loading aria-hidden="true">
        {%- for i in (1..4) -%}<div class="hoa-wl-card hoa-wl-card--skeleton"><span class="hoa-wl-card__media"></span><span class="hoa-wl-card__line"></span><span class="hoa-wl-card__line hoa-wl-card__line--short"></span></div>{%- endfor -%}
      </div>

      <div class="hoa-wl__grid" data-wl-grid aria-live="polite" hidden></div>

      <div class="hoa-wl__state" data-wl-empty hidden>
        <span class="hoa-wl__mark hoa-wl__mark--draw" aria-hidden="true">{{ heart_svg }}</span>
        <h2 class="hoa-wl__state-title">{{ s.empty_title }}</h2>
        <p class="hoa-wl__state-text">{{ s.empty_text }}</p>
        <a class="hoa-btn" href="{{ s.empty_link | default: routes.all_products_collection_url }}">
          <span>{{ s.empty_button }}</span>{% render 'hoa-btn-icon' %}
        </a>
      </div>

      <div class="hoa-wl__state" data-wl-error role="alert" hidden>
        <h2 class="hoa-wl__state-title">We couldn’t load your wishlist</h2>
        <p class="hoa-wl__state-text">Something went wrong on our side, or your connection dropped. Your saved fragrances are safe.</p>
        <button type="button" class="hoa-btn" data-wl-retry><span>Try again</span>{% render 'hoa-btn-icon' %}</button>
      </div>

      <noscript><p class="hoa-wl__state-text">Your wishlist needs JavaScript to load.</p></noscript>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Breadcrumb label", "default": "Wishlist" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your" },
    { "type": "text", "id": "heading_italic", "label": "Heading (italic word)", "default": "wishlist" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Fragrances you have saved, kept with your account." },
    { "type": "header", "content": "Empty state" },
    { "type": "text", "id": "empty_title", "label": "Title", "default": "Your Wishlist is Empty" },
    { "type": "textarea", "id": "empty_text", "label": "Text", "default": "Fragrances you save will appear here, so you can return to them whenever you are ready." },
    { "type": "text", "id": "empty_button", "label": "Button label", "default": "Explore Fragrances" },
    { "type": "url", "id": "empty_link", "label": "Button link" },
    { "type": "header", "content": "Signed-out state" },
    { "type": "text", "id": "login_title", "label": "Title", "default": "Sign in to view your wishlist" },
    { "type": "textarea", "id": "login_text", "label": "Text", "default": "Your saved fragrances are kept with your account." },
    { "type": "text", "id": "login_button", "label": "Button label", "default": "Login to View Wishlist" }
  ],
  "presets": [{ "name": "Wishlist" }]
}
{% endschema %}
