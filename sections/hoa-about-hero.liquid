{%- comment -%}
  House of Agha · About 01 · Opening
  Asymmetric split: headline and intro on the left, one campaign portrait with a
  product cutout overlapping it on the right. Motion in assets/hoa-about.js.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="hoa-ab-hero" data-hoa-ab-hero>
  <div class="hoa-wrap hoa-ab-hero__grid">
    <div class="hoa-ab-hero__copy">
      {%- if s.eyebrow != blank -%}<p class="hoa-eyebrow" data-hoa-ab-line>{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="hoa-ab-hero__title">
        <span class="hoa-ab-mask"><span data-hoa-ab-rise>{{ s.heading }}</span></span>
        {%- if s.heading_serif != blank -%}
          <span class="hoa-ab-mask"><em data-hoa-ab-rise>{{ s.heading_serif }}</em></span>
        {%- endif -%}
      </h1>
      {%- if s.text != blank -%}<p class="hoa-lede hoa-ab-hero__text" data-hoa-ab-line>{{ s.text }}</p>{%- endif -%}
      {%- if s.cta_label != blank -%}
        <a class="hoa-btn" href="{{ s.cta_url | default: '#worlds' }}" data-hoa-ab-line><span>{{ s.cta_label }}</span>{% render 'hoa-btn-icon' %}</a>
      {%- endif -%}
    </div>

    <div class="hoa-ab-hero__media">
      <figure class="hoa-ab-hero__main" data-hoa-ab-clip>
        <div class="hoa-ab-hero__drift" data-hoa-ab-drift>
          {%- render 'hoa-img', name: s.asset_main, image: s.image_main, w: 1200, h: 2150, alt: s.alt_main, sizes: '(min-width: 900px) 34vw, 90vw', loading: 'eager', priority: true -%}
        </div>
      </figure>
      <figure class="hoa-ab-hero__cutout" data-hoa-ab-float>
        {%- render 'hoa-img', name: s.asset_cutout, image: s.image_cutout, w: 1200, h: 1500, alt: s.alt_cutout, sizes: '(min-width: 900px) 16vw, 40vw', loading: 'eager' -%}
      </figure>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About: opening",
  "tag": "div",
  "class": "hoa-ab-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About the House" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seven fragrances." },
    { "type": "text", "id": "heading_serif", "label": "Heading, serif line", "default": "Seven places." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "House of Agha makes eaux de parfum. Each one is built around a single place, and dressed in a bottle of its own." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Meet the fragrances" },
    { "type": "url", "id": "cta_url", "label": "Button link", "info": "Leave empty to scroll to the fragrances section." },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_main", "label": "Main image (tall portrait)" },
    { "type": "text", "id": "asset_main", "label": "Fallback theme asset", "default": "hoa-world-portrait" },
    { "type": "text", "id": "alt_main", "label": "Main image alt text", "default": "A man in a white shirt holds a bottle of Oud Fury in warm evening light" },
    { "type": "image_picker", "id": "image_cutout", "label": "Bottle cutout (white background)" },
    { "type": "text", "id": "asset_cutout", "label": "Fallback theme asset", "default": "hoa-product-shamamah" },
    { "type": "text", "id": "alt_cutout", "label": "Cutout alt text", "default": "Shamamah Eau de Parfum bottle with a crystal cap" }
  ],
  "presets": [{ "name": "About: opening" }]
}
{% endschema %}
