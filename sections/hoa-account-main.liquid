{% comment %}
  ACCOUNT · Overview (templates/customers/account.json)
  Shopify only serves this page to a signed-in customer; everything below reads
  the native `customer` object. Sign out uses Shopify's routes.account_logout_url.
{% endcomment %}

{%- assign s = section.settings -%}
<section class="hoa-acct">
  <div class="hoa-wrap">
    {%- assign first_name = customer.first_name | default: 'there' -%}
    {%- render 'hoa-account-head', title: 'Hello,', italic: first_name, crumb: 'Account', current: 'orders', customer: customer -%}

    <div class="hoa-acct__grid">
      <div class="hoa-acct__main">
        <h2 class="hoa-acct__h2">Order history{% if customer.orders_count > 0 %}<sup>{{ customer.orders_count }}</sup>{% endif %}</h2>

        {%- paginate customer.orders by s.per_page -%}
          {%- if customer.orders.size > 0 -%}
            <table class="hoa-orders">
              <thead>
                <tr>
                  <th scope="col">Order</th>
                  <th scope="col">Date</th>
                  <th scope="col">Payment</th>
                  <th scope="col">Status</th>
                  <th scope="col" class="hoa-orders__num">Total</th>
                  <th scope="col"><span class="hoa-visually-hidden">Details</span></th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  {%- liquid
                    if order.cancelled
                      assign status = 'cancelled'
                      assign status_label = 'Cancelled'
                    else
                      assign status = order.fulfillment_status | default: 'unfulfilled'
                      assign status_label = order.fulfillment_status_label | default: 'Unfulfilled'
                    endif
                  -%}
                  <tr>
                    <th scope="row" data-label="Order"><a class="hoa-orders__id" href="{{ order.customer_url }}">{{ order.name }}</a></th>
                    <td data-label="Date"><time datetime="{{ order.created_at | date: '%Y-%m-%d' }}">{{ order.created_at | date: '%b %-d, %Y' }}</time></td>
                    <td data-label="Payment">{{ order.financial_status_label }}</td>
                    <td data-label="Status"><span class="hoa-status" data-status="{{ status }}">{{ status_label }}</span></td>
                    <td data-label="Total" class="hoa-orders__num">{{ order.total_price | money }}</td>
                    <td class="hoa-orders__go"><a href="{{ order.customer_url }}" aria-label="View order {{ order.name }}">View <span aria-hidden="true">&rarr;</span></a></td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {%- if paginate.pages > 1 -%}
              <nav class="hoa-pagination" aria-label="Order pages">
                {{ paginate | default_pagination: next: 'Older', previous: 'Newer' }}
              </nav>
            {%- endif -%}
          {%- else -%}
            <div class="hoa-acct__empty">
              <p class="hoa-acct__empty-title">No orders <em>yet</em></p>
              <p>When you place an order it will appear here, with its status and tracking.</p>
              <a class="hoa-btn" href="{{ routes.all_products_collection_url }}">Explore the fragrances{% render 'hoa-btn-icon' %}</a>
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>

      <aside class="hoa-acct__aside">
        <div class="hoa-acct__block">
          <h2 class="hoa-acct__h2">Account details</h2>
          <dl class="hoa-dl">
            <div><dt>Name</dt><dd>{{ customer.name | default: '—' }}</dd></div>
            <div><dt>Email</dt><dd>{{ customer.email }}</dd></div>
            {%- if customer.phone != blank -%}<div><dt>Phone</dt><dd>{{ customer.phone }}</dd></div>{%- endif -%}
            <div>
              <dt>Default address</dt>
              <dd>
                {%- if customer.default_address -%}
                  <address>{{ customer.default_address | format_address }}</address>
                {%- else -%}
                  No address saved yet.
                {%- endif -%}
              </dd>
            </div>
          </dl>
          <a class="hoa-acct__link" href="{{ routes.account_addresses_url }}">Manage addresses{% if customer.addresses_count > 0 %} ({{ customer.addresses_count }}){% endif %} <span aria-hidden="true">&rarr;</span></a>
        </div>

        <div class="hoa-acct__actions">
          <a class="hoa-btn hoa-btn--block" href="{{ routes.all_products_collection_url }}"><span>Continue shopping</span>{% render 'hoa-btn-icon' %}</a>
          <a class="hoa-acct__signout" href="{{ routes.account_logout_url }}" data-hoa-logout>Sign out</a>
        </div>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HOA Account overview",
  "tag": "div",
  "class": "hoa-acct-section",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Orders per page", "min": 5, "max": 25, "step": 5, "default": 10 }
  ]
}
{% endschema %}
