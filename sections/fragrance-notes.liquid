{% comment %}
  HOUSE OF AGHA — SCENT NOTES (PDP, notes_cards in product.json)
  2026-10-12 refactor (user's UX brief + responsive brief). One markup, one data source; only the
  layout changes per breakpoint (mobile-first, min-width queries):

    < 768 px ........ stacked: heading → bottle (≤70vw) → scent line → Top / Heart / Base cards
                      (3 notes a row, 2 when 3 don't fit) → buy row; the Add-to-bag button sticks
                      to the bottom of the screen while the section is on screen (safe-area aware).
                      Landscape phones (height < 500) keep this layout, button not sticky.
    768–1023 px ..... 2 columns: bottle left, the three cards stacked right, -2° tilt, no overlap.
    ≥ 1024 px ....... floating: bottle centred, Top upper-left, Heart right-middle, Base lower-left,
                      each tucked ≤ 28px (≈8% of its width) behind the glass; the tucked end is
                      padding, so no note circle is ever covered. One tilt (-4°) on the card
                      background only, text stays horizontal. ≥ 760 px tall: the section pins and
                      each scroll step brings in the next card (reversible).

  Data (never hard-coded)
    Notes ....... custom.top_notes / heart_notes / base_notes via snippets/agha-pdp-data (→ the
                  live-store notes while metafields are empty); a block with source "none" uses its
                  own list. 1–4 notes per card (setting "Notes per card", default 3); an empty
                  card is not rendered; no notes at all = no section.
    Scent line .. custom.scent_tags ("Smoky. Resinous. Warm.") → custom.scent_character →
                  the section's fallback line.
    Colours ..... each block's card / text colour → --note-top / --note-heart / --note-base
                  (+ -ink), all text ≥ 4.5:1 on its card.
    Photos ...... snippets/agha-note-image set 'sn' (120px sources), a letter when missing.
    Bottle ...... section image → assets/hoa-bottle-<handle>.webp → product.featured_image.
    Buy row ..... mirrors the product form of the main section ([data-pdp-form]): size chips click
                  its option radios, the price follows its [data-pdp-price], the button presses its
                  Add-to-bag. Hidden when there is no such form. While the section is on screen the
                  page's own buy dock is hidden (html.sn-cta-on), so there is one buy bar at a time.
  Local preview: assets/pdp-preview.js mirrors the markup and reuses this file's style and
  script blocks (matched at the start of a line — never start a comment line with one).
{% endcomment %}

{%- capture pdp_json -%}{%- render 'agha-pdp-data' -%}{%- endcapture -%}
{%- assign pdp = pdp_json | parse_json -%}
{%- liquid
  assign s = section.settings
  assign max_notes = s.max_notes | default: 3
  assign cutouts = 'agha-blue,dark-paradise,maha,oud-fury,sea-smoke,shamamah,tobacco-enigma' | split: ','
  assign product_title = product.title | default: 'House of Agha'
  assign bottle_alt = product_title | append: ' bottle'
  assign has_cutout = false
  assign cut_key = product.handle | remove: 'oud-of-'
  if cut_key == 'dark-paradise-oud'
    assign cut_key = 'dark-paradise'
  endif
  if product and cutouts contains cut_key
    assign has_cutout = true
    assign cut = 'hoa-bottle-' | append: cut_key | append: '.webp'
  endif

  comment
    One line about the scent, from product data: tags as "Smoky. Resinous. Warm.", else the character line
  endcomment
  assign scent_line = ''
  if pdp.scent_tags != blank
    assign scent_line = pdp.scent_tags | join: '. ' | append: '.'
  elsif pdp.scent_character != blank
    assign scent_line = pdp.scent_character
  endif
  if scent_line == blank
    assign scent_line = s.subheading
  endif

  comment
    Palette: each card's colours become section variables, keyed by the note level it shows
  endcomment
  assign palette = ''
  assign any_notes = false
  for block in section.blocks limit: 3
    assign lvl = block.settings.notes_source
    if lvl == 'none'
      assign lvl = 'top,heart,base' | split: ',' | slice: forloop.index0 | first
    endif
    assign palette = palette | append: '--note-' | append: lvl | append: ': ' | append: block.settings.card_color | append: '; --note-' | append: lvl | append: '-ink: ' | append: block.settings.text_color | append: '; '
    case block.settings.notes_source
      when 'top'
        if pdp.top_notes != blank
          assign any_notes = true
        endif
      when 'heart'
        if pdp.heart_notes != blank
          assign any_notes = true
        endif
      when 'base'
        if pdp.base_notes != blank
          assign any_notes = true
        endif
      else
        if block.settings.caption != blank
          assign any_notes = true
        endif
    endcase
  endfor
  assign current_variant = product.selected_or_first_available_variant
-%}

<style>
  /* ======================================================================
     SCENT NOTES — scoped to .sn. Mobile first; min-width queries only.
     li.sn-card ....... placement (desktop) + entrance motion
     .sn-card__body ... the card; its tinted background is ::before (the only thing tilted)
     ====================================================================== */
  .sn {
    --note-top: #ffffff;   --note-top-ink: #2b2620;
    --note-heart: #b9c7a5; --note-heart-ink: #2c3a24;
    --note-base: #ead08a;  --note-base-ink: #3d2f17;
    --sn-ink: #1a1a1a;
    --sn-muted: #5a5349;                       /* 7:1 on the paper */
    --fs-head: clamp(1.5rem, 4vw, 2.5rem);
    --fs-title: clamp(0.875rem, 1.5vw, 1rem);
    --fs-note: clamp(0.6875rem, 1.1vw, 0.8125rem);   /* 11px → 13px */
    --pic: 52px;                               /* note circle (was 60; compact pass 2026-10-13) */
    --col: 84px;                               /* one note's column (was 94) */
    --tilt: 0deg;
    position: relative;
    background: var(--sn-bg, #f6f4ee);
    color: var(--sn-ink);
    padding: 40px 16px 0;
  }
  .sn *, .sn *::before, .sn *::after { box-sizing: border-box; }
  .sn__inner { max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; }

  /* ---------- heading (mobile: its parts join the column order) ---------- */
  .sn__head { display: contents; }
  .sn__eyebrow {
    order: 1;
    margin: 0 0 8px;
    font: 600 0.75rem/1.4 var(--hoa-sans, system-ui, sans-serif);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sn-muted);
    text-align: center;
  }
  .sn .sn__title {
    order: 1;
    margin: 0;
    font: 400 var(--fs-head)/1.15 var(--font-didot, 'Didot', Georgia, serif);
    letter-spacing: 0.01em;
    color: var(--sn-ink);
    text-align: center;
    text-wrap: balance;
  }
  .sn__lede {
    order: 3;
    max-width: 36ch;
    margin: 18px 0 0;
    font: 500 1rem/1.5 var(--hoa-sans, system-ui, sans-serif);
    letter-spacing: 0.01em;
    color: var(--sn-muted);
    text-align: center;
  }
  .sn__cue { display: none; }

  /* ---------- stage ---------- */
  .sn__stage { display: contents; }
  .sn__bottle { order: 2; position: relative; margin-top: 24px; }
  .sn__img {
    display: block;
    height: clamp(260px, 78vw, 340px);
    width: auto;
    max-width: 70vw;
    object-fit: contain;
  }
  .sn__shadow {                                   /* soft contact shadow */
    position: absolute;
    left: 50%;
    top: calc(100% - 8px);
    width: 170%;
    height: 22px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(40, 28, 16, 0.3), transparent);
    z-index: -1;
  }
  /* the still life sits centred under the bottle, at its foot (2026-10-13; was desktop-only, right of the glass) */
  .sn__pile {
    order: 2;
    display: block;
    width: min(64vw, 280px);
    height: auto;
    margin-top: -14px;
    position: relative;
    z-index: 1;
    pointer-events: none;
    filter: drop-shadow(0 8px 8px rgba(40, 28, 16, 0.2));
  }

  /* ---------- note cards ---------- */
  .sn__cards { order: 4; list-style: none; width: 100%; max-width: 560px; margin: 28px 0 0; padding: 0; display: grid; gap: 14px; }
  .sn-card[data-level="top"]   { --c-bg: var(--note-top);   --c-ink: var(--note-top-ink); }
  .sn-card[data-level="heart"] { --c-bg: var(--note-heart); --c-ink: var(--note-heart-ink); }
  .sn-card[data-level="base"]  { --c-bg: var(--note-base);  --c-ink: var(--note-base-ink); }
  .sn-card__body { position: relative; isolation: isolate; padding: 14px 10px 14px; color: var(--c-ink); }
  .sn-card__body::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 28px;
    background: radial-gradient(120% 90% at 30% 10%, rgba(255, 255, 255, 0.28), transparent 60%), var(--c-bg);
    box-shadow: inset 0 0 0 1px rgba(26, 26, 26, 0.07), 0 2px 4px rgba(40, 28, 16, 0.05), 0 18px 36px -22px rgba(40, 28, 16, 0.45);
    transform: rotate(var(--tilt));
  }
  .sn-card__label {
    margin: 0 0 8px;
    font: 700 var(--fs-title)/1.3 var(--hoa-sans, system-ui, sans-serif);
    letter-spacing: 0.01em;
    text-align: center;
    color: var(--c-ink);
  }
  /* 3 a row; the 3rd wraps (centred) when 3 don't fit; never truncated */
  .sn-card__notes { list-style: none; margin: 0 auto; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 4px; }
  .sn-note { flex: 0 0 var(--col); display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 0; }
  .sn-note__pic {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--pic);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.45);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.8), 0 8px 16px -8px rgba(30, 20, 10, 0.5);
    font: 400 1.25rem/1 var(--font-didot, Georgia, serif);
    color: var(--c-ink);
    transition: transform 0.45s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .sn-note__pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .sn-note__name {
    max-width: 100%;
    font: 500 max(11px, var(--fs-note))/1.35 var(--hoa-sans, system-ui, sans-serif);
    letter-spacing: 0.01em;
    text-align: center;
    color: var(--c-ink);
    overflow-wrap: break-word;
    hyphens: auto;
  }

  /* ---------- buy row: name + price, size chips, Add to bag ---------- */
  .sn-purchase { display: contents; }
  .sn-purchase[hidden] { display: none; }
  .sn-buy { order: 5; width: 100%; max-width: 560px; margin-top: 32px; display: grid; gap: 14px; justify-items: center; text-align: center; }
  .sn-buy__name { margin: 0; font: 400 1.5rem/1.2 var(--font-didot, Georgia, serif); color: var(--sn-ink); }
  .sn-buy__price { margin: 4px 0 0; font: 600 1rem/1.4 var(--hoa-sans, system-ui, sans-serif); color: var(--sn-ink); }
  .sn-buy__sizes { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 0; padding: 0; border: 0; }
  .sn-buy__sizes:empty { display: none; }
  .sn-size {
    min-width: 44px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid rgba(26, 26, 26, 0.22);
    border-radius: 999px;
    background: #fff;
    color: var(--sn-ink);
    font: 600 0.8125rem/1 var(--hoa-sans, system-ui, sans-serif);
    letter-spacing: 0.02em;
    cursor: pointer;
  }
  .sn-size[aria-pressed="true"] { background: var(--sn-ink); border-color: var(--sn-ink); color: #fff; }
  .sn-size:disabled { opacity: 0.45; text-decoration: line-through; cursor: not-allowed; }
  .sn-size:focus-visible, .sn-add:focus-visible { outline: 2px solid var(--sn-ink); outline-offset: 3px; }

  /* the button: sticky at the bottom of the screen while the section is on screen (phones) */
  .sn-cta {
    order: 6;
    position: sticky;
    bottom: 0;
    z-index: 20;
    width: calc(100% + 32px);
    margin: 18px -16px 0;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    background: rgba(246, 244, 238, 0.94);
    -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
    box-shadow: 0 -1px 0 rgba(26, 26, 26, 0.06);
  }
  .sn-add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 48px;
    padding: 0 24px;
    border: 0;
    border-radius: 999px;
    background: var(--sn-ink);
    color: #fff;
    font: 700 0.875rem/1 var(--hoa-sans, system-ui, sans-serif);
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .sn-add:disabled { opacity: 0.5; cursor: not-allowed; }
  .sn-add__price { font-weight: 500; opacity: 0.8; }
  /* the page's own buy dock steps aside while this sticky button shows */
  html.sn-cta-on .pdp-dock { opacity: 0 !important; visibility: hidden !important; pointer-events: none !important; }

  /* landscape phones: same stacked layout, the button is not sticky */
  @media (max-height: 499px) {
    .sn-cta { position: static; width: 100%; margin: 18px 0 0; padding: 0 0 40px; background: none; -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: none; }
  }

  /* ---------- entrance (JS adds data-sn-ready; no JS = all shown) ---------- */
  .sn[data-sn-ready] .sn-card { opacity: 0; transform: translateY(16px); transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  .sn[data-sn-ready] .sn-card.is-on { opacity: 1; transform: none; }

  @media (hover: hover) {
    .sn-card:hover .sn-note__pic { transform: scale(1.05); }
    .sn-size:hover:not(:disabled):not([aria-pressed="true"]) { border-color: var(--sn-ink); }
    .sn-add:hover:not(:disabled) { background: #333; }
  }

  /* ======================================================================
     TABLET 768–1023: two columns — bottle left, the three cards stacked right
     ====================================================================== */
  @media (min-width: 768px) and (min-height: 500px) {
    .sn { --tilt: -2deg; --col: 84px; padding: 64px 32px 72px; }
    .sn__head { display: block; max-width: 640px; margin: 0 auto; text-align: center; }
    .sn__eyebrow, .sn .sn__title, .sn__lede { margin-left: auto; margin-right: auto; }
    .sn__lede { margin-top: 14px; }
    .sn__stage {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
      gap: 32px;
      width: 100%;
      max-width: 860px;
      margin-top: 48px;               /* clear space between the heading and the cap */
    }
    .sn__bottle { margin: 0; justify-self: center; grid-column: 1; grid-row: 1; align-self: end; }
    .sn__pile { grid-column: 1; grid-row: 2; justify-self: center; align-self: start; width: min(30vw, 280px); margin-top: -46px; }   /* -32px row gap, then tuck */
    .sn__img { height: clamp(380px, 52vw, 500px); max-width: none; }
    .sn__cards { grid-column: 2; grid-row: 1 / span 2; align-self: center; justify-self: start; width: 100%; max-width: 380px; margin: 0; gap: 14px; }
    .sn-card__body { padding: 14px 14px 16px; }
    .sn-purchase { display: flex; order: 5; width: 100%; max-width: 860px; margin-top: 44px; padding: 16px 16px 16px 28px; align-items: center; gap: 20px; border-radius: 999px; background: #fff; box-shadow: inset 0 0 0 1px rgba(26, 26, 26, 0.07), 0 18px 40px -28px rgba(40, 28, 16, 0.5); }
    .sn-buy { margin: 0; max-width: none; flex: 1; display: flex; align-items: center; gap: 20px; justify-content: space-between; text-align: left; }
    .sn-buy__name { font-size: 1.375rem; }
    .sn-cta { position: static; width: auto; margin: 0; padding: 0; background: none; -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: none; }
    .sn-add { width: auto; min-width: 200px; }
  }

  /* ======================================================================
     DESKTOP ≥1024: floating — bottle centred, cards tucked in behind it
     ====================================================================== */
  @media (min-width: 768px) and (min-height: 500px) {   /* was ≥1024; tablets get the same floating layout (2026-10-13) */
    .sn {
      --bh: clamp(440px, 40vw, 580px);       /* bottle height: every card is placed from it */
      --bw: calc(var(--bh) * 0.38);          /* bottle width (cutouts are 289×760) */
      --edge: calc(var(--bw) * 0.49);        /* half the body width */
      --tuck: 28px;                          /* ≤ 8% of a card's width runs in behind the glass */
      --pw: calc(var(--bh) * 0.5);           /* still-life width (cutouts are ~900×250–350) */
      --sh: calc(var(--bh) * 0.94 + var(--pw) * 0.4 + 8px);    /* stage height: bottle + the still life at its foot */
      --tilt: -4deg;
      --col: clamp(80px, 6.6vw, 94px);       /* was 92–104; 74–86 split "Frankincense" at 13px */
      --pic: clamp(50px, 3.8vw, 60px);       /* was 60–72 */
      padding: clamp(64px, 6vw, 88px) clamp(24px, 3vw, 48px) clamp(72px, 7vw, 104px);
      overflow-x: clip;
    }
    .sn__stage { display: block; position: relative; height: var(--sh); max-width: none; }
    .sn__bottle { position: absolute; left: 50%; top: 0; z-index: 3; translate: -50% 0; }
    .sn__img { height: var(--bh); -webkit-box-reflect: below 0 linear-gradient(transparent 86%, rgba(0, 0, 0, 0.14)); }
    .sn__pile {                               /* the still life, centred under the bottle */
      position: absolute;
      z-index: 4;
      top: calc(var(--bh) * 0.94);           /* at the foot of the glass, in front of its base */
      left: 50%;
      translate: -50% 0;
      width: var(--pw);
      margin: 0;
    }
    .sn__cards { display: block; margin: 0; }
    .sn-card { position: absolute; z-index: 1; width: max-content; }
    /* Top: upper-left · Heart: right-middle · Base: lower-left — the same for every product */
    .sn-card[data-slot="1"] { right: calc(50% + var(--edge) - var(--tuck)); bottom: calc(var(--sh) - var(--bh) * 0.48); }   /* 2026-10-13: a little lower (was 0.41) */
    .sn-card[data-slot="2"] { left: calc(50% + var(--edge) - var(--tuck)); top: calc(var(--bh) * 0.24); }
    .sn-card[data-slot="3"] { right: calc(50% + var(--edge) - var(--tuck)); bottom: calc(var(--sh) - var(--bh) * 0.92); }   /* 2026-10-13: down at the foot, just above the still life (was top 0.56) */
    .sn-card__body { padding: 14px 14px 16px; }
    .sn-card__body::before { border-radius: 32px; }
    /* the end that runs in behind the glass is padding only: no note sits there */
    .sn-card[data-slot="1"] .sn-card__body, .sn-card[data-slot="3"] .sn-card__body { padding-right: calc(var(--tuck) + 14px); }
    .sn-card[data-slot="2"] .sn-card__body { padding-left: calc(var(--tuck) + 14px); }
    /* same card size on every product: room for 3 notes; 4 get a 4th column */
    .sn-card__notes { flex-wrap: nowrap; gap: 4px; width: calc(var(--col) * 3 + 8px); }
    .sn-card[data-n="4"] .sn-card__notes { width: calc(var(--col) * 4 + 12px); }

    .sn-purchase { max-width: 900px; margin-top: 36px; }

    /* gentle idle bob once a card has landed */
    .sn-card.is-on .sn-card__body { animation: sn-bob 4s ease-in-out 1.1s infinite alternate; }
    .sn-card[data-slot="2"] .sn-card__body { animation-duration: 4.6s; }
    .sn-card[data-slot="3"] .sn-card__body { animation-duration: 3.6s; }

    /* entrance: each card slides out from behind the glass */
    .sn[data-sn-ready] .sn__bottle { opacity: 0; translate: -50% 40px; transition: opacity 0.8s ease, translate 1s cubic-bezier(0.22, 1, 0.36, 1); }
    .sn[data-sn-ready].is-in .sn__bottle { opacity: 1; translate: -50% 0; }
    .sn[data-sn-ready] .sn__pile { opacity: 0; transition: opacity 0.8s ease 0.3s; }
    .sn[data-sn-ready].is-in .sn__pile { opacity: 1; }
    .sn[data-sn-ready] .sn-card { filter: blur(6px); transition: opacity 0.5s ease 0.4s, transform 0.85s cubic-bezier(0.5, -0.45, 0.66, 0) 0.2s, filter 0.5s ease 0.35s; }
    .sn[data-sn-ready] .sn-card[data-slot="1"], .sn[data-sn-ready] .sn-card[data-slot="3"] { transform: translateX(40%) scale(0.85); }
    .sn[data-sn-ready] .sn-card[data-slot="2"] { transform: translateX(-40%) scale(0.85); }
    .sn[data-sn-ready] .sn-card.is-on { opacity: 1; filter: none; transform: none; transition: opacity 0.5s ease, transform 1s cubic-bezier(0.34, 1.4, 0.5, 1), filter 0.6s ease; }
    .sn[data-sn-ready] .sn-note__pic { opacity: 0; transform: scale(0.3); transition: opacity 0.3s ease, transform 0.4s ease; }
    .sn[data-sn-ready] .sn-card.is-on .sn-note__pic { opacity: 1; transform: none; transition: opacity 0.35s ease var(--nd), transform 0.7s cubic-bezier(0.34, 1.6, 0.5, 1) var(--nd); }
    .sn-note:nth-child(1) { --nd: 0.3s; }
    .sn-note:nth-child(2) { --nd: 0.4s; }
    .sn-note:nth-child(3) { --nd: 0.5s; }
    .sn-note:nth-child(4) { --nd: 0.6s; }

    /* pinned scroll story (JS: ≥1024 wide and ≥760 tall) */
    .sn.sn--pin { height: calc(100svh + 150svh); padding-block: 0; }
    .sn--pin .sn__inner {
      position: sticky;
      top: var(--hoa-header-h, 76px);
      height: calc(100svh - var(--hoa-header-h, 76px));
      justify-content: center;
    }
    .sn.sn--pin { --bh: min(clamp(440px, 40vw, 580px), calc((100svh - var(--hoa-header-h, 76px) - 330px) / 1.15)); }
    .sn--pin .sn__stage { margin-top: 40px; }
    .sn--pin .sn-purchase { margin-top: 22px; }
    .sn--pin .sn__cue {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 10px;
      font: 600 0.75rem/1.4 var(--hoa-sans, system-ui, sans-serif);
      letter-spacing: 0.04em;
      color: var(--sn-muted);
      transition: opacity 0.4s ease;
    }
    .sn__cue svg { width: 14px; height: 14px; animation: sn-cue 1.6s ease-in-out infinite; }
    .sn.is-done .sn__cue { opacity: 0; }
  }
  /* 1024–1279 with 4 notes: narrower columns so the card still fits beside the bottle */
  @media (min-width: 1024px) and (max-width: 1279px) and (min-height: 500px) {
    .sn-card[data-n="4"] { --col: 74px; --pic: 48px; }
  }
  /* tablets 768–1023: the laptop composition, a size smaller so both sides fit beside the bottle */
  @media (min-width: 768px) and (max-width: 1023px) and (min-height: 500px) {
    .sn { --bh: clamp(400px, 52vw, 500px); --col: 76px; --pic: 46px; --tuck: 22px; padding-inline: 20px; }
    .sn-card[data-n="4"] { --col: 60px; --pic: 40px; }
  }

  /* ======================================================================
     PHONES <768: the same floating composition as the laptop: bottle in the
     centre, Top upper-left, Heart right, Base lower-left, still life at its foot.
     Three circles side by side don't fit beside the bottle, so each card lists
     its notes as rows (photo + name). 2026-10-13: the user wanted the laptop look here.
     ====================================================================== */
  @media (max-width: 767px), (max-height: 499px) {
    .sn {
      --bh: clamp(280px, 90vw, 400px);
      --bw: calc(var(--bh) * 0.38);
      --edge: calc(var(--bw) * 0.49);
      --tuck: 16px;
      --gut: 10px;                                /* page edge */
      --cw: min(180px, calc((100vw - 2 * var(--gut) - 2 * var(--edge) + 2 * var(--tuck)) / 2));
      --pw: calc(var(--bh) * 0.5);
      --sh: calc(var(--bh) * 0.94 + var(--pw) * 0.4 + 8px);
      --pic: clamp(26px, 7.6vw, 32px);
      --tilt: -3deg;
      padding: 48px var(--gut) 56px;
      overflow-x: clip;
    }
    .sn__head { display: block; text-align: center; }
    .sn__lede { margin: 12px auto 0; }
    .sn__stage { display: block; position: relative; width: 100%; height: var(--sh); margin-top: 28px; }
    .sn__bottle { position: absolute; left: 50%; top: 0; z-index: 3; margin: 0; translate: -50% 0; }
    .sn__img { height: var(--bh); max-width: none; }
    .sn__pile { position: absolute; z-index: 4; top: calc(var(--bh) * 0.94); left: 50%; translate: -50% 0; width: var(--pw); margin: 0; }
    .sn__cards { display: block; margin: 0; max-width: none; }
    .sn-card { position: absolute; z-index: 1; width: var(--cw); }
    .sn-card[data-slot="1"] { right: calc(50% + var(--edge) - var(--tuck)); top: calc(var(--bh) * 0.04); }
    .sn-card[data-slot="2"] { left: calc(50% + var(--edge) - var(--tuck)); top: calc(var(--bh) * 0.24); }
    .sn-card[data-slot="3"] { right: calc(50% + var(--edge) - var(--tuck)); top: calc(var(--bh) * 0.5); }
    .sn-card__body { padding: 10px 8px 12px; }
    .sn-card__body::before { border-radius: 22px; }
    /* the end that runs in behind the glass is padding only */
    .sn-card[data-slot="1"] .sn-card__body, .sn-card[data-slot="3"] .sn-card__body { padding-right: calc(var(--tuck) + 8px); }
    .sn-card[data-slot="2"] .sn-card__body { padding-left: calc(var(--tuck) + 8px); }
    .sn-card__label { margin-bottom: 6px; font-size: 0.8125rem; }
    .sn-card__notes { flex-direction: column; flex-wrap: nowrap; align-items: stretch; gap: 6px; width: auto; }
    .sn-note { flex: none; flex-direction: row; align-items: center; gap: 6px; }
    .sn-note__pic { flex: none; font-size: 0.875rem; box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.8), 0 6px 12px -6px rgba(30, 20, 10, 0.5); }
    .sn-note__name { flex: 1; min-width: 0; font-size: clamp(10px, 2.75vw, 11.5px); line-height: 1.25; text-align: left; overflow-wrap: normal; hyphens: auto; }   /* a long name hyphenates, never splits bare */
    /* entrance: each card slides out from behind the glass */
    .sn[data-sn-ready] .sn-card { transition: opacity 0.45s ease, transform 0.7s cubic-bezier(0.34, 1.3, 0.5, 1); }
    .sn[data-sn-ready] .sn-card[data-slot="1"], .sn[data-sn-ready] .sn-card[data-slot="3"] { transform: translateX(30%) scale(0.9); }
    .sn[data-sn-ready] .sn-card[data-slot="2"] { transform: translateX(-30%) scale(0.9); }
    .sn[data-sn-ready] .sn-card.is-on { transform: none; }
  }
  /* small phones (<380): a smaller bottle and tighter cards so every name still fits */
  @media (max-width: 379px) {
    .sn { --bh: 84vw; --gut: 6px; --pic: 22px; }
    .sn-card[data-slot="1"] { top: 0; }
    .sn-card[data-slot="3"] { top: calc(var(--bh) * 0.5 + 6px); }
    .sn-card__body { padding: 8px 6px 10px; }
    .sn-card[data-slot="1"] .sn-card__body, .sn-card[data-slot="3"] .sn-card__body { padding-right: calc(var(--tuck) + 6px); }
    .sn-card[data-slot="2"] .sn-card__body { padding-left: calc(var(--tuck) + 6px); }
    .sn-card__label { font-size: 0.75rem; }
    .sn-card__notes { gap: 5px; }
    .sn-note { gap: 5px; }
    .sn-note__name { font-size: 10px; letter-spacing: 0; overflow-wrap: anywhere; }
    .sn__pile { top: calc(var(--bh) * 0.97); }
  }
  @keyframes sn-bob { to { transform: translateY(-6px); } }
  @keyframes sn-cue { 50% { transform: translateY(4px); } }

  @media (prefers-reduced-motion: reduce) {
    .sn .sn-card, .sn .sn__bottle, .sn .sn__pile, .sn .sn-note__pic { opacity: 1 !important; filter: none !important; transform: none !important; transition: none !important; }
    .sn .sn__bottle { translate: -50% 0 !important; }
    .sn .sn-card__body, .sn__cue svg { animation: none !important; }
  }
</style>

{%- if any_notes -%}
<section
  class="sn"
  id="sn-{{ section.id }}"
  style="--sn-bg: {{ s.background }}; {{ palette }}"
  data-sn
  aria-labelledby="sn-{{ section.id }}-title"
>
  <div class="sn__inner">
    <header class="sn__head">
      {%- if s.brand != blank -%}<p class="sn__eyebrow">{{ s.brand }}</p>{%- endif -%}
      <h2 class="sn__title" id="sn-{{ section.id }}-title">{{ s.heading }}</h2>
      {%- if scent_line != blank -%}<p class="sn__lede">{{ scent_line }}</p>{%- endif -%}
      {%- if s.scroll_cue != blank -%}
        <p class="sn__cue" aria-hidden="true">{{ s.scroll_cue }}<svg viewBox="0 0 16 16" fill="none"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></p>
      {%- endif -%}
    </header>

    <div class="sn__stage">
      <div class="sn__bottle">
        {%- if s.bottle != blank -%}
          {{ s.bottle | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 1024px) 18vw, (min-width: 768px) 26vw, 40vw', loading: 'lazy', alt: bottle_alt, class: 'sn__img' }}
        {%- elsif has_cutout -%}
          <img class="sn__img" src="{{ cut | asset_url }}" width="289" height="760" loading="lazy" decoding="async" alt="{{ bottle_alt | escape }}">
        {%- elsif product.featured_image -%}
          {{ product.featured_image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 1024px) 18vw, (min-width: 768px) 26vw, 40vw', loading: 'lazy', alt: bottle_alt, class: 'sn__img' }}
        {%- endif -%}
        <span class="sn__shadow" aria-hidden="true"></span>
      </div>
      {%- if s.show_still_life -%}
        {%- comment -%} Per product (assets/sn-pile-<key>-right.webp), else the poster's set; centred under the bottle at every width {%- endcomment -%}
        {%- assign pile_keys = 'oud-fury,agha-blue,dark-paradise,maha,sea-smoke,tobacco-enigma' | split: ',' -%}
        {%- assign pile_right = 'sn-pile-oud.webp' -%}
        {%- if pile_keys contains cut_key -%}
          {%- assign pile_right = 'sn-pile-' | append: cut_key | append: '-right.webp' -%}
        {%- endif -%}
        <img class="sn__pile" src="{{ pile_right | asset_url }}" width="556" height="354" loading="lazy" decoding="async" alt="">
      {%- endif -%}

      <ul class="sn__cards" role="list">
        {%- assign slot = 0 -%}
        {%- for block in section.blocks limit: 3 -%}
          {%- liquid
            assign b = block.settings
            assign list = b.caption
            assign lvl = b.notes_source
            case b.notes_source
              when 'top'
                assign list = pdp.top_notes
              when 'heart'
                assign list = pdp.heart_notes
              when 'base'
                assign list = pdp.base_notes
              else
                assign lvl = 'top,heart,base' | split: ',' | slice: forloop.index0 | first
            endcase
            if list == blank
              continue
            endif
            assign names = list | split: ','
            assign n = names.size
            if n > max_notes
              assign n = max_notes
            endif
          -%}
          <li class="sn-card" data-slot="{{ forloop.index }}" data-level="{{ lvl }}" data-n="{{ n }}" {{ block.shopify_attributes }}>
            <div class="sn-card__body">
              <h3 class="sn-card__label">{{ b.label }}</h3>
              <ul class="sn-card__notes" role="list">
                {%- for nm in names limit: max_notes -%}
                  {%- assign note_name = nm | strip -%}
                  {%- if note_name != blank -%}
                    <li class="sn-note">
                      <span class="sn-note__pic"><span aria-hidden="true">{{ note_name | slice: 0 }}</span><img src="{% render 'agha-note-image', name: note_name, set: 'sn' %}" alt="{{ note_name | escape }}" width="120" height="120" loading="lazy" decoding="async" onerror="this.remove()"></span>
                      <span class="sn-note__name" lang="en">{{ note_name }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if s.show_buy and product -%}
      <div class="sn-purchase" data-sn-buy hidden>
        <div class="sn-buy">
          <div>
            <p class="sn-buy__name">{{ product_title }}</p>
            <p class="sn-buy__price" data-sn-price>{{ current_variant.price | money }}</p>
          </div>
          <div class="sn-buy__sizes" role="group" aria-label="Size" data-sn-sizes></div>
        </div>
        <div class="sn-cta">
          <button type="button" class="sn-add" data-sn-add>
            <span data-sn-add-label>{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</span>
          </button>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<script>
  /* SCENT NOTES — entrance, pinned scroll story (≥1024 wide, ≥760 tall), the buy row's link to the
     product form, and the sticky button's hand-off with the page's buy dock. */
  (function () {
    var STEPS = [0.1, 0.4, 0.7]; // pinned progress at which card 1, 2, 3 arrive

    function initBuy(root) {
      var box = root.querySelector('[data-sn-buy]');
      var form = document.querySelector('[data-pdp-form]');
      if (!box || !form) return;
      var mainAdd = form.querySelector('[data-pdp-add]');
      if (!mainAdd) return;
      var add = box.querySelector('[data-sn-add]');
      var label = box.querySelector('[data-sn-add-label]');
      var price = box.querySelector('[data-sn-price]');
      var sizes = box.querySelector('[data-sn-sizes]');
      var mainPrice = document.querySelector('[data-pdp-main] [data-pdp-price]');
      var mainLabel = mainAdd.querySelector('[data-pdp-add-label]');
      var fs = form.querySelector('.pdp-options');
      var radios = fs ? [].slice.call(fs.querySelectorAll('input[type="radio"]')) : [];
      var chips = radios.map(function (r) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'sn-size';
        b.textContent = r.value;
        b.addEventListener('click', function () { if (!r.checked) r.click(); sync(); });
        sizes.appendChild(b);
        return b;
      });
      function sync() {
        radios.forEach(function (r, i) {
          chips[i].setAttribute('aria-pressed', r.checked ? 'true' : 'false');
          chips[i].disabled = !r.checked && !!r.closest('.is-unavailable');
        });
        if (mainPrice) price.textContent = mainPrice.textContent;
        add.disabled = mainAdd.disabled;
        if (mainLabel) label.textContent = mainLabel.textContent.trim();
      }
      add.addEventListener('click', function () { if (!mainAdd.disabled) mainAdd.click(); });
      form.addEventListener('change', function () { setTimeout(sync, 0); });
      if ('MutationObserver' in window) {
        var mo = new MutationObserver(sync);
        mo.observe(mainAdd, { attributes: true, childList: true, subtree: true, characterData: true });
        if (mainPrice) mo.observe(mainPrice, { childList: true, subtree: true, characterData: true });
      }
      box.hidden = false;
      sync();
    }

    function init(root) {
      if (root._sn) return;
      root._sn = true;
      initBuy(root);
      var html = document.documentElement;
      var cards = [].slice.call(root.querySelectorAll('.sn-card'));
      var inner = root.querySelector('.sn__inner');
      var cta = root.querySelector('.sn-cta');
      var desk = window.matchMedia('(min-width: 1024px) and (min-height: 500px)');
      var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!still) root.setAttribute('data-sn-ready', '');
      var queued = false;

      function update() {
        queued = false;
        var vh = window.innerHeight;
        var r = root.getBoundingClientRect();
        // this section has its own buy row (sticky on phones): the page's buy dock steps aside meanwhile
        html.classList.toggle('sn-cta-on', !!cta && !root.querySelector('[data-sn-buy][hidden]') && r.top < vh && r.bottom > 0);
        if (still) return;
        var pin = desk.matches && vh >= 760;
        root.classList.toggle('sn--pin', pin);
        root.classList.toggle('is-in', r.top < vh * 0.75 && r.bottom > 0);
        if (pin) {
          var top = parseFloat(getComputedStyle(inner).top) || 0;
          var range = root.offsetHeight - inner.offsetHeight;
          var p = range > 0 ? (top - r.top) / range : 1;
          cards.forEach(function (c, i) { c.classList.toggle('is-on', p >= STEPS[Math.min(i, STEPS.length - 1)]); });
          root.classList.toggle('is-done', p >= STEPS[STEPS.length - 1]);
        } else {
          cards.forEach(function (c) { c.classList.toggle('is-on', c.getBoundingClientRect().top < vh * 0.88); });
        }
      }
      function queue() { if (!queued) { queued = true; requestAnimationFrame(update); } }
      window.addEventListener('scroll', queue, { passive: true });
      window.addEventListener('resize', queue);
      update();
    }
    function boot(scope) { [].forEach.call(scope.querySelectorAll('[data-sn]'), init); }
    if (window.HOA_SN) { window.HOA_SN.boot(document); return; }
    window.HOA_SN = { boot: boot };
    document.addEventListener('shopify:section:load', function (e) { boot(e.target); });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { boot(document); });
    else boot(document);
  })();
</script>

{% schema %}
{
  "name": "Scent notes",
  "tag": "div",
  "class": "sn-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "brand", "label": "Eyebrow", "default": "House of Agha" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Scent notes" },
    { "type": "text", "id": "subheading", "label": "Scent line fallback", "default": "How it opens, settles and lingers on skin.", "info": "Shown only when the product has no scent tags (custom.scent_tags) or character (custom.scent_character)." },
    { "type": "text", "id": "scroll_cue", "label": "Scroll cue (pinned desktop only)", "default": "Scroll to reveal the notes" },
    { "type": "range", "id": "max_notes", "label": "Notes per card", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_buy", "label": "Show name, price, size and Add to bag", "default": true },
    { "type": "color", "id": "background", "label": "Background colour", "default": "#f6f4ee" },
    { "type": "checkbox", "id": "show_still_life", "label": "Show ingredients beside the bottle (desktop)", "default": true },
    { "type": "image_picker", "id": "bottle", "label": "Bottle image", "info": "A transparent PNG works best. Empty: the theme's bottle cutout for this product, then the product's featured image." },
    { "type": "paragraph", "content": "Card positions on desktop: 1st = upper left, 2nd = right, 3rd = lower left. Card colours become --note-top / --note-heart / --note-base." }
  ],
  "blocks": [
    {
      "type": "note_card",
      "name": "Note card",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Top notes" },
        {
          "type": "select",
          "id": "notes_source",
          "label": "Notes from",
          "default": "top",
          "options": [
            { "value": "top", "label": "custom.top_notes" },
            { "value": "heart", "label": "custom.heart_notes" },
            { "value": "base", "label": "custom.base_notes" },
            { "value": "none", "label": "Only the list below" }
          ]
        },
        { "type": "text", "id": "caption", "label": "Notes (only when \"Notes from\" is the list below)", "default": "Saffron, Bergamot, Lavender", "info": "Comma separated, up to 4." },
        { "type": "color", "id": "card_color", "label": "Card colour", "default": "#ffffff" },
        { "type": "color", "id": "text_color", "label": "Text colour", "default": "#2b2620", "info": "Keep 4.5:1 contrast with the card colour." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scent notes",
      "blocks": [
        { "type": "note_card", "settings": { "label": "Top notes", "notes_source": "top", "caption": "Saffron, Bergamot, Lavender", "card_color": "#ffffff", "text_color": "#2b2620" } },
        { "type": "note_card", "settings": { "label": "Heart notes", "notes_source": "heart", "caption": "Oud, Jasmine, Neroli", "card_color": "#b9c7a5", "text_color": "#2c3a24" } },
        { "type": "note_card", "settings": { "label": "Base notes", "notes_source": "base", "caption": "Cardamom, Sandalwood, Amber", "card_color": "#ead08a", "text_color": "#3d2f17" } }
      ]
    }
  ]
}
{% endschema %}
