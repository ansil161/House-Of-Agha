{% comment %}
  AGHA PDP — 01 PRODUCT HERO
  Gallery + purchase column + sticky dock + lightbox. All product data is live Shopify data;
  optional copy comes from metafields:
    custom.family, custom.scent_tags (list of text), custom.short_description,
    custom.top_notes / custom.heart_notes / custom.base_notes
  Ratings come from the standard reviews.rating / reviews.rating_count metafields.
  Every value goes through snippets/agha-pdp-data.liquid: REAL Shopify data first, then (only while
  the theme setting "Use mock PDP data" is on) demo data from snippets/agha-pdp-mock-data.liquid.
  Variants, prices, SKUs, stock and images are always real.
{% endcomment %}

{{ 'pdp.css' | asset_url | stylesheet_tag }}
<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('pdp-js');
</script>
<script src="{{ 'pdp.js' | asset_url }}" defer></script>
<script src="{{ 'pdp-buybox.js' | asset_url }}" defer></script>
<script src="{{ 'pdp-console.js' | asset_url }}" defer></script>

{%- capture pdp_json -%}{%- render 'agha-pdp-data' -%}{%- endcapture -%}
{%- assign pdp = pdp_json | parse_json -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign family = pdp.family
  assign scent_tags = pdp.scent_tags
  assign lede = pdp.short_description
  if lede == blank
    assign lede = pdp.description_html | strip_html | truncatewords: 38
  endif
  assign rating_val = pdp.reviews.rating
  assign rating_scale = pdp.reviews.scale_max
  assign rating_count = pdp.reviews.count | default: 0
  assign top_notes = pdp.top_notes
  assign heart_notes = pdp.heart_notes
  assign base_notes = pdp.base_notes

  comment
    SKU: the variant's real SKU; only when it is empty (and mock mode is on) a demo SKU is shown.
    Offer: a real compare-at price wins; only without one does mock mode show a demo discount.
    Real prices are never changed - the demo compare-at price is derived for display only.
  endcomment
  assign display_sku = current_variant.sku
  assign any_sku = false
  for v in product.variants
    if v.sku != blank
      assign any_sku = true
    endif
  endfor
  if pdp.sku_prefix != blank
    assign any_sku = true
  endif
  if display_sku == blank and pdp.sku_prefix != blank
    assign display_sku = pdp.sku_prefix | append: '-' | append: current_variant.position
  endif
  assign compare_price = current_variant.compare_at_price
  assign save_pct = 0
  if compare_price > current_variant.price
    assign save_pct = compare_price | minus: current_variant.price | times: 100.0 | divided_by: compare_price | round
  elsif pdp.discount_percent > 0 and pdp.discount_percent < 90
    assign save_pct = pdp.discount_percent
    assign price_share = 100 | minus: save_pct
    assign compare_price = current_variant.price | times: 100 | divided_by: price_share
  endif
  assign on_sale = false
  if compare_price > current_variant.price
    assign on_sale = true
  endif
  assign sale_message = section.settings.sale_message | default: pdp.sale_message
  assign single_option = false
  if product.options.size == 1 and product.has_only_default_variant == false
    assign single_option = true
  endif
  assign media_count = product.media.size
  assign first_media = product.featured_media
-%}

<section class="pdp pdp-hero" id="pdp-{{ section.id }}" data-pdp-main data-section-id="{{ section.id }}" data-mock-sku-prefix="{{ pdp.sku_prefix }}" data-mock-discount="{{ pdp.discount_percent }}" data-money-format="{{ shop.money_format | strip_html | escape }}" data-product-url="{{ product.url }}" data-product-title="{{ product.title | escape }}" data-product-handle="{{ product.handle }}">
  <div class="container">
    <nav class="pdp-breadcrumb" aria-label="Breadcrumb" data-pdp-hero-item>
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">Fragrances</a>
      {%- endif -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="pdp-hero__grid">
      {%- comment -%}
        Product visual story. Every product image is a chapter in one vertical sequence: pdp.js pins the
        frame and reveals the next image over the last as the page scrolls (tablet / desktop), or eases
        them in one after another on phones. Any number of images works; nothing is hard-coded.
        Without JS or with reduced motion it is simply a column of large images.
      {%- endcomment -%}
      {%- assign story_n = media_count | at_least: 1 -%}
      <div class="pdp-media pdp-story{% if story_n < 2 %} pdp-story--single{% endif %}" data-pdp-story data-pdp-thumbs style="--pdp-n: {{ story_n }}">
        <div class="pdp-stage" data-pdp-stage>
          <div class="pdp-stage__inner" data-pdp-stage-inner>
            <div class="pdp-stage__track" data-pdp-track>
              {%- for media in product.media -%}
                <figure class="pdp-slide{% if forloop.first %} is-active{% endif %}" data-pdp-slide="{{ forloop.index0 }}" data-media-type="{{ media.media_type }}">
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      {%- liquid
                        assign loading = 'lazy'
                        assign priority = 'auto'
                        if forloop.first
                          assign loading = 'eager'
                          assign priority = 'high'
                        endif
                        assign media_alt = media.alt | default: product.title
                        assign full_src = media | image_url: width: 2400
                      -%}
                      {{ media | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 769px) 55vw, 100vw', loading: loading, fetchpriority: priority, alt: media_alt, data-pdp-full: full_src }}
                    {%- when 'video' -%}
                      {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1200x' }}
                    {%- when 'external_video' -%}
                      {{ media | external_video_tag: loading: 'lazy' }}
                    {%- else -%}
                      {{ media | media_tag }}
                  {%- endcase -%}
                  {%- if forloop.first and family != blank -%}
                    <div class="pdp-slide__tags" aria-hidden="true"><span class="pdp-chip pdp-chip--dot">{{ family }}</span>{% if product.tags contains 'best-seller' or product.tags contains 'Best Seller' %}<span class="pdp-chip pdp-chip--best">Best seller</span>{% endif %}</div>
                  {%- endif -%}
                </figure>
              {%- else -%}
                <figure class="pdp-slide is-active" data-pdp-slide="0">
                  {{ 'product-1' | placeholder_svg_tag }}
                </figure>
              {%- endfor -%}
            </div>
          </div>

          {%- if family != blank -%}
            <div class="pdp-stage__badge"><span class="pdp-chip pdp-chip--dot">{{ family }}</span>{% if product.tags contains 'best-seller' or product.tags contains 'Best Seller' %}<span class="pdp-chip pdp-chip--best">Best seller</span>{% endif %}</div>
          {%- endif -%}
          {%- if first_media -%}
            <button type="button" class="pdp-expand" data-pdp-expand aria-label="View images full screen">{% render 'agha-pdp-icon', icon: 'expand' %}</button>
          {%- endif -%}
          {%- if media_count > 1 -%}
            <div class="pdp-story__progress" aria-hidden="true">
              <span><span data-pdp-count>01</span>&nbsp;/&nbsp;{% if media_count < 10 %}0{% endif %}{{ media_count }}</span>
              <span class="pdp-story__bar"><i data-pdp-bar></i></span>
            </div>
          {%- endif -%}
        </div>
        {%- if media_count > 1 -%}
          <div class="pdp-thumbs" role="group" aria-label="Product images">
            {%- for media in product.media -%}
              <button type="button" class="pdp-thumb{% if forloop.first %} is-active{% endif %}" data-pdp-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }} of {{ media_count }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                {{ media.preview_image | image_url: width: 176 | image_tag: widths: '88, 132, 176', sizes: '88px', loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- comment -%}
          "More views": fills the column under the gallery while the buy box is taller. Uses the four
          optional pictures below (lifestyle / detail shots) or, when none are set, the product's other media.
        {%- endcomment -%}
        {%- assign extra_ids = 'extra_image_1,extra_image_2,extra_image_3,extra_image_4' | split: ',' -%}
        {%- capture more_html -%}
          {%- for id in extra_ids -%}
            {%- assign extra = section.settings[id] -%}
            {%- if extra != blank -%}
              <figure class="pdp-more__tile">{{ extra | image_url: width: 700 | image_tag: widths: '350, 525, 700', sizes: '(min-width: 1024px) 24vw, 46vw', loading: 'lazy', alt: product.title }}</figure>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if more_html contains 'pdp-more__tile' -%}
          <div class="pdp-more" aria-label="More views">{{ more_html }}</div>
        {%- elsif media_count > 1 -%}
          <div class="pdp-more" aria-label="More views">
            {%- for media in product.media offset: 1 limit: 4 -%}
              <figure class="pdp-more__tile">{{ media.preview_image | image_url: width: 700 | image_tag: widths: '350, 525, 700', sizes: '(min-width: 1024px) 24vw, 46vw', loading: 'lazy', alt: product.title }}</figure>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}
        PURCHASE CONSOLE — one column that answers the buyer's questions in order:
        what is it → do people like it → what does it cost / save → why it's worth it → which offer →
        how to pay → add to bag → can it reach me → why trust it. Every figure is Shopify data
        (price, compare_at_price, variants, inventory, metafields) or the section's own settings/blocks;
        only in mock mode do values fall back to the demo catalog (snippets/hoa-catalog-data.liquid).
        assets/pdp-console.js adds the live parts (coupon copy/apply, price-with-code, EMI, pincode).
      {%- endcomment -%}
      {%- liquid
        assign s = section.settings
        assign catalog_json = ''
        capture catalog_json
          render 'hoa-catalog-data'
        endcapture
        assign catalog = catalog_json | parse_json
        assign cat_item = null
        for c in catalog.products
          if c.handle == product.handle
            assign cat_item = c
            break
          endif
        endfor

        assign wearer = product.metafields.custom.gender.value | default: product.metafields.custom.gender | downcase
        if wearer == blank and pdp.use_mock and cat_item
          assign wearer = cat_item.wearer
        endif
        case wearer
          when 'men', 'man', 'male', 'him', 'for him'
            assign wearer_label = 'For him'
          when 'women', 'woman', 'female', 'her', 'for her'
            assign wearer_label = 'For her'
          when 'unisex', 'all', 'everyone'
            assign wearer_label = 'Unisex'
          else
            assign wearer_label = ''
        endcase

        assign is_best = false
        if product.tags contains 'best-seller' or product.tags contains 'Best Seller'
          assign is_best = true
        endif
        assign save_amount = compare_price | minus: current_variant.price

        assign value_blocks = section.blocks | where: 'type', 'value'
        assign trust_blocks = section.blocks | where: 'type', 'assurance'
        assign offer_blocks = section.blocks | where: 'type', 'offer'
        assign ship_threshold = catalog.settings.freeShippingThreshold | default: 0 | times: 100
        if s.free_shipping_threshold > 0
          assign ship_threshold = s.free_shipping_threshold | times: 100
        endif
      -%}
      <div class="pdp-info pdp-console" data-pdp-console>

        {%- comment -%} Value pills: only facts this product actually carries (metafields / settings), shown above the title {%- endcomment -%}
        {%- capture value_html -%}
          {%- for block in value_blocks -%}
            {%- liquid
              assign b = block.settings
              assign v_text = ''
              case b.source
                when 'longevity'
                  assign v_text = pdp.longevity
                  if v_text != blank
                    assign v_lower = v_text | downcase
                    unless v_lower contains 'last'
                      assign v_text = 'Lasts ' | append: v_text
                    endunless
                  endif
                when 'wearer'
                  assign v_text = wearer_label
                when 'family'
                  assign v_text = family
                when 'intensity'
                  assign v_text = pdp.intensity
                else
                  assign v_text = b.text
              endcase
            -%}
            {%- if v_text != blank -%}
              <li class="pdp-value" {{ block.shopify_attributes }}>
                <span class="pdp-value__icon">{% render 'agha-pdp-icon', icon: b.icon %}</span>
                <span class="pdp-value__title pdp-sr">{{ b.title }}: </span>
                <span class="pdp-value__text">{{ v_text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- liquid
          comment
            First-order banner: the same offer as the lead ticket below (first Offer block, else the
            catalog's welcome coupon), said once more where the eye lands first.
          endcomment
          assign banner_text = ''
          assign banner_code = ''
          if offer_blocks.size > 0
            assign banner_text = offer_blocks.first.settings.title
            assign banner_code = offer_blocks.first.settings.code
          elsif catalog.coupons.first
            assign banner_text = catalog.coupons.first.description
            assign banner_code = catalog.coupons.first.code
          endif
          assign family_line = family
          if section.settings.eyebrow != blank
            unless value_html contains section.settings.eyebrow
              if family_line != blank
                assign family_line = section.settings.eyebrow | append: ' | ' | append: family_line
              else
                assign family_line = section.settings.eyebrow
              endif
            endunless
          endif
        -%}
        {%- if banner_text != blank -%}
          <a class="pdp-banner-offer" href="#pdp-deals-{{ section.id }}" data-pdp-hero-item>
            {%- render 'agha-pdp-icon', icon: 'gift' -%}
            <span><b>{{ banner_text }}</b>{% if banner_code != blank %}<span class="pdp-banner-offer__code">Code {{ banner_code }}</span>{% endif %}</span>
          </a>
        {%- endif -%}

        {%- comment -%}
          LEVEL 1 — name, proof, price, saving. Fact pills above the name, the family in gold under it.
        {%- endcomment -%}
        <div class="pdp-console__id" data-pdp-hero-item>
          {%- if value_html contains 'pdp-value' -%}
            <ul class="pdp-values" role="list">{{ value_html }}</ul>
          {%- endif -%}
          <h1 class="pdp-title">{{ product.title }}</h1>
          {%- if family_line != blank -%}<p class="pdp-console__family">{{ family_line }}</p>{%- endif -%}
          {%- if lede != blank -%}<p class="pdp-lede">{{ lede }}</p>{%- endif -%}
          {%- if pdp.brand != blank or any_sku -%}
            <p class="pdp-identity">
              {%- if pdp.brand != blank -%}<span>{{ pdp.brand }}</span>{%- endif -%}
              <span data-pdp-sku-wrap{% if display_sku == blank %} hidden{% endif %}>SKU <span data-pdp-sku>{{ display_sku }}</span></span>
            </p>
          {%- endif -%}
        </div>

        {%- comment -%} 2 · Social proof {%- endcomment -%}
        {%- if rating_val > 0 -%}
          <div class="pdp-rating" data-pdp-hero-item{% if pdp.reviews.mock %} data-pdp-mock="reviews"{% endif %}>
            {%- if rating_val > 0 -%}
              {%- assign rating_pct = rating_val | divided_by: rating_scale | times: 100 -%}
              <a class="pdp-rating__link" href="#pdp-reviews">
                <span class="pdp-stars" role="img" aria-label="Rated {{ rating_val | round: 1 }} out of {{ rating_scale }}"><span class="pdp-stars__fill" style="width: {{ rating_pct }}%"></span></span>
                <strong>{{ rating_val | round: 1 }}</strong>
                <span class="pdp-rating__count">{{ rating_count }} {{ rating_count | pluralize: 'review', 'reviews' }}{% if pdp.reviews.mock %} (demo){% endif %}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          Price: the selling price is the largest figure in the column; the MRP sits beside it, small and
          struck; the saving is a solid pill on its own line so it reads as a gain, not a footnote.
        {%- endcomment -%}
        <div class="pdp-price" data-pdp-hero-item>
          <span class="pdp-price__amount" data-pdp-price>{{ current_variant.price | money }}</span>
          <s class="pdp-price__compare" data-pdp-compare{% unless on_sale %} hidden{% endunless %}><span class="pdp-sr">MRP </span>{{ compare_price | money }}</s>
          <span class="pdp-price__note">
            <span class="pdp-savings" data-pdp-savings{% unless on_sale %} hidden{% endunless %}>{% if on_sale %}You save {{ save_amount | money }}{% endif %}</span>
            <span class="pdp-price__save" data-pdp-save{% unless on_sale %} hidden{% endunless %}>{% if on_sale %}{{ save_pct }}% off{% endif %}</span>
            {%- if cart.taxes_included or pdp.use_mock %}<span class="pdp-price__tax">Inclusive of all taxes</span>{% endif -%}
          </span>
          {%- if sale_message != blank -%}
            <span class="pdp-price__offer" data-pdp-offer{% unless on_sale %} hidden{% endunless %}>{{ sale_message }}</span>
          {%- endif -%}
        </div>

        {%- comment -%}
          5 · Exclusive offers. Shopify cannot list discount codes in Liquid, so the offers come from this
          section's "Offer" blocks. Without any, the catalog's first coupon is shown — the same code the
          welcome popup reveals and the bag validates — plus its free-shipping threshold. Nothing here changes the real price:
          a code is applied at checkout (Shopify's /discount/CODE) and the bag.
        {%- endcomment -%}
        {%- capture offers_html -%}
          {%- if offer_blocks.size > 0 -%}
            {%- for block in offer_blocks -%}
              {%- liquid
                assign b = block.settings
                assign o_price = ''
                if b.percent > 0 and b.percent < 100
                  assign rest = 100 | minus: b.percent
                  assign o_price = current_variant.price | times: rest | divided_by: 100 | money
                endif
              -%}
              <li class="pdp-deal{% if forloop.first %} pdp-deal--lead{% endif %}{% if b.code == blank %} pdp-deal--auto{% endif %}" data-pdp-deal data-percent="{{ b.percent }}" {{ block.shopify_attributes }}>
                <span class="pdp-deal__icon">{% render 'agha-pdp-icon', icon: b.icon %}</span>
                <span class="pdp-deal__body">
                  <span class="pdp-deal__label">{{ b.label }}</span>
                  <span class="pdp-deal__title">{% if o_price != blank %}Get it for <b data-pdp-deal-price>{{ o_price }}</b>{% else %}{{ b.title }}{% endif %}</span>
                  {%- if b.text != blank -%}<span class="pdp-deal__text">{{ b.text }}</span>{%- endif -%}
                </span>
                {%- if b.code != blank -%}
                  <button type="button" class="pdp-deal__code" data-pdp-code="{{ b.code | escape }}" aria-label="Copy and apply code {{ b.code | escape }}">
                    <span class="pdp-deal__code-text">{{ b.code }}</span><span class="pdp-deal__code-act" data-pdp-code-act>Copy</span>
                  </button>
                {%- else -%}
                  <span class="pdp-deal__auto">Auto-applied</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Same code as the welcome popup (snippets/hoa-coupon-popup.liquid) and the bag {%- endcomment -%}
            {%- assign cp = catalog.coupons.first -%}
            {%- if cp -%}
              {%- liquid
                assign o_price = ''
                if cp.type == 'percent'
                  assign rest = 100 | minus: cp.value
                  assign o_price = current_variant.price | times: rest | divided_by: 100 | money
                endif
              -%}
              <li class="pdp-deal pdp-deal--lead" data-pdp-deal data-percent="{% if cp.type == 'percent' %}{{ cp.value }}{% endif %}">
                <span class="pdp-deal__icon">{% render 'agha-pdp-icon', icon: 'gift' %}</span>
                <span class="pdp-deal__body">
                  <span class="pdp-deal__label">{{ cp.label }}</span>
                  <span class="pdp-deal__title">{% if o_price != blank %}Get it for <b data-pdp-deal-price>{{ o_price }}</b>{% else %}{{ cp.description }}{% endif %}</span>
                  <span class="pdp-deal__text">{{ cp.description | capitalize }}</span>
                </span>
                <button type="button" class="pdp-deal__code" data-pdp-code="{{ cp.code | escape }}" aria-label="Copy and apply code {{ cp.code | escape }}">
                  <span class="pdp-deal__code-text">{{ cp.code }}</span><span class="pdp-deal__code-act" data-pdp-code-act>Copy</span>
                </button>
              </li>
            {%- endif -%}
          {%- endif -%}
          {%- if ship_threshold > 0 -%}
            <li class="pdp-deal pdp-deal--auto" data-pdp-ship data-threshold="{{ ship_threshold }}">
              <span class="pdp-deal__icon">{% render 'agha-pdp-icon', icon: 'delivery' %}</span>
              <span class="pdp-deal__body">
                <span class="pdp-deal__label">Complimentary shipping</span>
                <span class="pdp-deal__title" data-pdp-ship-text>{% if current_variant.price >= ship_threshold %}This order ships free{% else %}Free on orders above {{ ship_threshold | money_without_trailing_zeros }}{% endif %}</span>
              </span>
              <span class="pdp-deal__auto">Auto-applied</span>
            </li>
          {%- endif -%}
        {%- endcapture -%}
        {%- if offers_html contains 'pdp-deal' -%}
          <section class="pdp-deals" aria-labelledby="pdp-deals-{{ section.id }}" data-pdp-hero-item>
            <h2 class="pdp-deals__head" id="pdp-deals-{{ section.id }}">{% render 'agha-pdp-icon', icon: 'sparkle' %}<span>{{ s.offers_heading | default: 'Exclusive offers' }}</span></h2>
            <ul class="pdp-deals__list" role="list">{{ offers_html }}</ul>
            <p class="pdp-sr" data-pdp-code-live role="status" aria-live="polite"></p>
          </section>
        {%- endif -%}

        {%- form 'product', product, class: 'pdp-form', data-pdp-form: '', data-pdp-hero-item: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-pdp-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_index = forloop.index0 -%}
              <fieldset class="pdp-options" data-pdp-option="{{ option_index }}"{% if option.values.size == 1 %} hidden{% endif %}>
                <legend class="pdp-options__legend"><span>{{ option.name }}:</span><span data-pdp-option-value>{{ option.selected_value }}</span></legend>
                <div class="pdp-options__grid">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign tile_variant = null
                      for v in product.variants
                        if v.options[option_index] == value
                          assign tile_variant = v
                          break
                        endif
                      endfor
                    -%}
                    <label class="pdp-tile{% if single_option and tile_variant.available == false %} is-unavailable{% endif %}">
                      <input type="radio" name="{{ section.id }}-option-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                      <span class="pdp-tile__value">{{ value }}</span>
                      {%- if single_option and tile_variant -%}
                        <span class="pdp-tile__price">{% if tile_variant.available %}{{ tile_variant.price | money }}{% else %}Sold out{% endif %}</span>
                      {%- endif -%}
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          {%- if product.selling_plan_groups.size > 0 -%}
            <fieldset class="pdp-options">
              <legend class="pdp-options__legend"><span>Purchase option</span></legend>
              <div class="pdp-plans">
                {%- unless product.requires_selling_plan -%}
                  <label class="pdp-tile">
                    <input type="radio" name="selling_plan" value="" checked>
                    <span class="pdp-tile__value">One-time purchase</span>
                  </label>
                {%- endunless -%}
                {%- for group in product.selling_plan_groups -%}
                  {%- for plan in group.selling_plans -%}
                    <label class="pdp-tile">
                      <input type="radio" name="selling_plan" value="{{ plan.id }}"{% if product.requires_selling_plan and forloop.parentloop.first and forloop.first %} checked{% endif %}>
                      <span class="pdp-tile__value">{{ plan.name }}</span>
                    </label>
                  {%- endfor -%}
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          {%- comment -%} Buy more, save more: painted by assets/pdp-buybox.js from the quantity tiers. Stacked
            choice rows right above the purchase, so the saving is picked before the button is pressed {%- endcomment -%}
          {%- comment -%} Option images: the product's own photo (1 / 2 / 3 bottles), or a photo picked per option in the section settings {%- endcomment -%}
          <fieldset class="pdp-offers" data-pdp-offers data-unit="{{ s.offer_unit | default: 'bottle' }}"
            {%- if product.featured_image %} data-image="{{ product.featured_image | image_url: width: 240 }}"{% endif -%}
            {%- if s.offer_image_1 != blank %} data-image-1="{{ s.offer_image_1 | image_url: width: 240 }}"{% endif -%}
            {%- if s.offer_image_2 != blank %} data-image-2="{{ s.offer_image_2 | image_url: width: 240 }}"{% endif -%}
            {%- if s.offer_image_3 != blank %} data-image-3="{{ s.offer_image_3 | image_url: width: 240 }}"{% endif %} hidden>
            <legend class="pdp-offers__legend"><span>{{ s.offer_heading | default: 'Buy more, save more' }}</span></legend>
            <div class="pdp-offers__list" data-pdp-offers-list></div>
          </fieldset>


          {%- comment -%} 8 · Purchase {%- endcomment -%}
          <div class="pdp-buy">
            <div class="pdp-qty" data-pdp-qty>
              <button type="button" data-pdp-qty-step="-1" aria-label="Decrease quantity" disabled>−</button>
              <input type="number" name="quantity" value="1" min="1" max="10" inputmode="numeric" aria-label="Quantity">
              <button type="button" data-pdp-qty-step="1" aria-label="Increase quantity">+</button>
            </div>
            <button type="submit" name="add" class="pdp-btn pdp-add" data-pdp-add{% unless current_variant.available %} disabled{% endunless %}>
              <span class="pdp-add__label" data-pdp-add-label>{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</span>
              <span class="pdp-add__sep" aria-hidden="true">—</span>
              <span class="pdp-add__price" data-pdp-add-price>{{ current_variant.price | money }}</span>
              <span class="pdp-add__progress" aria-hidden="true"></span>
            </button>
            {%- if section.settings.show_wishlist -%}
              <button type="button" class="pdp-icon-btn" data-pdp-wishlist data-wishlist-toggle data-wishlist-handle="{{ product.handle }}" data-wishlist-variant="{{ current_variant.id }}" data-wishlist-title="{{ product.title | escape }}" aria-pressed="false" aria-label="Save to wishlist">{% render 'agha-pdp-icon', icon: 'heart' %}</button>
            {%- endif -%}
          </div>

          {%- if section.settings.show_dynamic_checkout -%}
            <div class="pdp-dynamic-checkout">{{ form | payment_button }}</div>
          {%- endif -%}

          {%- comment -%} 9 · Payment badges: the store's own enabled payment methods (Shopify's icons), right under the buttons {%- endcomment -%}
          {%- if s.show_secure -%}
            <div class="pdp-paybadges">
              <span class="pdp-paybadges__label">{% render 'agha-pdp-icon', icon: 'secure' %}{{ s.secure_title }}</span>
              {%- if shop.enabled_payment_types.size > 0 -%}
                <ul class="pdp-paybadges__list" role="list" aria-label="Accepted payment methods">
                  {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
                </ul>
              {%- elsif s.secure_text != blank -%}
                <span class="pdp-paybadges__text">{{ s.secure_text }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- liquid
            assign stock_state = 'in'
            if current_variant.available == false
              assign stock_state = 'sold-out'
            elsif current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.low_stock_threshold
              assign stock_state = 'low'
            endif
          -%}
          <p class="pdp-stock" data-pdp-stock data-state="{{ stock_state }}" role="status">
            {%- case stock_state -%}
              {%- when 'sold-out' -%}Currently unavailable
              {%- when 'low' -%}Only {{ current_variant.inventory_quantity }} left
              {%- else -%}{{ section.settings.in_stock_text }}
            {%- endcase -%}
          </p>
          <p class="pdp-sr" data-pdp-live role="status" aria-live="polite"></p>
        {%- endform -%}

        {%- comment -%}
          9 · Delivery check. The estimate comes from the dispatch / delivery settings (pdp.js). The pincode is
          checked for a valid Indian format; with a serviceability URL set, pdp-console.js asks it as well.
        {%- endcomment -%}
        {%- if s.show_delivery -%}
          <div class="pdp-deliver" data-pdp-delivery data-pdp-pincode data-min-days="{{ s.delivery_min_days }}" data-max-days="{{ s.delivery_max_days }}" data-dispatch-days="{{ s.dispatch_days }}" data-cutoff-hour="{{ s.cutoff_hour }}" data-serviceability-url="{{ s.pincode_url | escape }}" data-pdp-hero-item>
            <form class="pdp-deliver__form" data-pdp-pincode-form novalidate>
              <label class="pdp-deliver__label" for="pdp-pin-{{ section.id }}">{% render 'agha-pdp-icon', icon: 'pin' %}Check delivery</label>
              <span class="pdp-deliver__field">
                <input id="pdp-pin-{{ section.id }}" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="6" placeholder="Enter pincode" data-pdp-pincode-input aria-describedby="pdp-pin-msg-{{ section.id }}">
                <button type="submit" class="pdp-deliver__btn">Check</button>
              </span>
            </form>
            <p class="pdp-deliver__msg" id="pdp-pin-msg-{{ section.id }}" data-pdp-pincode-msg role="status" aria-live="polite">
              {% render 'agha-pdp-icon', icon: 'delivery' %}<span data-pdp-delivery-summary>Estimated delivery <strong data-pdp-delivery-range></strong></span>
            </p>
          </div>
        {%- endif -%}

        {%- comment -%} 10 · Trust: the section's assurance blocks, authenticity and secure checkout on one quiet grid {%- endcomment -%}
        {%- assign trust_title = s.authenticity_title | default: pdp.authenticity_title -%}
        {%- assign trust_text = s.authenticity_text | default: pdp.authenticity_text -%}
        {%- if trust_blocks.size > 0 or trust_title != blank or s.show_secure -%}
          <div class="pdp-trust" data-pdp-hero-item>
            <ul class="pdp-trust__list" role="list">
              {%- for block in trust_blocks -%}
                <li class="pdp-trust__item" {{ block.shopify_attributes }}>
                  <span class="pdp-trust__icon">{% render 'agha-pdp-icon', icon: block.settings.icon %}</span>
                  <span><b>{{ block.settings.title }}</b>{%- if block.settings.text != blank -%}<small>{{ block.settings.text }}</small>{%- endif -%}</span>
                </li>
              {%- endfor -%}
              {%- if trust_title != blank and trust_text != blank -%}
                <li class="pdp-trust__item">
                  <span class="pdp-trust__icon">{% render 'agha-pdp-icon', icon: 'seal' %}</span>
                  <span><b>{{ trust_title }}</b><small>{{ trust_text }}</small></span>
                </li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="pdp-accordion" data-pdp-hero-item>
          {%- comment -%}
            Description, with the house's "Why we are better" proofs (blocks type `proof`) in one row under the text.
          {%- endcomment -%}
          {%- assign proof_blocks = section.blocks | where: 'type', 'proof' -%}
          {%- if pdp.description_html != blank or proof_blocks.size > 0 -%}
            <details data-pdp-accordion open>
              <summary>Description<span class="pdp-accordion__icon" aria-hidden="true"></span></summary>
              <div class="pdp-accordion__body">
                {{ pdp.description_html }}
                {%- if proof_blocks.size > 0 -%}
                  <ul class="pdp-proofs" role="list" aria-label="Why we are better">
                    {%- for block in proof_blocks -%}
                      <li class="pdp-proof" {{ block.shopify_attributes }}>
                        <span class="pdp-proof__icon">{% render 'pdx-icon', name: block.settings.icon %}</span>
                        <b class="pdp-proof__title">{{ block.settings.title | escape | newline_to_br }}</b>
                        {%- if block.settings.text != blank -%}<small class="pdp-proof__text">{{ block.settings.text | escape | newline_to_br }}</small>{%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
          {%- if top_notes != blank or heart_notes != blank or base_notes != blank -%}
            <details data-pdp-accordion>
              <summary>Fragrance notes<span class="pdp-accordion__icon" aria-hidden="true"></span></summary>
              <div class="pdp-accordion__body">
                <ul class="pdp-notes-list">
                  {%- if top_notes != blank -%}<li><b>Top</b><span>{{ top_notes }}</span></li>{%- endif -%}
                  {%- if heart_notes != blank -%}<li><b>Heart</b><span>{{ heart_notes }}</span></li>{%- endif -%}
                  {%- if base_notes != blank -%}<li><b>Base</b><span>{{ base_notes }}</span></li>{%- endif -%}
                </ul>
              </div>
            </details>
          {%- endif -%}
          {%- liquid
            assign wear_where = pdp.spray_where
            assign wear_count = pdp.spray_count
            assign wear_distance = pdp.spray_distance
            assign wear_when = pdp.spray_when
            assign wear_general = pdp.how_to_wear_html
            assign wear_setting = section.settings.how_to_wear
            assign has_wear = false
            if wear_where != blank or wear_count != blank or wear_distance != blank or wear_when != blank or wear_general != blank or wear_setting != blank
              assign has_wear = true
            endif
          -%}
          {%- if has_wear -%}
            <details data-pdp-accordion>
              <summary>How to wear<span class="pdp-accordion__icon" aria-hidden="true"></span></summary>
              <div class="pdp-accordion__body">
                {%- if wear_where != blank or wear_count != blank or wear_distance != blank or wear_when != blank -%}
                  <ul class="pdp-notes-list">
                    {%- if wear_where != blank -%}<li><b>Where</b><span>{{ wear_where }}</span></li>{%- endif -%}
                    {%- if wear_count != blank -%}<li><b>Sprays</b><span>{{ wear_count }}</span></li>{%- endif -%}
                    {%- if wear_distance != blank -%}<li><b>Distance</b><span>{{ wear_distance }}</span></li>{%- endif -%}
                    {%- if wear_when != blank -%}<li><b>When</b><span>{{ wear_when }}</span></li>{%- endif -%}
                  </ul>
                {%- endif -%}
                {%- if wear_general != blank -%}{{ wear_general }}{%- elsif wear_setting != blank -%}{{ wear_setting }}{%- endif -%}
              </div>
            </details>
          {%- endif -%}
          {%- liquid
            assign ship_s = section.settings
            assign ship_page = pages['shipping-returns']
            assign ship_free = ship_s.free_shipping_text | default: pdp.free_shipping_text
            assign ship_charges = ship_s.shipping_charges_text | default: pdp.shipping_charges_text
            assign ship_returns = ship_s.returns_text | default: pdp.returns_text
            assign ship_refund = pdp.refund_text
            assign has_ship = false
            if ship_s.show_delivery or ship_free != blank or ship_s.shipping_text != blank or ship_charges != blank or ship_returns != blank or ship_refund != blank or shop.shipping_policy or shop.refund_policy or ship_page.title != blank
              assign has_ship = true
            endif
          -%}
          {%- if has_ship -%}
            <details data-pdp-accordion>
              <summary>Shipping &amp; returns<span class="pdp-accordion__icon" aria-hidden="true"></span></summary>
              <div class="pdp-accordion__body">
                <ul class="pdp-notes-list">
                  {%- if ship_s.show_delivery -%}
                    <li><b>Delivery</b><span>Estimated {{ ship_s.delivery_min_days }}–{{ ship_s.delivery_max_days }} business days{% if ship_s.dispatch_days > 0 %}, dispatched within {{ ship_s.dispatch_days }} business {{ ship_s.dispatch_days | pluralize: 'day', 'days' }}{% endif %}.</span></li>
                  {%- endif -%}
                  {%- if ship_free != blank -%}<li><b>Free shipping</b><span>{{ ship_free }}</span></li>{%- endif -%}
                  {%- if ship_charges != blank -%}<li><b>Charges</b><span>{{ ship_charges }}</span></li>{%- endif -%}
                  {%- if ship_returns != blank -%}<li><b>Returns</b><span>{{ ship_returns }}</span></li>{%- endif -%}
                  {%- if ship_refund != blank -%}<li><b>Refunds</b><span>{{ ship_refund }}</span></li>{%- endif -%}
                </ul>
                {%- if ship_s.shipping_text != blank -%}{{ ship_s.shipping_text }}{%- endif -%}
                {%- if shop.shipping_policy or shop.refund_policy or ship_page.title != blank -%}
                  <p>
                    {%- if shop.shipping_policy -%}<a class="pdp-link" href="{{ shop.shipping_policy.url }}">Shipping policy</a>{%- endif -%}
                    {%- if shop.shipping_policy and shop.refund_policy %} · {% endif -%}
                    {%- if shop.refund_policy -%}<a class="pdp-link" href="{{ shop.refund_policy.url }}">Refund policy</a>{%- endif -%}
                    {%- if ship_page.title != blank -%}{% if shop.shipping_policy or shop.refund_policy %} · {% endif %}<a class="pdp-link" href="{{ ship_page.url }}">{{ ship_page.title }}</a>{%- endif -%}
                  </p>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {% render 'agha-pdp-jsonld' %}
  <script type="application/json" data-pdp-variants>
    {{ product.variants | json }}
  </script>
  <script type="application/json" data-pdp-stock-levels>
    { {%- for v in product.variants -%}{%- if v.inventory_management == 'shopify' -%}"{{ v.id }}": {{ v.inventory_quantity }}{%- else -%}"{{ v.id }}": null{%- endif -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }
  </script>
  <script type="application/json" data-pdp-settings>
    { "lowStockThreshold": {{ section.settings.low_stock_threshold }}, "inStockText": {{ section.settings.in_stock_text | json }} }
  </script>

  {%- comment -%} Sticky purchase dock {%- endcomment -%}
  <div class="pdp-dock" data-pdp-dock aria-hidden="true">
    <div class="pdp-dock__inner">
      {%- if first_media -%}
        {{ first_media.preview_image | image_url: width: 120 | image_tag: class: 'pdp-dock__thumb', loading: 'lazy', alt: '' }}
      {%- endif -%}
      <div>
        <p class="pdp-dock__title">{{ product.title }}</p>
        {%- unless product.has_only_default_variant -%}<p class="pdp-dock__meta" data-pdp-variant-title>{{ current_variant.title }}</p>{%- endunless -%}
      </div>
      <span class="pdp-dock__spacer"></span>
      <span class="pdp-dock__prices">
        <span class="pdp-dock__price" data-pdp-price>{{ current_variant.price | money }}</span>
        <s class="pdp-dock__was" data-pdp-dock-was{% unless on_sale %} hidden{% endunless %}>{{ compare_price | money }}</s>
      </span>
      <button type="button" class="pdp-btn pdp-add" data-pdp-dock-add tabindex="-1"{% unless current_variant.available %} disabled{% endunless %}>
        <span class="pdp-add__label" data-pdp-add-label>{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</span>
        <span class="pdp-add__progress" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {%- comment -%} Full-screen viewer {%- endcomment -%}
  <dialog class="pdp-lightbox" data-pdp-lightbox aria-label="{{ product.title | escape }} images">
    <div class="pdp-lightbox__bar">
      <span><span data-pdp-lightbox-count>01</span> / {% if media_count < 10 %}0{% endif %}{{ media_count }}</span>
      <button type="button" data-pdp-lightbox-close>Close ✕</button>
    </div>
    <div class="pdp-lightbox__stage" data-pdp-lightbox-stage></div>
    {%- if media_count > 1 -%}
      <div class="pdp-lightbox__nav">
        <button type="button" data-pdp-lightbox-step="-1">← Previous</button>
        <button type="button" data-pdp-lightbox-step="1">Next →</button>
      </div>
    {%- endif -%}
  </dialog>
</section>

{% schema %}
{
  "name": "Agha PDP · Product",
  "class": "pdp-shopify-section",
  "blocks": [
    {
      "type": "value",
      "name": "Value (under the price)",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Show",
          "default": "custom",
          "info": "Product facts come from metafields and are hidden when a product has none — nothing is invented.",
          "options": [
            { "value": "longevity", "label": "Longevity (custom.longevity)" },
            { "value": "wearer", "label": "Wearer (custom.gender)" },
            { "value": "family", "label": "Fragrance family (custom.family)" },
            { "value": "intensity", "label": "Intensity (custom.intensity)" },
            { "value": "custom", "label": "Text below (same for every product)" }
          ]
        },
        { "type": "text", "id": "title", "label": "Label", "default": "Longevity" },
        { "type": "text", "id": "text", "label": "Text (only for \"Text below\")" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "time",
          "options": [
            { "value": "time", "label": "Clock" },
            { "value": "person", "label": "Person" },
            { "value": "drop", "label": "Drop" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "hourglass", "label": "Hourglass" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "wood", "label": "Wood" },
            { "value": "flower", "label": "Flower" },
            { "value": "seal", "label": "Seal" }
          ]
        }
      ]
    },
    {
      "type": "offer",
      "name": "Offer",
      "limit": 3,
      "settings": [
        { "type": "paragraph", "content": "Use only live Shopify discounts. The code is copied for the customer and applied to their checkout." },
        { "type": "text", "id": "label", "label": "Label", "default": "Welcome offer" },
        { "type": "text", "id": "title", "label": "Headline", "default": "10% off your first order" },
        { "type": "range", "id": "percent", "label": "Percentage off (shows \"Get it for ₹…\")", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 0, "info": "0 = show the headline instead." },
        { "type": "text", "id": "text", "label": "Small print" },
        { "type": "text", "id": "code", "label": "Discount code", "info": "Leave empty for an automatic discount (shown as \"Auto-applied\")." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "gift",
          "options": [
            { "value": "gift", "label": "Gift" },
            { "value": "tag", "label": "Tag" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "card", "label": "Card" },
            { "value": "delivery", "label": "Delivery" }
          ]
        }
      ]
    },
    {
      "type": "proof",
      "name": "Why we are better (in Description)",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "badge", "options": [
          { "value": "badge", "label": "Certified badge" },
          { "value": "bottle", "label": "Perfume bottle" },
          { "value": "hourglass", "label": "Hourglass" },
          { "value": "ifra", "label": "IFRA mark" },
          { "value": "leaf", "label": "Leaf" },
          { "value": "drop", "label": "Drop" },
          { "value": "shield", "label": "Shield" }
        ] },
        { "type": "textarea", "id": "title", "label": "Title", "info": "A new line starts a new row.", "default": "Certified perfumers" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    },
    {
      "type": "assurance",
      "name": "Assurance (trust)",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "delivery",
          "options": [
            { "value": "delivery", "label": "Delivery" },
            { "value": "sample", "label": "Sample vial" },
            { "value": "hourglass", "label": "Hourglass" },
            { "value": "time", "label": "Clock" },
            { "value": "drop", "label": "Drop" },
            { "value": "secure", "label": "Lock" },
            { "value": "return", "label": "Returns" },
            { "value": "seal", "label": "Seal" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Complimentary shipping" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow above the title", "default": "Extrait de parfum · 35%" },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist button", "info": "Signed-in customers only; guests are sent to Shopify's login page first.", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Buy now (dynamic checkout)", "default": true },
    { "type": "text", "id": "in_stock_text", "label": "In-stock message", "default": "In stock · ready to dispatch" },
    { "type": "range", "id": "low_stock_threshold", "label": "Low stock threshold", "min": 1, "max": 20, "step": 1, "default": 5 },
    { "type": "header", "content": "Offers" },
    { "type": "text", "id": "offers_heading", "label": "Offers heading", "default": "Exclusive offers" },
    { "type": "range", "id": "free_shipping_threshold", "label": "Free shipping above (₹)", "min": 0, "max": 10000, "step": 250, "default": 0, "info": "0 = use the catalog threshold. Match your Shopify shipping rates." },
    { "type": "text", "id": "offer_heading", "label": "Multi-buy heading", "default": "Buy more, save more" },
    { "type": "text", "id": "offer_unit", "label": "Multi-buy unit (singular)", "default": "bottle", "info": "Shown as \"2 bottles\" on each option. Savings come from the quantity tiers in the catalog data." },
    { "type": "image_picker", "id": "offer_image_1", "label": "Multi-buy image: Single", "info": "Optional. Without it, the option shows the product's own photo." },
    { "type": "image_picker", "id": "offer_image_2", "label": "Multi-buy image: Duo", "info": "Optional. Without it, the option shows two of the product's bottles." },
    { "type": "image_picker", "id": "offer_image_3", "label": "Multi-buy image: Trio", "info": "Optional. Without it, the option shows three of the product's bottles." },
    { "type": "text", "id": "sale_message", "label": "Sale message", "info": "Shown under the price, only while the selected variant has a compare-at price." },
    { "type": "header", "content": "Payment badges" },
    { "type": "checkbox", "id": "show_secure", "label": "Show payment badges under the buttons", "default": true, "info": "Shopify's icons for the payment methods enabled on the store (Settings > Payments)." },
    { "type": "text", "id": "secure_title", "label": "Title", "default": "Secure checkout" },
    { "type": "text", "id": "secure_text", "label": "Text (when no payment icons)", "default": "Payments are processed securely by Shopify." },
    { "type": "header", "content": "Delivery" },
    { "type": "checkbox", "id": "show_delivery", "label": "Show delivery check", "default": true },
