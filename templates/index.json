            "fragrance": "Agha Blue",
            "rating": 5,
            "show_rating": true
          }
        },
        "voice_3": {
          "type": "testimonial",
          "settings": {
            "quote": "Maha is soft without being sweet. My mother borrowed it once and never gave it back.",
