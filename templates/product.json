    "faq": {
      "type": "agha-pdp-faq",
      "blocks": {
        "sprays": {
          "type": "question",
          "settings": {
            "question": "How many sprays should I use?",
            "answer": "<p>One to two sprays is enough. At 35% concentration an extrait is considerably denser than an eau de parfum — apply to pulse points or clothing rather than layering.</p>"
          }
        },
        "size": {
          "type": "question",
          "settings": {
            "question": "Which size should I choose?",
            "answer": "<p>If you haven't worn AGHA before, the Discovery Collection holds five of our extraits in 5 × 5 ml so you can wear each one for a few days before committing to a full flacon.</p>"
          }
        },
        "box": {
          "type": "question",
          "settings": {
            "question": "What arrives in the box?",
            "answer": "<p>The numbered flacon, hand-wrapped in matte black hardboard, with a complimentary 5 ml sample.</p>"
          }
        },
        "maceration": {
          "type": "question",
          "settings": {
            "question": "Why is every batch rested for 90 days?",
            "answer": "<p>Maceration lets the raw materials bind. Resting each batch in temperature-stabilised vaults removes the sharp alcohol edge you notice in the first minutes of many perfumes.</p>"
          }
        }
      },
      "block_order": [
        "sprays",
