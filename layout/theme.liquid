<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AGHA PERFUMES — High-Fashion Luxury Fragrance House</title>
  <meta name="description" content="AGHA PERFUMES is a luxury fragrance house crafting ultra-concentrated extraits de parfum (35% concentration). Enter the world of Agha.">
  
  <!-- CSS Assets -->
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <!-- GSAP Animation Engine -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>

  <!-- House of Agha design system (header + homepage sections) -->
  {{ 'hoa-home.css' | asset_url | stylesheet_tag }}
  {{ 'hoa-coupon.css' | asset_url | stylesheet_tag }}

  <!-- JS Assets -->
  {% render 'agha-wishlist-config' %}
  <script src="{{ 'agha-wishlist.js' | asset_url }}" defer></script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'hero-scroll.js' | asset_url }}" defer></script>
  <script src="{{ 'hoa-coupon.js' | asset_url }}" defer></script>
  {%- if template.name == 'index' -%}
    <link rel="preload" as="image" href="{{ 'hoa-hero-oud-fury.webp' | asset_url }}" media="(min-width: 768px)" fetchpriority="high">
    <link rel="preload" as="image" href="{{ 'hoa-oud-fury-portrait-sm.webp' | asset_url }}" media="(max-width: 767px)" fetchpriority="high">
    <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js" defer></script>
    <script src="{{ 'hoa-home.js' | asset_url }}" defer></script>
  {%- endif -%}
  {%- if template.name == 'page' and template.suffix == 'the-house' -%}
    {{ 'hoa-about.css' | asset_url | stylesheet_tag }}
    <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js" defer></script>
    <script src="{{ 'hoa-about.js' | asset_url }}" defer></script>
  {%- endif -%}
  {%- if template.name == 'collection' -%}
    {{ 'hoa-shop.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'hoa-shop.js' | asset_url }}" defer></script>
  {%- endif -%}
  {%- if template.name == 'page' and template.suffix == 'wishlist' -%}
    {{ 'agha-wishlist.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'agha-wishlist-page.js' | asset_url }}" defer></script>
  {%- endif -%}
  {%- if template.directory == 'customers' -%}
    {{ 'hoa-account.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'hoa-account.js' | asset_url }}" defer></script>
  {%- endif -%}
</head>
<body{% if template.name == 'index' %} class="hoa-home"{% elsif template.suffix == 'the-house' %} class="hoa-page hoa-about"{% elsif template.suffix == 'wishlist' %} class="hoa-wishlist-page"{% elsif template.name == 'collection' %} class="hoa-shop-page"{% elsif template.directory == 'customers' %} class="hoa-account-page"{% endif %}>

  <!-- Navigation Header -->
  {% render 'header' %}

  <!-- Main Content Layout -->
  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  {% render 'footer' %}

  <!-- Modals & Drawers -->
  {% render 'cart-drawer' %}
  {% render 'quick-view-modal' %}
  {% render 'hoa-coupon-popup' %}

</body>
</html>
